+ARM_NATIVE_LIMIT_EXEC = ARM_NATIVE_LIMIT_SETUP + 'exec -- "$@"\n'
+ARM_NATIVE_LIMIT_PROBE = ARM_NATIVE_LIMIT_SETUP + '''while IFS= read -r line; do
