+ulimit -S -c 0 || exit 125
+ulimit -H -c 0 || exit 125
+soft=$(ulimit -S -v) || exit 125
+hard=$(ulimit -H -v) || exit 125
+[ "$soft" = "$limit" ] && [ "$hard" = "$limit" ] || exit 125
