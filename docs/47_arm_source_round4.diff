+class ARMNativeLimitCommands:
+    """ARM-only composition: keep Commands accounting/cancellation unchanged."""
+    def __init__(self, command, bash, tools):
+        if command.address_space_bytes < 1 or command.address_space_bytes % 1024:
+            raise ValueError('ARM native limit requires address-space bytes to be a positive multiple of 1024')
+        self.command = command
+        self.bash = Path(bash).resolve()
+        self.bash_identity = arm_tool_identity(self.bash)
+        self.tools = frozenset(str(Path(tool).resolve()) for tool in tools)
+        for tool in self.tools:
+            arm_tool_identity(tool)  # Native launcher never accepts a wrapper.
+
+    def __getattr__(self, name):
+        return getattr(self.command, name)
+
+    def _native_run(self, argv, prefix, stdout, probe):
+        payload = list(map(str, argv))
+        script = ARM_NATIVE_LIMIT_PROBE if probe else ARM_NATIVE_LIMIT_EXEC
+        wrapped = [str(self.bash), '--noprofile', '--norc', '-p', '-c', script,
+                   'arm-native-limit', str(self.address_space_bytes // 1024), *payload]
+        details = dict(payload_argv=payload, native_limit_bash_sha256=self.bash_identity['sha256'],
+                       native_limit_bash=str(self.bash), native_limit_probe=probe)
+        try:
+            record = self.command.run(wrapped, prefix, stdout=stdout)
+        except BaseException:
+            path = Path(prefix).with_suffix('.json')
+            if path.is_file():
+                record = json.loads(path.read_text())
+                record.update(details)
+                atomic_json(path, record)
+            raise
+        record.update(details)
+        atomic_json(Path(prefix).with_suffix('.json'), record)
+        return record
+
+    def run(self, argv, prefix, stdout=None):
+        if argv and str(Path(argv[0]).resolve()) in self.tools:
+            return self._native_run(argv, prefix, stdout, False)
+        return self.command.run(argv, prefix, stdout=stdout)
+
+    def probe(self, prefix, stdout):
+        return self._native_run(['/usr/bin/cat', '/proc/self/limits'], prefix, stdout, True)
+
