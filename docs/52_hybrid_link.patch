index 8498a91597a9..10e89babffa1 100644
--- a/lld/tools/lld/CMakeLists.txt
+++ b/lld/tools/lld/CMakeLists.txt
@@ -3,12 +3,26 @@ set(LLVM_LINK_COMPONENTS
