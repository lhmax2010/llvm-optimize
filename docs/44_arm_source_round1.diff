+            raise ValueError('ARM attribute reader is not GNU readelf: '+raw.strip())
+        versions['readelf'] = dict(path='/usr/bin/readelf', sha256=sha('/usr/bin/readelf'), raw=raw,
+                                   env_sha256=sha('/usr/bin/env'))
+    result['arm_full_version'] = full; result['arm_tool_versions'] = versions
+    return result
