+def arm_function_targets(lines, arch):
+    attributes, definitions = {}, []
+    for line in lines:
+        if line.startswith('attributes #'):
+            match = re.fullmatch(r'attributes #(\d+) = (.*)\s*', line.rstrip())
+            if not match or match[1] in attributes:
+                raise ValueError('invalid/duplicate ARM function attribute group')
+            attributes[match[1]] = match[2]
+        if line.startswith('define '):
+            if not line.rstrip().endswith('{'):
+                raise ValueError('uncertified multiline ARM function definition')
+            definitions.append(line)
+    for line in definitions:
+        groups = re.findall(r'\s#(\d+)(?=\s)', line)
+        if len(groups) != 1 or groups[0] not in attributes:
+            raise ValueError('ARM function definition lacks target attribute group: '+line.strip())
+        values = []
+        for key in ('target-cpu', 'target-features', 'tune-cpu'):
+            found = re.findall(r'"'+key+r'"="([^"]*)"', attributes[groups[0]])
+            if len(found) > 1:
+                raise ValueError('duplicate ARM function target attribute: '+key)
+            values.append(found[0] if found else None)
+        if tuple(values) != ARM_CERTIFIED_FUNCTION_TARGET[arch]:
+            raise ValueError('uncertified ARM function target attributes: '+repr(values))
+    return dict(definitions=len(definitions), certified=True)
+
+
+def arm_module_asm_whitelist(lines):
+    statements = []
+    for line in lines:
+        if not line.startswith('module asm '):
+            continue
+        match = re.fullmatch(r'module asm "(.*)"\s*', line)
+        if not match:
+            raise ValueError('unrecognized ARM module asm encoding')
+        encoded = match[1]
+        if re.search(r'\\(?![0-9A-Fa-f]{2})', encoded):
+            raise ValueError('invalid ARM module asm escape')
+        statement = re.sub(r'\\([0-9A-Fa-f]{2})', lambda m: chr(int(m[1], 16)), encoded).strip()
+        if statement not in ARM_CERTIFIED_MODULE_ASM:
+            raise ValueError('uncertified ARM module asm: '+repr(statement))
+        statements.append(statement)
+    return statements
