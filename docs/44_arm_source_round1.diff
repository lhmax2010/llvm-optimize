+def arm_attributes(text):
+    if not re.search(r'^Attribute Section: aeabi\s*$', text, re.M):
+        raise ValueError('ARM readelf output lacks aeabi attribute section')
+    keys = ('Tag_CPU_arch', 'Tag_ARM_ISA_use', 'Tag_THUMB_ISA_use', 'Tag_ABI_VFP_args')
+    result = {}
+    for key in keys:
+        matches = re.findall(r'^\s*'+key+r': (\S[^\r\n]*)$', text, re.M)
+        if len(matches) > 1 or len(re.findall(r'\b'+key+r'\b', text)) != len(matches):
+            raise ValueError('invalid ARM readelf attribute format: '+key)
+        result[key] = matches[0].strip() if matches else None
+    if result['Tag_CPU_arch'] is None:
+        raise ValueError('ARM readelf output lacks Tag_CPU_arch')
+    return result
