+               if s['name'] == '_ZSt21ios_base_library_initv' and s['info'] >> 4 == 1]
+    if not matches:
+        raise ValueError('ARM module asm global symbol missing: _ZSt21ios_base_library_initv')
+    return dict(required=True, symbol='_ZSt21ios_base_library_initv', matches=matches)
