+def arm_address_space_probe(command, output, allow_unenforced=False):
+    path = output/'address-space-limits.txt'
+    with path.open('wb') as stream:
+        command.run(['/usr/bin/cat', '/proc/self/limits'], output/'address-space-probe-command', stdout=stream)
+    raw = path.read_text()
+    matches = re.findall(r'^Max address space\s+(\S+)\s+(\S+)\s+bytes\s*$', raw, re.M)
+    if len(matches) != 1:
+        raise ValueError('cannot parse Max address space from /proc/self/limits')
+    soft, hard = matches[0]
+    if any(value != 'unlimited' and not value.isdecimal() for value in (soft, hard)):
+        raise ValueError('invalid Max address space values: '+repr(matches))
+    enforced = soft == hard == str(command.address_space_bytes)
+    result = dict(address_space_enforced=enforced, soft=soft, hard=hard, raw=raw,
+                  requested_bytes=command.address_space_bytes,
+                  explicitly_allowed_unenforced=bool(allow_unenforced))
+    atomic_json(output/'address-space-probe.json', result)
+    if not enforced and not allow_unenforced:
+        raise ValueError('ARM address space limit not enforced; explicit --allow-unenforced-address-space required')
+    return result
+
