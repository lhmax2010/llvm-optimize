From 2d23367d74afbf2bb1e9e4013fce072b3a154109 Mon Sep 17 00:00:00 2001
From: He Fangyu <fangyu.he@samsung.com>
Date: Wed, 2 Sep 2026 18:07:18 +0800
Subject: packaging: select Clang explicitly for libc++ runtimes

Select the target-prefixed Clang drivers directly in the libc++ runtimes
CMake configuration.  The previous package-local _toolchain_override did
not affect the RPM compiler macros in the Tizen-Base build environment, so
GCC was still selected and rejected the Clang-only --rtlib=libgcc option.

When an aarch64 GCC-default environment invokes this Clang-only package,
normalize only the GCC-specific composite -mtune value to cortex-a53.  This
matches the value already supplied by the LLVM project configuration; all
other environment flags remain unchanged.

The resulting spec was built in the armv7l and aarch64 GCC-default and LLVM
environments.  All four builds used Clang 22.1.8, completed successfully,
linked libc++ and libc++abi against libgcc_s.so.1, and installed the five
checked forced-unwind header changes.

Change-Id: Id2ae25c37e9319e2303bbd527fe695cb22ee95cd
Signed-off-by: He Fangyu <fangyu.he@samsung.com>
---
 packaging/libcxx-runtimes.spec | 13 +++++++++----
 1 file changed, 9 insertions(+), 4 deletions(-)

diff --git a/packaging/libcxx-runtimes.spec b/packaging/libcxx-runtimes.spec
index 56fe71f640e1..bb5b8be1ab4f 100644
--- a/packaging/libcxx-runtimes.spec
+++ b/packaging/libcxx-runtimes.spec
@@ -1,6 +1,5 @@
 %define llvm_major 22
 %define llvm_version 22.1.8
-%define _toolchain_override clang
 
 Name:           libcxx-runtimes
 Version:        22.1.8
@@ -63,14 +62,20 @@ cp %{SOURCE2} .
 cp %{SOURCE3} .
 
 %build
+%ifarch aarch64
+CFLAGS="$(printf '%%s\n' "$CFLAGS" | sed 's/-mtune=cortex-a57\.cortex-a53/-mtune=cortex-a53/g')"
+CXXFLAGS="$(printf '%%s\n' "$CXXFLAGS" | sed 's/-mtune=cortex-a57\.cortex-a53/-mtune=cortex-a53/g')"
+export CFLAGS CXXFLAGS
+%endif
+
 mkdir -p build
 cd build
 
 cmake -G Ninja \
   -DCMAKE_BUILD_TYPE=Release \
-  -DCMAKE_C_COMPILER=%{__cc} \
-  -DCMAKE_CXX_COMPILER=%{__cxx} \
-  -DCMAKE_ASM_COMPILER=%{__cc} \
+  -DCMAKE_C_COMPILER=%{_host}-clang \
+  -DCMAKE_CXX_COMPILER=%{_host}-clang++ \
+  -DCMAKE_ASM_COMPILER=%{_host}-clang \
   -DCMAKE_C_COMPILER_TARGET=%{_host} \
   -DCMAKE_CXX_COMPILER_TARGET=%{_host} \
   -DCMAKE_ASM_COMPILER_TARGET=%{_host} \
-- 
