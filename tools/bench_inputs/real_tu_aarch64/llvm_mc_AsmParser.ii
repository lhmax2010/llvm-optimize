class Flags {
  uint8_t Val = 0;

  constexpr static uint8_t bits(uint8_t BitIndex, uint8_t Length, uint8_t Value,
                                uint8_t OldValue) {
    uint8_t Pos = 8 - BitIndex - Length;
    uint8_t Mask = ((1 << Length) - 1) << Pos;
    Value = Value << Pos;
    return (OldValue & ~Mask) | Value;
  }

public:
  constexpr Flags() = default;
  constexpr Flags(uint8_t BitIndex, uint8_t Length, uint8_t Value)
      : Val(bits(BitIndex, Length, Value, 0)) {}

  template <typename T>
  constexpr void set(uint8_t BitIndex, uint8_t Length, T NewValue) {
    Val = bits(BitIndex, Length, static_cast<uint8_t>(NewValue), Val);
  }

  template <typename T>
  constexpr T get(uint8_t BitIndex, uint8_t Length) const {
    return static_cast<T>((Val >> (8 - BitIndex - Length)) &
                          ((1 << Length) - 1));
  }

  constexpr operator uint8_t() const { return Val; }
};




struct SymbolFlags {
  Flags SymFlags;





  void setFillBytePresence(bool Val) { SymFlags.set<bool>(0, 1, Val); } bool getFillBytePresence() const { return SymFlags.get<bool>(0, 1); }
  void setMangled(bool Val) { SymFlags.set<bool>(1, 1, Val); } bool getMangled() const { return SymFlags.get<bool>(1, 1); }
  void setRenameable(bool Val) { SymFlags.set<bool>(2, 1, Val); } bool getRenameable() const { return SymFlags.get<bool>(2, 1); }
  void setRemovableClass(bool Val) { SymFlags.set<bool>(3, 1, Val); } bool getRemovableClass() const { return SymFlags.get<bool>(3, 1); }
  void setReservedQwords(ESDReserveQwords Val) { SymFlags.set<ESDReserveQwords>(5, 3, Val); } ESDReserveQwords getReservedQwords() const { return SymFlags.get<ESDReserveQwords>(5, 3); }



  constexpr operator uint8_t() const { return static_cast<uint8_t>(SymFlags); }
};




struct BehavioralAttributes {
  Flags Attr[10];





  void setAmode(GOFF::ESDAmode Val) { Attr[0].set<GOFF::ESDAmode>(0, 8, Val); } GOFF::ESDAmode getAmode() const { return Attr[0].get<GOFF::ESDAmode>(0, 8); }
  void setRmode(GOFF::ESDRmode Val) { Attr[1].set<GOFF::ESDRmode>(0, 8, Val); } GOFF::ESDRmode getRmode() const { return Attr[1].get<GOFF::ESDRmode>(0, 8); }
  void setTextStyle(GOFF::ESDTextStyle Val) { Attr[2].set<GOFF::ESDTextStyle>(0, 4, Val); } GOFF::ESDTextStyle getTextStyle() const { return Attr[2].get<GOFF::ESDTextStyle>(0, 4); }
  void setBindingAlgorithm(GOFF::ESDBindingAlgorithm Val) { Attr[2].set<GOFF::ESDBindingAlgorithm>(4, 4, Val); } GOFF::ESDBindingAlgorithm getBindingAlgorithm() const { return Attr[2].get<GOFF::ESDBindingAlgorithm>(4, 4); }

  void setTaskingBehavior(GOFF::ESDTaskingBehavior Val) { Attr[3].set<GOFF::ESDTaskingBehavior>(0, 3, Val); } GOFF::ESDTaskingBehavior getTaskingBehavior() const { return Attr[3].get<GOFF::ESDTaskingBehavior>(0, 3); }
  void setReadOnly(bool Val) { Attr[3].set<bool>(4, 1, Val); } bool getReadOnly() const { return Attr[3].get<bool>(4, 1); }
  void setExecutable(GOFF::ESDExecutable Val) { Attr[3].set<GOFF::ESDExecutable>(5, 3, Val); } GOFF::ESDExecutable getExecutable() const { return Attr[3].get<GOFF::ESDExecutable>(5, 3); }
  void setDuplicateSymbolSeverity(GOFF::ESDDuplicateSymbolSeverity Val) { Attr[4].set<GOFF::ESDDuplicateSymbolSeverity>(2, 2, Val); } GOFF::ESDDuplicateSymbolSeverity getDuplicateSymbolSeverity() const { return Attr[4].get<GOFF::ESDDuplicateSymbolSeverity>(2, 2); }

  void setBindingStrength(GOFF::ESDBindingStrength Val) { Attr[4].set<GOFF::ESDBindingStrength>(4, 4, Val); } GOFF::ESDBindingStrength getBindingStrength() const { return Attr[4].get<GOFF::ESDBindingStrength>(4, 4); }
  void setLoadingBehavior(GOFF::ESDLoadingBehavior Val) { Attr[5].set<GOFF::ESDLoadingBehavior>(0, 2, Val); } GOFF::ESDLoadingBehavior getLoadingBehavior() const { return Attr[5].get<GOFF::ESDLoadingBehavior>(0, 2); }
  void setCOMMON(bool Val) { Attr[5].set<bool>(2, 1, Val); } bool getCOMMON() const { return Attr[5].get<bool>(2, 1); }
  void setIndirectReference(bool Val) { Attr[5].set<bool>(3, 1, Val); } bool getIndirectReference() const { return Attr[5].get<bool>(3, 1); }
  void setBindingScope(GOFF::ESDBindingScope Val) { Attr[5].set<GOFF::ESDBindingScope>(4, 4, Val); } GOFF::ESDBindingScope getBindingScope() const { return Attr[5].get<GOFF::ESDBindingScope>(4, 4); }
  void setLinkageType(GOFF::ESDLinkageType Val) { Attr[6].set<GOFF::ESDLinkageType>(2, 1, Val); } GOFF::ESDLinkageType getLinkageType() const { return Attr[6].get<GOFF::ESDLinkageType>(2, 1); }
  void setAlignment(GOFF::ESDAlignment Val) { Attr[6].set<GOFF::ESDAlignment>(3, 5, Val); } GOFF::ESDAlignment getAlignment() const { return Attr[6].get<GOFF::ESDAlignment>(3, 5); }


};
