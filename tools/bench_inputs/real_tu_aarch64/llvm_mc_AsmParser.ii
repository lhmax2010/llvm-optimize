namespace llvm {

class raw_ostream;


class StringTableBuilder {
public:
  enum Kind {
    ELF,
    WinCOFF,
    MachO,
    MachO64,
    MachOLinked,
    MachO64Linked,
    RAW,
    DWARF,
    XCOFF,
    DXContainer
  };

private:

  DenseMap<CachedHashStringRef, uint8_t> StringPriorityMap;
  DenseMap<CachedHashStringRef, size_t> StringIndexMap;
  size_t Size = 0;
  Kind K;
  Align Alignment;
  bool Finalized = false;

  void finalizeStringTable(bool Optimize);
  void initSize();

public:
  __attribute__((visibility("default"))) StringTableBuilder(Kind K, Align Alignment = Align(1));
  __attribute__((visibility("default"))) ~StringTableBuilder();







  __attribute__((visibility("default"))) size_t add(CachedHashStringRef S, uint8_t Priority = 0);
  size_t add(StringRef S, uint8_t Priority = 0) {
    return add(CachedHashStringRef(S), Priority);
  }



  __attribute__((visibility("default"))) void finalize();



  __attribute__((visibility("default"))) void finalizeInOrder();



  __attribute__((visibility("default"))) size_t getOffset(CachedHashStringRef S) const;
  size_t getOffset(StringRef S) const {
    return getOffset(CachedHashStringRef(S));
  }




  bool contains(StringRef S) const { return contains(CachedHashStringRef(S)); }
  bool contains(CachedHashStringRef S) const { return StringIndexMap.count(S); }

  bool empty() const { return StringIndexMap.empty(); }
  size_t getSize() const { return Size; }
  __attribute__((visibility("default"))) void clear();

  __attribute__((visibility("default"))) void write(raw_ostream &OS) const;
  __attribute__((visibility("default"))) void write(uint8_t *Buf) const;

  bool isFinalized() const { return Finalized; }
};

}
