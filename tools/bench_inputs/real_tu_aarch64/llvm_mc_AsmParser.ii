# 61 "/home/linhao/Toolchain/development/llvm-optimize/temp/gbs-root-x86_64-debuginfo-j4-v2/local/BUILD-ROOTS/scratch.x86_64.0/home/abuild/rpmbuild/BUILD/llvm-22.1.8/llvm/include/llvm/MC/MCFixup.h"
class MCFixup {



  const MCExpr *Value = nullptr;


  uint32_t Offset = 0;



  MCFixupKind Kind = FK_NONE;




  bool PCRel = false;



  bool LinkerRelaxable = false;



public:
  static MCFixup create(uint32_t Offset, const MCExpr *Value, MCFixupKind Kind,
                        bool PCRel = false) {
    MCFixup FI;
    FI.Value = Value;
    FI.Offset = Offset;
    FI.Kind = Kind;
    FI.PCRel = PCRel;
    return FI;
  }

  MCFixupKind getKind() const { return Kind; }

  uint32_t getOffset() const { return Offset; }
  void setOffset(uint32_t Value) { Offset = Value; }

  const MCExpr *getValue() const { return Value; }

  bool isPCRel() const { return PCRel; }
  void setPCRel() { PCRel = true; }
  bool isLinkerRelaxable() const { return LinkerRelaxable; }
  void setLinkerRelaxable() { LinkerRelaxable = true; }



  static MCFixupKind getDataKindForSize(unsigned Size) {
    switch (Size) {
    default: __builtin_unreachable();
    case 1:
      return FK_Data_1;
    case 2:
      return FK_Data_2;
    case 4:
      return FK_Data_4;
    case 8:
      return FK_Data_8;
    }
  }

  __attribute__((visibility("default"))) SMLoc getLoc() const;
};

namespace mc {


inline bool isRelocation(MCFixupKind FixupKind) { return FixupKind < FK_NONE; }




inline bool isRelocRelocation(MCFixupKind FixupKind) {
  return FirstLiteralRelocationKind <= FixupKind && FixupKind < FK_NONE;
}
}

}
