inline char hexdigit(unsigned X, bool LowerCase = false) {
  (static_cast<void> (0));
  static const char LUT[] = "0123456789ABCDEF";
  const uint8_t Offset = LowerCase ? 32 : 0;
  return LUT[X] | Offset;
