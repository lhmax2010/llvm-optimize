template <class X, class Y> [[nodiscard]] inline auto cast_if_present(Y *Val) {
  if (!detail::isPresent(Val))
    return CastInfo<X, Y *>::castFailed();
  (static_cast<void> (0));
  return cast<X>(detail::unwrapValue(Val));
}

