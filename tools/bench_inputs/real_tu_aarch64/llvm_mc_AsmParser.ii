  template <typename LookupKeyT>
  const BucketT *doFind(const LookupKeyT &Val) const {
    const BucketT *BucketsPtr = getBuckets();
    const unsigned NumBuckets = getNumBuckets();
    if (NumBuckets == 0)
      return nullptr;

    const KeyT EmptyKey = KeyInfoT::getEmptyKey();
    unsigned BucketNo = KeyInfoT::getHashValue(Val) & (NumBuckets - 1);
    unsigned ProbeAmt = 1;
    while (true) {
      const BucketT *Bucket = BucketsPtr + BucketNo;
      if (__builtin_expect((bool)(KeyInfoT::isEqual(Val, Bucket->getFirst())), true))
        return Bucket;
      if (__builtin_expect((bool)(KeyInfoT::isEqual(Bucket->getFirst(), EmptyKey)), true))
        return nullptr;



      BucketNo += ProbeAmt++;
      BucketNo &= NumBuckets - 1;
    }
  }

