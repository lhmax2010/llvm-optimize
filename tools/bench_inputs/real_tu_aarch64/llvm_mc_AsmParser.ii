    (static_cast<void> (0));

  }

  uint64_t getGuid() const { return Guid; };
  MCSymbol *getLabel() const { return Label; }
  __attribute__((visibility("default"))) void emit(MCObjectStreamer *MCOS,
                     const MCPseudoProbe *LastProbe) const;
