  namespace CodeGenOpt {



  inline std::optional<CodeGenOptLevel> getLevel(int OL) {
    if (OL < 0 || OL > 3)
      return std::nullopt;
    return static_cast<CodeGenOptLevel>(OL);
  }



  inline std::optional<CodeGenOptLevel> parseLevel(char C) {
    if (C < '0')
