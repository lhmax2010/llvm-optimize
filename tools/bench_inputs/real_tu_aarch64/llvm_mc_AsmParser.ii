class __attribute__((visibility("default"))) ErrorInfoBase {
public:
  virtual ~ErrorInfoBase() = default;


  virtual void log(raw_ostream &OS) const = 0;


  virtual std::string message() const {
    std::string Msg;
    raw_string_ostream OS(Msg);
    log(OS);
    return Msg;
  }





