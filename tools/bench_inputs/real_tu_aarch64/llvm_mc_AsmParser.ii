namespace llvm {
class MCExpr;


using MCFixupKind = uint16_t;
enum {





  FirstLiteralRelocationKind = 2000,



  FK_NONE = 4000,
  FK_Data_1,
  FK_Data_2,
  FK_Data_4,
  FK_Data_8,
  FK_Data_leb128,
  FK_SecRel_1,
  FK_SecRel_2,
  FK_SecRel_4,
  FK_SecRel_8,

  FirstTargetFixupKind,
