class SubCommand {
private:
  StringRef Name;
  StringRef Description;

protected:
  __attribute__((visibility("default"))) void registerSubCommand();
  __attribute__((visibility("default"))) void unregisterSubCommand();

public:
  SubCommand(StringRef Name, StringRef Description = "")
      : Name(Name), Description(Description) {
        registerSubCommand();
  }
  SubCommand() = default;


  __attribute__((visibility("default"))) static SubCommand &getTopLevel();



  __attribute__((visibility("default"))) static SubCommand &getAll();

  __attribute__((visibility("default"))) void reset();

  __attribute__((visibility("default"))) explicit operator bool() const;

  StringRef getName() const { return Name; }
  StringRef getDescription() const { return Description; }

  SmallVector<Option *, 4> PositionalOpts;
  SmallVector<Option *, 4> SinkOpts;
