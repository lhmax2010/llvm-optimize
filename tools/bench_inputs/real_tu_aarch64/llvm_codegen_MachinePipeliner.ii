  enum ExprKind : uint8_t {
    Binary,
    Constant,
    SymbolRef,
    Unary,
    Specifier,
    Target
  };

private:
  static const unsigned NumSubclassDataBits = 24;
  static_assert(
      NumSubclassDataBits == 8 * (sizeof(unsigned) - sizeof(ExprKind)),
      "ExprKind and SubclassData together should take up one word");

  ExprKind Kind;

  unsigned SubclassData : NumSubclassDataBits;
  SMLoc Loc;

  void print(raw_ostream &OS, const MCAsmInfo *MAI,
             int SurroundingPrec = 0) const;
  bool evaluateAsAbsolute(int64_t &Res, const MCAssembler *Asm,
                          bool InSet) const;

protected:
  using Spec = uint16_t;
  explicit MCExpr(ExprKind Kind, SMLoc Loc, unsigned SubclassData = 0)
      : Kind(Kind), SubclassData(SubclassData), Loc(Loc) {
    (static_cast<void> (0));

  }

  __attribute__((visibility("default"))) bool evaluateAsRelocatableImpl(MCValue &Res, const MCAssembler *Asm,
                                          bool InSet) const;

  unsigned getSubclassData() const { return SubclassData; }

public:
  MCExpr(const MCExpr &) = delete;
  MCExpr &operator=(const MCExpr &) = delete;




  ExprKind getKind() const { return Kind; }
  SMLoc getLoc() const { return Loc; }





  __attribute__((visibility("default"))) void dump() const;
