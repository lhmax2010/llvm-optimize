    (static_cast<void> (0));
    (static_cast<void> (0));

    return PointerType::getUnqual(ElementType->getContext());
  }



  static PointerType *getUnqual(LLVMContext &C) {
    return PointerType::get(C, 0);
  }


  __attribute__((visibility("default"))) static bool isValidElementType(Type *ElemTy);


  __attribute__((visibility("default"))) static bool isLoadableOrStorableType(Type *ElemTy);


  inline unsigned getAddressSpace() const { return getSubclassData(); }


  static bool classof(const Type *T) {
