class __attribute__((visibility("default"))) DiagnosticInfoOptimizationBase
    : public DiagnosticInfoWithLocationBase {
public:

  struct setIsVerbose {};





  struct setExtraArgs {};



  struct Argument {
    std::string Key;
    std::string Val;

    DiagnosticLocation Loc;

    explicit Argument(StringRef Str = "") : Key("String"), Val(Str) {}
    __attribute__((visibility("default"))) Argument(StringRef Key, const Value *V);
    __attribute__((visibility("default"))) Argument(StringRef Key, const Type *T);
    __attribute__((visibility("default"))) Argument(StringRef Key, StringRef S);
    Argument(StringRef Key, const char *S) : Argument(Key, StringRef(S)) {};
    __attribute__((visibility("default"))) Argument(StringRef Key, int N);
    __attribute__((visibility("default"))) Argument(StringRef Key, float N);
    __attribute__((visibility("default"))) Argument(StringRef Key, long N);
    __attribute__((visibility("default"))) Argument(StringRef Key, long long N);
    __attribute__((visibility("default"))) Argument(StringRef Key, unsigned N);
    __attribute__((visibility("default"))) Argument(StringRef Key, unsigned long N);
    __attribute__((visibility("default"))) Argument(StringRef Key, unsigned long long N);
    __attribute__((visibility("default"))) Argument(StringRef Key, ElementCount EC);
    Argument(StringRef Key, bool B) : Key(Key), Val(B ? "true" : "false") {}
    __attribute__((visibility("default"))) Argument(StringRef Key, DebugLoc dl);
    __attribute__((visibility("default"))) Argument(StringRef Key, InstructionCost C);
    __attribute__((visibility("default"))) Argument(StringRef Key, BranchProbability P);
  };







  DiagnosticInfoOptimizationBase(enum DiagnosticKind Kind,
                                 enum DiagnosticSeverity Severity,
                                 const char *PassName, StringRef RemarkName,
                                 const Function &Fn,
                                 const DiagnosticLocation &Loc)
      : DiagnosticInfoWithLocationBase(Kind, Severity, Fn, Loc),
        PassName(PassName), RemarkName(RemarkName) {}

  void insert(StringRef S);
  void insert(Argument A);
  void insert(setIsVerbose V);
  void insert(setExtraArgs EA);


  void print(DiagnosticPrinter &DP) const override;






  virtual bool isEnabled() const = 0;

  StringRef getPassName() const { return PassName; }
  StringRef getRemarkName() const { return RemarkName; }
  std::string getMsg() const;
  std::optional<uint64_t> getHotness() const { return Hotness; }
  void setHotness(std::optional<uint64_t> H) { Hotness = H; }

  bool isVerbose() const { return IsVerbose; }

  ArrayRef<Argument> getArgs() const { return Args; }

  static bool classof(const DiagnosticInfo *DI) {
    return (DI->getKind() >= DK_FirstRemark &&
            DI->getKind() <= DK_LastRemark) ||
           (DI->getKind() >= DK_FirstMachineRemark &&
            DI->getKind() <= DK_LastMachineRemark);
  }

  bool isPassed() const {
    return (getKind() == DK_OptimizationRemark ||
            getKind() == DK_MachineOptimizationRemark);
  }

  bool isMissed() const {
    return (getKind() == DK_OptimizationRemarkMissed ||
            getKind() == DK_MachineOptimizationRemarkMissed);
  }

  bool isAnalysis() const {
    return (getKind() == DK_OptimizationRemarkAnalysis ||
            getKind() == DK_MachineOptimizationRemarkAnalysis);
  }

protected:



  const char *PassName;




  StringRef RemarkName;



  std::optional<uint64_t> Hotness;


  SmallVector<Argument, 4> Args;


  bool IsVerbose = false;




  int FirstExtraArgIndex = -1;
};




template <class RemarkT>
decltype(auto)
operator<<(RemarkT &&R,
           std::enable_if_t<std::is_base_of_v<DiagnosticInfoOptimizationBase,
                                              std::remove_reference_t<RemarkT>>,
                            StringRef>
               S) {
  R.insert(S);
  return std::forward<RemarkT>(R);
}

template <class RemarkT>
decltype(auto)
operator<<(RemarkT &&R,
           std::enable_if_t<std::is_base_of_v<DiagnosticInfoOptimizationBase,
                                              std::remove_reference_t<RemarkT>>,
                            DiagnosticInfoOptimizationBase::Argument>
               A) {
  R.insert(A);
  return std::forward<RemarkT>(R);
}

template <class RemarkT>
decltype(auto)
operator<<(RemarkT &&R,
           std::enable_if_t<std::is_base_of_v<DiagnosticInfoOptimizationBase,
                                              std::remove_reference_t<RemarkT>>,
                            DiagnosticInfoOptimizationBase::setIsVerbose>
               V) {
  R.insert(V);
  return std::forward<RemarkT>(R);
}

template <class RemarkT>
decltype(auto)
operator<<(RemarkT &&R,
           std::enable_if_t<std::is_base_of_v<DiagnosticInfoOptimizationBase,
                                              std::remove_reference_t<RemarkT>>,
                            DiagnosticInfoOptimizationBase::setExtraArgs>
               EA) {
  R.insert(EA);
  return std::forward<RemarkT>(R);
}



