  FCmpInst(InsertPosition InsertBefore,
           Predicate pred,
           Value *LHS,
           Value *RHS,
           const Twine &NameStr = ""
           )
      : CmpInst(makeCmpResultType(LHS->getType()), Instruction::FCmp, pred, LHS,
