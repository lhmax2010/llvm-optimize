  template<typename T>
  inline bool operator==(ArrayRef<T> LHS, ArrayRef<T> RHS) {
    return LHS.equals(RHS);
  }

  template <typename T>
  [[nodiscard]] inline bool operator==(const SmallVectorImpl<T> &LHS,
                                       ArrayRef<T> RHS) {
    return ArrayRef<T>(LHS).equals(RHS);
