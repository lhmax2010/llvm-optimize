    PersistentId = 0xffff;





    Op.setUser(this);
    Op.setInitial(X);
    NumOperands = 1;
    OperandList = &Op;
  }
  __attribute__((visibility("default"))) ~HandleSDNode();

  const SDValue &getValue() const { return Op; }
};

