  inline SUnit *ScheduleDAGInstrs::newSUnit(MachineInstr *MI) {



    SUnits.emplace_back(MI, (unsigned)SUnits.size());
    (static_cast<void> (0));

    return &SUnits.back();
  }


  inline SUnit *ScheduleDAGInstrs::getSUnit(MachineInstr *MI) const {
    return MISUnitMap.lookup(MI);
  }

