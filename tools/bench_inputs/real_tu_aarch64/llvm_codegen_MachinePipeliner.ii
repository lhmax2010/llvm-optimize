public:
  ReplaceableMetadataImpl(LLVMContext &Context) : Context(Context) {}

  ~ReplaceableMetadataImpl() {
    (static_cast<void> (0));
  }

  LLVMContext &getContext() const { return Context; }




  __attribute__((visibility("default"))) void replaceAllUsesWith(Metadata *MD);

  __attribute__((visibility("default"))) static void SalvageDebugInfo(const Constant &C);

  __attribute__((visibility("default"))) SmallVector<Metadata *> getAllArgListUsers();

  __attribute__((visibility("default"))) SmallVector<DbgVariableRecord *> getAllDbgVariableRecordUsers();






  __attribute__((visibility("default"))) void resolveAllUses(bool ResolveUsers = true);

  unsigned getNumUses() const { return UseMap.size(); }

private:
  void addRef(void *Ref, OwnerTy Owner);
  void dropRef(void *Ref);
  void moveRef(void *Ref, void *New, const Metadata &MD);





  static ReplaceableMetadataImpl *getOrCreate(Metadata &MD);


  static ReplaceableMetadataImpl *getIfExists(Metadata &MD);




  static bool isReplaceable(const Metadata &MD);
};
