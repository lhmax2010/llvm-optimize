  DbgMarker *getMarker() { return Marker; }
  const DbgMarker *getMarker() const { return Marker; }

  __attribute__((visibility("default"))) BasicBlock *getBlock();
  __attribute__((visibility("default"))) const BasicBlock *getBlock() const;

  __attribute__((visibility("default"))) Function *getFunction();
  __attribute__((visibility("default"))) const Function *getFunction() const;

  __attribute__((visibility("default"))) Module *getModule();
  __attribute__((visibility("default"))) const Module *getModule() const;

