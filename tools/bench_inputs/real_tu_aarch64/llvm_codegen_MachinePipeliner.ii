namespace llvm {
class BasicBlock;
class Function;
class Triple;
class Value;

enum class EHPersonality {
  Unknown,
  GNU_Ada,
  GNU_C,
  GNU_C_SjLj,
  GNU_CXX,
  GNU_CXX_SjLj,
  GNU_ObjC,
  MSVC_X86SEH,
  MSVC_TableSEH,
  MSVC_CXX,
  CoreCLR,
  Rust,
  Wasm_CXX,
  XL_CXX,
  ZOS_CXX,
};




__attribute__((visibility("default"))) EHPersonality classifyEHPersonality(const Value *Pers);

__attribute__((visibility("default"))) StringRef getEHPersonalityName(EHPersonality Pers);

__attribute__((visibility("default"))) EHPersonality getDefaultEHPersonality(const Triple &T);



inline bool isAsynchronousEHPersonality(EHPersonality Pers) {


  switch (Pers) {
  case EHPersonality::MSVC_X86SEH:
  case EHPersonality::MSVC_TableSEH:
    return true;
  default:
    return false;
  }
  __builtin_unreachable();
}



inline bool isFuncletEHPersonality(EHPersonality Pers) {
  switch (Pers) {
  case EHPersonality::MSVC_CXX:
  case EHPersonality::MSVC_X86SEH:
  case EHPersonality::MSVC_TableSEH:
  case EHPersonality::CoreCLR:
    return true;
  default:
    return false;
  }
  __builtin_unreachable();
}



inline bool isScopedEHPersonality(EHPersonality Pers) {
  switch (Pers) {
  case EHPersonality::MSVC_CXX:
  case EHPersonality::MSVC_X86SEH:
  case EHPersonality::MSVC_TableSEH:
  case EHPersonality::CoreCLR:
  case EHPersonality::Wasm_CXX:
    return true;
  default:
    return false;
  }
  __builtin_unreachable();
}



inline bool isNoOpWithoutInvoke(EHPersonality Pers) {
  switch (Pers) {
  case EHPersonality::Unknown:
    return false;

  default:
    return true;
  }
  __builtin_unreachable();
}

__attribute__((visibility("default"))) bool canSimplifyInvokeNoUnwind(const Function *F);

typedef TinyPtrVector<BasicBlock *> ColorVector;





__attribute__((visibility("default"))) DenseMap<BasicBlock *, ColorVector> colorEHFunclets(Function &F);

}
