template <typename KeyT, typename ValueT, typename KeyFunctorT>
struct SparseSetValFunctor {
  unsigned operator()(const ValueT &Val) const {
    if constexpr (std::is_same_v<KeyT, ValueT>)
      return KeyFunctorT()(Val);
