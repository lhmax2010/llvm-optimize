  __attribute__((visibility("default"))) void printPipeline(raw_ostream &OS,
                              function_ref<StringRef(StringRef)>) const;

  MachineFunctionProperties getSetProperties() const {
    if (ClearVirtRegs)
      return MachineFunctionProperties().setNoVRegs();
    return {};
  }
};

