std::optional<APInt> SDNode::bitcastToAPInt() const {
  if (auto *CN = dyn_cast<ConstantSDNode>(this))
    return CN->getAPIntValue();
  if (auto *CFPN = dyn_cast<ConstantFPSDNode>(this))
    return CFPN->getValueAPF().bitcastToAPInt();
  return std::nullopt;
}


