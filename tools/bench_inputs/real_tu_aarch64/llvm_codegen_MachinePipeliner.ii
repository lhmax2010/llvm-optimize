namespace llvm {
template <typename T> class SmallVectorImpl;
class Error;





enum class DebugCompressionType {
  None,
  Zlib,
  Zstd,
};

namespace compression {
namespace zlib {

constexpr int NoCompression = 0;
constexpr int BestSpeedCompression = 1;
constexpr int DefaultCompression = 6;
constexpr int BestSizeCompression = 9;

__attribute__((visibility("default"))) bool isAvailable();

__attribute__((visibility("default"))) void compress(ArrayRef<uint8_t> Input,
                       SmallVectorImpl<uint8_t> &CompressedBuffer,
                       int Level = DefaultCompression);

__attribute__((visibility("default"))) Error decompress(ArrayRef<uint8_t> Input, uint8_t *Output,
                          size_t &UncompressedSize);

