class VirtRegMap {
  MachineRegisterInfo *MRI = nullptr;
  const TargetInstrInfo *TII = nullptr;
  const TargetRegisterInfo *TRI = nullptr;
  MachineFunction *MF = nullptr;






  IndexedMap<MCRegister, VirtReg2IndexFunctor> Virt2PhysMap;





  IndexedMap<int, VirtReg2IndexFunctor> Virt2StackSlotMap;



  IndexedMap<Register, VirtReg2IndexFunctor> Virt2SplitMap;



  DenseMap<Register, ShapeT> Virt2ShapeMap;


  unsigned createSpillSlot(const TargetRegisterClass *RC);

public:
  static constexpr int NO_STACK_SLOT = 2147483647;

  VirtRegMap() : Virt2StackSlotMap(NO_STACK_SLOT) {}
  VirtRegMap(const VirtRegMap &) = delete;
  VirtRegMap &operator=(const VirtRegMap &) = delete;
  VirtRegMap(VirtRegMap &&) = default;

  __attribute__((visibility("default"))) void init(MachineFunction &MF);

  MachineFunction &getMachineFunction() const {
    (static_cast<void> (0));
    return *MF;
  }

  MachineRegisterInfo &getRegInfo() const { return *MRI; }
  const TargetRegisterInfo &getTargetRegInfo() const { return *TRI; }

  __attribute__((visibility("default"))) void grow();



  bool hasPhys(Register virtReg) const { return getPhys(virtReg).isValid(); }



  MCRegister getPhys(Register virtReg) const {
    (static_cast<void> (0));
    return Virt2PhysMap[virtReg];
  }



  __attribute__((visibility("default"))) void assignVirt2Phys(Register virtReg, MCRegister physReg);

  bool isShapeMapEmpty() const { return Virt2ShapeMap.empty(); }

  bool hasShape(Register virtReg) const {
    return Virt2ShapeMap.contains(virtReg);
  }

  ShapeT getShape(Register virtReg) const {
    (static_cast<void> (0));
    return Virt2ShapeMap.lookup(virtReg);
  }

  void assignVirt2Shape(Register virtReg, ShapeT shape) {
    Virt2ShapeMap[virtReg] = shape;
  }



  void clearVirt(Register virtReg) {
    (static_cast<void> (0));
    (static_cast<void> (0));

    Virt2PhysMap[virtReg] = MCRegister();
  }


  void clearAllVirt() {
    Virt2PhysMap.clear();
    grow();
  }


  __attribute__((visibility("default"))) bool hasPreferredPhys(Register VirtReg) const;




  __attribute__((visibility("default"))) bool hasKnownPreference(Register VirtReg) const;


  void setIsSplitFromReg(Register virtReg, Register SReg) {
    Virt2SplitMap[virtReg] = SReg;
    if (hasShape(SReg)) {
      Virt2ShapeMap[virtReg] = getShape(SReg);
    }
  }


  Register getPreSplitReg(Register virtReg) const {
    return Virt2SplitMap[virtReg];
  }





  Register getOriginal(Register VirtReg) const {
    Register Orig = getPreSplitReg(VirtReg);
    return Orig ? Orig : VirtReg;
  }



  bool isAssignedReg(Register virtReg) const {
    if (getStackSlot(virtReg) == NO_STACK_SLOT)
      return true;


    return (Virt2SplitMap[virtReg] && Virt2PhysMap[virtReg]);
  }



  int getStackSlot(Register virtReg) const {
    (static_cast<void> (0));
    return Virt2StackSlotMap[virtReg];
  }



  __attribute__((visibility("default"))) int assignVirt2StackSlot(Register virtReg);



  __attribute__((visibility("default"))) void assignVirt2StackSlot(Register virtReg, int SS);

  __attribute__((visibility("default"))) void print(raw_ostream &OS, const Module *M = nullptr) const;
  __attribute__((visibility("default"))) void dump() const;
};

