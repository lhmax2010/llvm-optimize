  __attribute__((visibility("default"))) const LLVMContext &getContext() const;

  __attribute__((visibility("default"))) const Instruction *getInstruction() const;
  __attribute__((visibility("default"))) const BasicBlock *getParent() const;
  __attribute__((visibility("default"))) BasicBlock *getParent();

  __attribute__((visibility("default"))) void removeFromParent();
  __attribute__((visibility("default"))) void eraseFromParent();

  DbgRecord *getNextNode() { return &*std::next(getIterator()); }
  DbgRecord *getPrevNode() { return &*std::prev(getIterator()); }



  __attribute__((visibility("default"))) void insertBefore(DbgRecord *InsertBefore);
  __attribute__((visibility("default"))) void insertAfter(DbgRecord *InsertAfter);
  __attribute__((visibility("default"))) void moveBefore(DbgRecord *MoveBefore);
  __attribute__((visibility("default"))) void moveAfter(DbgRecord *MoveAfter);

  __attribute__((visibility("default"))) void insertBefore(self_iterator InsertBefore);
  __attribute__((visibility("default"))) void insertAfter(self_iterator InsertAfter);
  __attribute__((visibility("default"))) void moveBefore(self_iterator MoveBefore);
  __attribute__((visibility("default"))) void moveAfter(self_iterator MoveAfter);

  DebugLoc getDebugLoc() const { return DbgLoc; }
  void setDebugLoc(DebugLoc Loc) { DbgLoc = std::move(Loc); }

  __attribute__((visibility("default"))) void dump() const;

  using self_iterator = simple_ilist<DbgRecord>::iterator;
  using const_self_iterator = simple_ilist<DbgRecord>::const_iterator;

protected:




  ~DbgRecord() = default;
};

inline raw_ostream &operator<<(raw_ostream &OS, const DbgRecord &R) {
  R.print(OS);
  return OS;
}



