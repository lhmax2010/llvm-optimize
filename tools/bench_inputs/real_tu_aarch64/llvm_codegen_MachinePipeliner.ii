    }
    (static_cast<void> (0));
    if (isa<EltTy>(Val)) {
      EltTy V = cast<EltTy>(Val);
      (static_cast<void> (0));
      Val = Elt;
      push_back(V);
      return begin();
    }

    return cast<VecTy *>(Val)->insert(I, Elt);
  }

  template<typename ItTy>
  iterator insert(iterator I, ItTy From, ItTy To) {
    (static_cast<void> (0));
    (static_cast<void> (0));
    if (From == To)
      return I;


    ptrdiff_t Offset = I - begin();
    if (Val.isNull()) {
