    [[nodiscard]] StringRef detectEOL() const {
      size_t Pos = find('\r');
      if (Pos == npos) {

        return "\n";
      }
      if (Pos + 1 < size() && data()[Pos + 1] == '\n')
        return "\r\n";
      if (Pos > 0 && data()[Pos - 1] == '\n')
        return "\n\r";
      return "\r";
    }

