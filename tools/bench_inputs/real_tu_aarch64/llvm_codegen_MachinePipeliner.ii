           OperandType <= MCOI::OPERAND_LAST_GENERIC_IMM;
  }

  unsigned getGenericImmIndex() const {
    (static_cast<void> (0));
    return OperandType - MCOI::OPERAND_FIRST_GENERIC_IMM;
  }
};





