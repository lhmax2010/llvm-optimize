public:





  Triple() = default;

  __attribute__((visibility("default"))) explicit Triple(std::string &&Str);
  explicit Triple(StringRef Str) : Triple(Str.str()) {}
  explicit Triple(const char *Str) : Triple(std::string(Str)) {}
  explicit Triple(const std::string &Str) : Triple(std::string(Str)) {}
  __attribute__((visibility("default"))) explicit Triple(const Twine &Str);

  __attribute__((visibility("default"))) Triple(const Twine &ArchStr, const Twine &VendorStr,
                  const Twine &OSStr);
  __attribute__((visibility("default"))) Triple(const Twine &ArchStr, const Twine &VendorStr,
                  const Twine &OSStr, const Twine &EnvironmentStr);

  bool operator==(const Triple &Other) const {
    return Arch == Other.Arch && SubArch == Other.SubArch &&
           Vendor == Other.Vendor && OS == Other.OS &&
           Environment == Other.Environment &&
           ObjectFormat == Other.ObjectFormat;
  }

  bool operator!=(const Triple &Other) const {
    return !(*this == Other);
  }






  enum class CanonicalForm {
    ANY = 0,
    THREE_IDENT = 3,
    FOUR_IDENT = 4,
    FIVE_IDENT = 5,
  };






  __attribute__((visibility("default"))) static std::string
  normalize(StringRef Str, CanonicalForm Form = CanonicalForm::ANY);


  std::string normalize(CanonicalForm Form = CanonicalForm::ANY) const {
    return normalize(Data, Form);
  }






  ArchType getArch() const { return Arch; }


  SubArchType getSubArch() const { return SubArch; }


  VendorType getVendor() const { return Vendor; }


  OSType getOS() const { return OS; }


  bool hasEnvironment() const {
    return getEnvironmentName() != "";
  }


  EnvironmentType getEnvironment() const { return Environment; }





  __attribute__((visibility("default"))) VersionTuple getEnvironmentVersion() const;


  ObjectFormatType getObjectFormat() const { return ObjectFormat; }





  __attribute__((visibility("default"))) VersionTuple getOSVersion() const;



  unsigned getOSMajorVersion() const { return getOSVersion().getMajor(); }





  __attribute__((visibility("default"))) bool getMacOSXVersion(VersionTuple &Version) const;



  __attribute__((visibility("default"))) VersionTuple getiOSVersion() const;



  __attribute__((visibility("default"))) VersionTuple getWatchOSVersion() const;


  __attribute__((visibility("default"))) VersionTuple getDriverKitVersion() const;



  __attribute__((visibility("default"))) VersionTuple getVulkanVersion() const;



  __attribute__((visibility("default"))) VersionTuple getDXILVersion() const;





  const std::string &str() const { return Data; }

  const std::string &getTriple() const { return Data; }


  bool empty() const { return Data.empty(); }


  __attribute__((visibility("default"))) StringRef getArchName() const;


  __attribute__((visibility("default"))) StringRef getVendorName() const;


  __attribute__((visibility("default"))) StringRef getOSName() const;



  __attribute__((visibility("default"))) StringRef getEnvironmentName() const;



  __attribute__((visibility("default"))) StringRef getOSAndEnvironmentName() const;





  __attribute__((visibility("default"))) StringRef getEnvironmentVersionString() const;






  __attribute__((visibility("default"))) static unsigned getArchPointerBitWidth(llvm::Triple::ArchType Arch);


  unsigned getArchPointerBitWidth() const {
    return getArchPointerBitWidth(getArch());
  }


  __attribute__((visibility("default"))) unsigned getTrampolineSize() const;
