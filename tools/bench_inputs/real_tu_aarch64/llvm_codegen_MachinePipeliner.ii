                                    std::vector<unsigned> &PressureResult,
                                    std::vector<unsigned> &MaxPressureResult);

  void getPressureAfterInst(const MachineInstr *MI,
                            std::vector<unsigned> &PressureResult,
                            std::vector<unsigned> &MaxPressureResult) {
    if (isTopClosed())
      return getUpwardPressure(MI, PressureResult, MaxPressureResult);

    (static_cast<void> (0));
    return getDownwardPressure(MI, PressureResult, MaxPressureResult);
  }

  bool hasUntiedDef(Register VirtReg) const {
    return UntiedDefs.count(VirtReg);
  }

  __attribute__((visibility("default"))) void dump() const;

  __attribute__((visibility("default"))) void increaseRegPressure(VirtRegOrUnit VRegOrUnit,
                                    LaneBitmask PreviousMask,
                                    LaneBitmask NewMask);
  __attribute__((visibility("default"))) void decreaseRegPressure(VirtRegOrUnit VRegOrUnit,
                                    LaneBitmask PreviousMask,
                                    LaneBitmask NewMask);

protected:

  __attribute__((visibility("default"))) void discoverLiveOut(VRegMaskOrUnit Pair);

  __attribute__((visibility("default"))) void discoverLiveIn(VRegMaskOrUnit Pair);



  __attribute__((visibility("default"))) SlotIndex getCurrSlot() const;

  __attribute__((visibility("default"))) void bumpDeadDefs(ArrayRef<VRegMaskOrUnit> DeadDefs);

  __attribute__((visibility("default"))) void bumpUpwardPressure(const MachineInstr *MI);
  __attribute__((visibility("default"))) void bumpDownwardPressure(const MachineInstr *MI);

  __attribute__((visibility("default"))) void
  discoverLiveInOrOut(VRegMaskOrUnit Pair,
                      SmallVectorImpl<VRegMaskOrUnit> &LiveInOrOut);

  __attribute__((visibility("default"))) LaneBitmask getLastUsedLanes(VirtRegOrUnit VRegOrUnit,
                                        SlotIndex Pos) const;
  __attribute__((visibility("default"))) LaneBitmask getLiveLanesAt(VirtRegOrUnit VRegOrUnit,
                                      SlotIndex Pos) const;
  __attribute__((visibility("default"))) LaneBitmask getLiveThroughAt(VirtRegOrUnit VRegOrUnit,
                                        SlotIndex Pos) const;
};

__attribute__((visibility("default"))) void dumpRegSetPressure(ArrayRef<unsigned> SetPressure,
                                 const TargetRegisterInfo *TRI);

}
