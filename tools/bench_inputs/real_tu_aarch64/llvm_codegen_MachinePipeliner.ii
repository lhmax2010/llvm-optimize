    template <typename Allocator>
    [[nodiscard]] StringRef copy(Allocator &A) const {

      if (empty())
        return StringRef();
      char *S = A.template Allocate<char>(size());
      std::copy(begin(), end(), S);
      return StringRef(S, size());
    }


