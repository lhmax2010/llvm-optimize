enum SelectPatternFlavor {
  SPF_UNKNOWN = 0,
  SPF_SMIN,
  SPF_UMIN,
  SPF_SMAX,
  SPF_UMAX,
  SPF_FMINNUM,
  SPF_FMAXNUM,
  SPF_ABS,
  SPF_NABS
};



enum SelectPatternNaNBehavior {
  SPNB_NA = 0,
  SPNB_RETURNS_NAN,
  SPNB_RETURNS_OTHER,
  SPNB_RETURNS_ANY


};

struct SelectPatternResult {
  SelectPatternFlavor Flavor;
  SelectPatternNaNBehavior NaNBehavior;

  bool Ordered;




  static bool isMinOrMax(SelectPatternFlavor SPF) {
    return SPF != SPF_UNKNOWN && SPF != SPF_ABS && SPF != SPF_NABS;
  }
};
# 900 "/home/linhao/Toolchain/development/llvm-optimize/temp/gbs-root-x86_64-debuginfo-j4-v2/local/BUILD-ROOTS/scratch.x86_64.0/home/abuild/rpmbuild/BUILD/llvm-22.1.8/llvm/include/llvm/Analysis/ValueTracking.h"
__attribute__((visibility("default"))) SelectPatternResult
matchSelectPattern(Value *V, Value *&LHS, Value *&RHS,
                   Instruction::CastOps *CastOp = nullptr, unsigned Depth = 0);

inline SelectPatternResult matchSelectPattern(const Value *V, const Value *&LHS,
                                              const Value *&RHS) {
  Value *L = const_cast<Value *>(LHS);
  Value *R = const_cast<Value *>(RHS);
  auto Result = matchSelectPattern(const_cast<Value *>(V), L, R);
  LHS = L;
  RHS = R;
  return Result;
}



