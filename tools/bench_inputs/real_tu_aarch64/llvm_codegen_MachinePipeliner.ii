    return Vector[Pos->second].second;
  }



  [[nodiscard]] const ValueT &at(const KeyT &Key) const {
    auto Pos = Map.find(Key);
    (static_cast<void> (0));
    return Vector[Pos->second].second;
  }


  void pop_back() {
    typename MapType::iterator Pos = Map.find(Vector.back().first);
    Map.erase(Pos);
    Vector.pop_back();
  }
