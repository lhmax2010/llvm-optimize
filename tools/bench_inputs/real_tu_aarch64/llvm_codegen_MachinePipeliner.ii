  DS_Warning,
  DS_Remark,


  DS_Note
};



enum DiagnosticKind {
  DK_Generic,
  DK_GenericWithLoc,
  DK_InlineAsm,
  DK_RegAllocFailure,
  DK_ResourceLimit,
  DK_StackSize,
  DK_Linker,
  DK_Lowering,
  DK_LegalizationFailure,
  DK_DebugMetadataVersion,
  DK_DebugMetadataInvalid,
  DK_Instrumentation,
  DK_ISelFallback,
