  __attribute__((visibility("default"))) bool covers(const TargetRegisterClass &RC) const;


  __attribute__((visibility("default"))) bool operator==(const RegisterBank &OtherRB) const;
  bool operator!=(const RegisterBank &OtherRB) const {
    return !this->operator==(OtherRB);
  }



  __attribute__((visibility("default"))) void dump(const TargetRegisterInfo *TRI = nullptr) const;






  __attribute__((visibility("default"))) void print(raw_ostream &OS, bool IsForDebug = false,
                      const TargetRegisterInfo *TRI = nullptr) const;
};

inline raw_ostream &operator<<(raw_ostream &OS, const RegisterBank &RegBank) {
  RegBank.print(OS);
  return OS;
}
}
