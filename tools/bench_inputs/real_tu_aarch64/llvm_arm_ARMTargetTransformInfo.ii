  __attribute__((visibility("default"))) void remapFunction(Function &F);
  __attribute__((visibility("default"))) void remapGlobalObjectMetadata(GlobalObject &GO);

  __attribute__((visibility("default"))) void scheduleMapGlobalInitializer(GlobalVariable &GV, Constant &Init,
