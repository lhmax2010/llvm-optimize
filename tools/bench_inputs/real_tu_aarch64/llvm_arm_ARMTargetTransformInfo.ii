  }






  Opcode getOpcode() const { return (Opcode)getSubclassData(); }


  const MCExpr *getSubExpr() const { return Expr; }



  static bool classof(const MCExpr *E) {
    return E->getKind() == MCExpr::Unary;
  }
};


