  AttrBuilder(LLVMContext &Ctx, const Attribute &A) : Ctx(Ctx) {
    addAttribute(A);
  }

  __attribute__((visibility("default"))) AttrBuilder(LLVMContext &Ctx, AttributeSet AS);

  __attribute__((visibility("default"))) void clear();


  __attribute__((visibility("default"))) AttrBuilder &addAttribute(Attribute::AttrKind Val);


  __attribute__((visibility("default"))) AttrBuilder &addAttribute(Attribute A);


  __attribute__((visibility("default"))) AttrBuilder &addAttribute(StringRef A, StringRef V = StringRef());


  __attribute__((visibility("default"))) AttrBuilder &removeAttribute(Attribute::AttrKind Val);


  __attribute__((visibility("default"))) AttrBuilder &removeAttribute(StringRef A);


  AttrBuilder &removeAttribute(Attribute A) {
    if (A.isStringAttribute())
      return removeAttribute(A.getKindAsString());
    else
      return removeAttribute(A.getKindAsEnum());
  }



  __attribute__((visibility("default"))) AttrBuilder &merge(const AttrBuilder &B);


  __attribute__((visibility("default"))) AttrBuilder &remove(const AttributeMask &AM);



  __attribute__((visibility("default"))) bool overlaps(const AttributeMask &AM) const;


  __attribute__((visibility("default"))) bool contains(Attribute::AttrKind A) const;



  __attribute__((visibility("default"))) bool contains(StringRef A) const;


  bool hasAttributes() const { return !Attrs.empty(); }



  __attribute__((visibility("default"))) Attribute getAttribute(Attribute::AttrKind Kind) const;



  __attribute__((visibility("default"))) Attribute getAttribute(StringRef Kind) const;



  __attribute__((visibility("default"))) std::optional<ConstantRange> getRange() const;



  __attribute__((visibility("default"))) std::optional<uint64_t>
  getRawIntAttr(Attribute::AttrKind Kind) const;


  MaybeAlign getAlignment() const {
    return MaybeAlign(getRawIntAttr(Attribute::Alignment).value_or(0));
  }


  MaybeAlign getStackAlignment() const {
