      : BaselineInfoImpl(std::move(BaselineInfoImpl)) {}

  __attribute__((visibility("default"))) TargetLibraryInfo run(const Function &F, FunctionAnalysisManager &);

private:
  friend AnalysisInfoMixin<TargetLibraryAnalysis>;
  __attribute__((visibility("default"))) static AnalysisKey Key;

  std::optional<TargetLibraryInfoImpl> BaselineInfoImpl;
};

class __attribute__((visibility("default"))) TargetLibraryInfoWrapperPass : public ImmutablePass {
