  enum QueryType {
    IgnoreBundle,
    AnyInBundle,
    AllInBundle
  };






  bool hasProperty(unsigned MCFlag, QueryType Type = AnyInBundle) const {
    (static_cast<void> (0));


    if (Type == IgnoreBundle || !isBundled() || isBundledWithPred())
      return getDesc().getFlags() & (1ULL << MCFlag);


    return hasPropertyInBundle(1ULL << MCFlag, Type);
  }



