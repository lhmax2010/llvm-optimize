  TailFoldingStyle
  getPreferredTailFoldingStyle(bool IVUpdateMayOverflow = true) const override {
    return BaseT::getPreferredTailFoldingStyle(IVUpdateMayOverflow);
  }

  std::optional<Instruction *>
