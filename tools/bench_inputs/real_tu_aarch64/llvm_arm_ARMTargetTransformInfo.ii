                                                                 MDNode *DL);

  __attribute__((visibility("default"))) DbgLabelRecord *clone() const;
  __attribute__((visibility("default"))) void print(raw_ostream &O, bool IsForDebug = false) const;
  __attribute__((visibility("default"))) void print(raw_ostream &ROS, ModuleSlotTracker &MST,
                      bool IsForDebug) const;
  __attribute__((visibility("default"))) DbgLabelInst *createDebugIntrinsic(Module *M,
                                              Instruction *InsertBefore) const;

  void setLabel(DILabel *NewLabel) { Label = NewLabel; }
  DILabel *getLabel() const { return Label.get(); }
  MDNode *getRawLabel() const { return Label.getAsMDNode(); };


  static bool classof(const DbgRecord *E) {
    return E->getRecordKind() == LabelKind;
  }
};






