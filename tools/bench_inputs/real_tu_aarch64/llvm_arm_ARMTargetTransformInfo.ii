namespace LegalizeActions {
enum LegalizeAction : std::uint8_t {


  Legal,




  NarrowScalar,




  WidenScalar,







  FewerElements,





  MoreElements,


  Bitcast,



  Lower,




  Libcall,



  Custom,



  Unsupported,


  NotFound,



  UseLegacyRules,
};
}
__attribute__((visibility("default"))) raw_ostream &operator<<(raw_ostream &OS,
                                 LegalizeActions::LegalizeAction Action);

