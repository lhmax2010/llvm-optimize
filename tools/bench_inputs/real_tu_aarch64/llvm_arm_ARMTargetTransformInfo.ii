  class ThreadPoolStrategy {
  public:




    unsigned ThreadsRequested = 0;



    bool UseHyperThreads = true;



    bool Limit = false;



    __attribute__((visibility("default"))) unsigned compute_thread_count() const;





    __attribute__((visibility("default"))) void apply_thread_strategy(unsigned ThreadPoolNum) const;



    __attribute__((visibility("default"))) std::optional<unsigned>
    compute_cpu_socket(unsigned ThreadPoolNum) const;




    bool UseJobserver = false;
  };






  __attribute__((visibility("default"))) std::optional<ThreadPoolStrategy>
  get_threadpool_strategy(StringRef Num, ThreadPoolStrategy Default = {});







  inline ThreadPoolStrategy
  heavyweight_hardware_concurrency(unsigned ThreadCount = 0) {
    ThreadPoolStrategy S;
    S.UseHyperThreads = false;
    S.ThreadsRequested = ThreadCount;
    return S;
  }





  inline ThreadPoolStrategy heavyweight_hardware_concurrency(StringRef Num) {
    std::optional<ThreadPoolStrategy> S =
        get_threadpool_strategy(Num, heavyweight_hardware_concurrency());
    if (S)
      return *S;
    return heavyweight_hardware_concurrency();
  }





  inline ThreadPoolStrategy hardware_concurrency(unsigned ThreadCount = 0) {
    ThreadPoolStrategy S;
    S.ThreadsRequested = ThreadCount;
    return S;
  }





  inline ThreadPoolStrategy hardware_concurrency(StringRef Num) {
    std::optional<ThreadPoolStrategy> S =
        get_threadpool_strategy(Num, hardware_concurrency());
    if (S)
      return *S;
    return hardware_concurrency();
  }




  inline ThreadPoolStrategy optimal_concurrency(unsigned TaskCount = 0) {
    ThreadPoolStrategy S;
    S.Limit = true;
    S.ThreadsRequested = TaskCount;
    return S;
  }





  inline ThreadPoolStrategy jobserver_concurrency() {
    ThreadPoolStrategy S;
    S.UseJobserver = true;


    S.ThreadsRequested = 0;
    return S;
  }





  __attribute__((visibility("default"))) uint64_t get_threadid();



  __attribute__((visibility("default"))) uint32_t get_max_thread_name_length();







  __attribute__((visibility("default"))) void set_thread_name(const Twine &Name);







  __attribute__((visibility("default"))) void get_thread_name(SmallVectorImpl<char> &Name);




  __attribute__((visibility("default"))) llvm::BitVector get_thread_affinity_mask();


  __attribute__((visibility("default"))) unsigned get_cpus();




  __attribute__((visibility("default"))) int get_physical_cores();

  enum class ThreadPriority {



    Background = 0,





    Low = 1,


    Default = 2,
  };
  enum class SetThreadPriorityResult { FAILURE, SUCCESS };
  __attribute__((visibility("default"))) SetThreadPriorityResult set_thread_priority(ThreadPriority Priority);
}
