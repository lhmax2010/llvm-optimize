__attribute__((visibility("default"))) static const llvm::StringTable StandardNamesStrTable;
__attribute__((visibility("default"))) static const llvm::StringTable::Offset StandardNamesOffsets[531];
__attribute__((visibility("default"))) static const uint8_t StandardNamesSizeTable[531];
# 90 "/home/linhao/Toolchain/development/llvm-optimize/temp/gbs-root-x86_64-debuginfo-j4-v2/local/BUILD-ROOTS/scratch.x86_64.0/home/abuild/rpmbuild/BUILD/llvm-22.1.8/llvm/include/llvm/Analysis/TargetLibraryInfo.h" 2
 bool ShouldExtI32Param, ShouldExtI32Return, ShouldSignExtI32Param, ShouldSignExtI32Return;
  unsigned SizeOfInt;

  enum AvailabilityState {
    StandardName = 3,
    CustomName = 1,
    Unavailable = 0
  };
  void setState(LibFunc F, AvailabilityState State) {
    AvailableArray[F/4] &= ~(3 << 2*(F&3));
    AvailableArray[F/4] |= State << 2*(F&3);
  }
  AvailabilityState getState(LibFunc F) const {
    return static_cast<AvailabilityState>((AvailableArray[F/4] >> 2*(F&3)) & 3);
  }


  std::vector<VecDesc> VectorDescs;


  std::vector<VecDesc> ScalarDescs;



  __attribute__((visibility("default"))) bool isValidProtoForLibFunc(const FunctionType &FTy, LibFunc F,
                                       const Module &M) const;

public:
  TargetLibraryInfoImpl() = delete;
  __attribute__((visibility("default"))) explicit TargetLibraryInfoImpl(
      const Triple &T, VectorLibrary VecLib = VectorLibrary::NoLibrary);


  __attribute__((visibility("default"))) TargetLibraryInfoImpl(const TargetLibraryInfoImpl &TLI);
  __attribute__((visibility("default"))) TargetLibraryInfoImpl(TargetLibraryInfoImpl &&TLI);
  __attribute__((visibility("default"))) TargetLibraryInfoImpl &operator=(const TargetLibraryInfoImpl &TLI);
  __attribute__((visibility("default"))) TargetLibraryInfoImpl &operator=(TargetLibraryInfoImpl &&TLI);





  __attribute__((visibility("default"))) bool getLibFunc(StringRef funcName, LibFunc &F) const;
# 141 "/home/linhao/Toolchain/development/llvm-optimize/temp/gbs-root-x86_64-debuginfo-j4-v2/local/BUILD-ROOTS/scratch.x86_64.0/home/abuild/rpmbuild/BUILD/llvm-22.1.8/llvm/include/llvm/Analysis/TargetLibraryInfo.h"
  __attribute__((visibility("default"))) bool getLibFunc(const Function &FDecl, LibFunc &F) const;



  __attribute__((visibility("default"))) bool getLibFunc(unsigned int Opcode, Type *Ty, LibFunc &F) const;


  void setUnavailable(LibFunc F) {
    setState(F, Unavailable);
  }


  void setAvailable(LibFunc F) {
    setState(F, StandardName);
  }



  void setAvailableWithName(LibFunc F, StringRef Name) {
    if (StringRef(StandardNamesStrTable.getCString(StandardNamesOffsets[F]),
                  StandardNamesSizeTable[F]) != Name) {
      setState(F, CustomName);
      CustomNames[F] = std::string(Name);
      (static_cast<void> (0));
    } else {
      setState(F, StandardName);
    }
  }




  __attribute__((visibility("default"))) void disableAllFunctions();



  __attribute__((visibility("default"))) void addVectorizableFunctions(ArrayRef<VecDesc> Fns);



  __attribute__((visibility("default"))) void
  addVectorizableFunctionsFromVecLib(enum VectorLibrary VecLib,
