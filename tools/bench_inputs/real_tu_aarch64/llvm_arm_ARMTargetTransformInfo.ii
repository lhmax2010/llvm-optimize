  bool isAllocatable(MCRegister PhysReg) const {
    return getTargetRegisterInfo()->isInAllocatableClass(PhysReg) &&
      !isReserved(PhysReg);
  }







  void addLiveIn(MCRegister Reg, Register vreg = Register()) {
    LiveIns.push_back(std::make_pair(Reg, vreg));
  }



  using livein_iterator =
      std::vector<std::pair<MCRegister,Register>>::const_iterator;
  livein_iterator livein_begin() const { return LiveIns.begin(); }
  livein_iterator livein_end() const { return LiveIns.end(); }
  bool livein_empty() const { return LiveIns.empty(); }

  ArrayRef<std::pair<MCRegister, Register>> liveins() const {
    return LiveIns;
  }

  __attribute__((visibility("default"))) bool isLiveIn(Register Reg) const;



  __attribute__((visibility("default"))) MCRegister getLiveInPhysReg(Register VReg) const;



  __attribute__((visibility("default"))) Register getLiveInVirtReg(MCRegister PReg) const;



