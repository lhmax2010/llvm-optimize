namespace llvm {

class MachineBasicBlock;
class DataLayout;
class raw_ostream;
enum class MachineFunctionDataHotness;



struct MachineJumpTableEntry {

  std::vector<MachineBasicBlock*> MBBs;



  MachineFunctionDataHotness Hotness;

  __attribute__((visibility("default"))) explicit MachineJumpTableEntry(
      const std::vector<MachineBasicBlock *> &M);
};

class MachineJumpTableInfo {
public:


  enum JTEntryKind {


    EK_BlockAddress,




    EK_GPRel64BlockAddress,




    EK_GPRel32BlockAddress,
# 74 "/home/linhao/Toolchain/development/llvm-optimize/temp/gbs-root-x86_64-debuginfo-j4-v2/local/BUILD-ROOTS/scratch.x86_64.0/home/abuild/rpmbuild/BUILD/llvm-22.1.8/llvm/include/llvm/CodeGen/MachineJumpTableInfo.h"
    EK_LabelDifference32,





    EK_LabelDifference64,



    EK_Inline,



    EK_Custom32
  };

private:
  JTEntryKind EntryKind;
  std::vector<MachineJumpTableEntry> JumpTables;
public:
  explicit MachineJumpTableInfo(JTEntryKind Kind): EntryKind(Kind) {}

  JTEntryKind getEntryKind() const { return EntryKind; }


  __attribute__((visibility("default"))) unsigned getEntrySize(const DataLayout &TD) const;

  __attribute__((visibility("default"))) unsigned getEntryAlignment(const DataLayout &TD) const;



  __attribute__((visibility("default"))) unsigned
  createJumpTableIndex(const std::vector<MachineBasicBlock *> &DestBBs);



  bool isEmpty() const { return JumpTables.empty(); }

  const std::vector<MachineJumpTableEntry> &getJumpTables() const {
    return JumpTables;
  }



  __attribute__((visibility("default"))) bool updateJumpTableEntryHotness(size_t JTI,
                                            MachineFunctionDataHotness Hotness);



  void RemoveJumpTable(unsigned Idx) {
    JumpTables[Idx].MBBs.clear();
  }


  __attribute__((visibility("default"))) bool RemoveMBBFromJumpTables(MachineBasicBlock *MBB);



  __attribute__((visibility("default"))) bool ReplaceMBBInJumpTables(MachineBasicBlock *Old,
                                       MachineBasicBlock *New);



  __attribute__((visibility("default"))) bool ReplaceMBBInJumpTable(unsigned Idx, MachineBasicBlock *Old,
                                      MachineBasicBlock *New);




  __attribute__((visibility("default"))) void print(raw_ostream &OS) const;



  __attribute__((visibility("default"))) void dump() const;
};
