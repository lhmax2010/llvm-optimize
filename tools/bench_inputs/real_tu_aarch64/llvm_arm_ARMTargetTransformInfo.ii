template <typename NodeTy> struct ilist_callback_traits {
  void addNodeToList(NodeTy *) {}
  void removeNodeFromList(NodeTy *) {}



  template <class Iterator>
  void transferNodesFromList(ilist_callback_traits &OldList, Iterator ,
                             Iterator ) {
    (void)OldList;
  }
};





