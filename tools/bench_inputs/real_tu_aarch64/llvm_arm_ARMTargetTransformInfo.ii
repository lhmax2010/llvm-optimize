      return cast<EltTy>(Val);
    }

    (static_cast<void> (0));
    return (*cast<VecTy *>(Val))[i];
  }

  EltTy front() const {
    (static_cast<void> (0));
    if (isa<EltTy>(Val))
      return cast<EltTy>(Val);
    return cast<VecTy *>(Val)->front();
  }

  EltTy back() const {
    (static_cast<void> (0));
    if (isa<EltTy>(Val))
      return cast<EltTy>(Val);
    return cast<VecTy *>(Val)->back();
  }

  void push_back(EltTy NewVal) {

    if (Val.isNull()) {
      Val = NewVal;
      (static_cast<void> (0));
