                                      bool ZeroIsPoison = true,
                                      const Twine &Name = "") {
    return CreateIntrinsic(Intrinsic::experimental_cttz_elts,
                           {ResTy, Mask->getType()},
                           {Mask, getInt1(ZeroIsPoison)}, nullptr, Name);
  }

