    (static_cast<void> (0));
    CheckLazyArguments();
    return Arguments + i;
  }

  iterator_range<arg_iterator> args() {
    return make_range(arg_begin(), arg_end());
  }
  iterator_range<const_arg_iterator> args() const {
    return make_range(arg_begin(), arg_end());
  }



  size_t arg_size() const { return NumArgs; }
  bool arg_empty() const { return arg_size() == 0; }


