template<unsigned N>
class GISelWorkList {
  SmallVector<MachineInstr *, N> Worklist;
  DenseMap<MachineInstr *, unsigned> WorklistMap;





public:
  GISelWorkList() : WorklistMap(N) {}

  bool empty() const { return WorklistMap.empty(); }

  unsigned size() const { return WorklistMap.size(); }
# 50 "/home/linhao/Toolchain/development/llvm-optimize/temp/gbs-root-x86_64-debuginfo-j4-v2/local/BUILD-ROOTS/scratch.x86_64.0/home/abuild/rpmbuild/BUILD/llvm-22.1.8/llvm/include/llvm/CodeGen/GlobalISel/GISelWorkList.h"
  void deferred_insert(MachineInstr *I) {
    Worklist.push_back(I);



  }





  void finalize() {
    (static_cast<void> (0));
    if (Worklist.size() > N)
      WorklistMap.reserve(Worklist.size());
    for (unsigned i = 0; i < Worklist.size(); ++i)
      if (!WorklistMap.try_emplace(Worklist[i], i).second)
        __builtin_unreachable();



  }


  void insert(MachineInstr *I) {



    if (WorklistMap.try_emplace(I, Worklist.size()).second)
      Worklist.push_back(I);
  }


  void remove(const MachineInstr *I) {



    auto It = WorklistMap.find(I);
    if (It == WorklistMap.end())
      return;


    Worklist[It->second] = nullptr;

    WorklistMap.erase(It);
  }

  void clear() {
    Worklist.clear();
    WorklistMap.clear();
  }

  MachineInstr *pop_back_val() {



    MachineInstr *I;
    do {
      I = Worklist.pop_back_val();
    } while(!I);
    (static_cast<void> (0));
    WorklistMap.erase(I);
    return I;
  }
};

