class MachineMemOperand {
public:

  enum Flags : uint16_t {

    MONone = 0,

    MOLoad = 1u << 0,

    MOStore = 1u << 1,

    MOVolatile = 1u << 2,

    MONonTemporal = 1u << 3,

    MODereferenceable = 1u << 4,

    MOInvariant = 1u << 5,





    MOTargetFlag1 = 1u << 6,
    MOTargetFlag2 = 1u << 7,
    MOTargetFlag3 = 1u << 8,
    MOTargetFlag4 = 1u << 9,

    LLVM_BITMASK_LARGEST_ENUMERATOR = MOTargetFlag4
  };

private:

  struct MachineAtomicInfo {

    unsigned SSID : 8;


    unsigned Ordering : 4;


    unsigned FailureOrdering : 4;
  };

  MachinePointerInfo PtrInfo;



  LLT MemoryType;

  Flags FlagVals;
  Align BaseAlign;
  MachineAtomicInfo AtomicInfo;
  AAMDNodes AAInfo;
