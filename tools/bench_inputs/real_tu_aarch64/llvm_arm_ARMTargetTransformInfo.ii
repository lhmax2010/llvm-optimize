    }

    const StringRef &operator*() const {
      S = (*Table)[O];
      return S;
    }

    Iterator &operator++() {
      O = O.value() + (*Table)[O].size() + 1;
      return *this;
    }

    Offset offset() const { return O; }
  };

  constexpr Iterator begin() const { return Iterator(*this, 0); }
  constexpr Iterator end() const { return Iterator(*this, size() - 1); }
};

