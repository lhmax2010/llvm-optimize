namespace llvm {
class StringRef;

namespace Intrinsic {
typedef unsigned ID;
}

class Instruction;

namespace fp {






enum ExceptionBehavior : uint8_t {
  ebIgnore,
  ebMayTrap,
  ebStrict
};

}




__attribute__((visibility("default"))) std::optional<RoundingMode> convertStrToRoundingMode(StringRef);



__attribute__((visibility("default"))) std::optional<StringRef> convertRoundingModeToStr(RoundingMode);



__attribute__((visibility("default"))) std::optional<fp::ExceptionBehavior>
    convertStrToExceptionBehavior(StringRef);



__attribute__((visibility("default"))) std::optional<StringRef>
    convertExceptionBehaviorToStr(fp::ExceptionBehavior);



inline bool isDefaultFPEnvironment(fp::ExceptionBehavior EB, RoundingMode RM) {
  return EB == fp::ebIgnore && RM == RoundingMode::NearestTiesToEven;
}





__attribute__((visibility("default"))) Intrinsic::ID getConstrainedIntrinsicID(const Instruction &Instr);



inline bool canRoundingModeBe(RoundingMode RM, RoundingMode QRM) {
  return RM == QRM || RM == RoundingMode::Dynamic;
}



inline bool canIgnoreSNaN(fp::ExceptionBehavior EB, FastMathFlags FMF) {
  return (EB == fp::ebIgnore || FMF.noNaNs());
}
}
