  static nodes_iterator nodes_end(MachineFunction *F) {
    return nodes_iterator(F->end());
  }

  static unsigned size (MachineFunction *F) { return F->size(); }

  static unsigned getMaxNumber(MachineFunction *F) {
    return F->getNumBlockIDs();
