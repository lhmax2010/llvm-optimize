  SwitchInst &SI;
  std::optional<SmallVector<uint32_t, 8>> Weights;
  bool Changed = false;

protected:
  __attribute__((visibility("default"))) void init();

public:
  using CaseWeightOpt = std::optional<uint32_t>;
  SwitchInst *operator->() { return &SI; }
  SwitchInst &operator*() { return SI; }
  operator SwitchInst *() { return &SI; }

  SwitchInstProfUpdateWrapper(SwitchInst &SI) : SI(SI) { init(); }

  ~SwitchInstProfUpdateWrapper() {
    if (Changed && Weights.has_value() && Weights->size() >= 2)
      setBranchWeights(SI, Weights.value(), false);
  }



  __attribute__((visibility("default"))) SwitchInst::CaseIt removeCase(SwitchInst::CaseIt I);




  __attribute__((visibility("default"))) void replaceDefaultDest(SwitchInst::CaseIt I);



  __attribute__((visibility("default"))) void addCase(ConstantInt *OnVal, BasicBlock *Dest, CaseWeightOpt W);



  __attribute__((visibility("default"))) Instruction::InstListType::iterator eraseFromParent();

  __attribute__((visibility("default"))) void setSuccessorWeight(unsigned idx, CaseWeightOpt W);
