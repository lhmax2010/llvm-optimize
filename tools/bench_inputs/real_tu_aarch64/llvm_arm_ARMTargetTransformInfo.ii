                  std::optional<uint32_t> EnumKind, DIFlags Flags,
                  ArrayRef<Metadata *> Ops)
      : DIType(C, DICompositeTypeKind, Storage, Tag, Line, AlignInBits,
               NumExtraInhabitants, Flags, Ops),
        RuntimeLang(RuntimeLang), EnumKind(EnumKind) {}
