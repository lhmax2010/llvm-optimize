  struct DAGCombinerInfo {
    void *DC;
    CombineLevel Level;
    bool CalledByLegalizer;

  public:
    SelectionDAG &DAG;

    DAGCombinerInfo(SelectionDAG &dag, CombineLevel level, bool cl, void *dc)
      : DC(dc), Level(level), CalledByLegalizer(cl), DAG(dag) {}

    bool isBeforeLegalize() const { return Level == BeforeLegalizeTypes; }
    bool isBeforeLegalizeOps() const { return Level < AfterLegalizeVectorOps; }
    bool isAfterLegalizeDAG() const { return Level >= AfterLegalizeDAG; }
    CombineLevel getDAGCombineLevel() { return Level; }
    bool isCalledByLegalizer() const { return CalledByLegalizer; }

    __attribute__((visibility("default"))) void AddToWorklist(SDNode *N);
    __attribute__((visibility("default"))) SDValue CombineTo(SDNode *N, ArrayRef<SDValue> To,
                               bool AddTo = true);
    __attribute__((visibility("default"))) SDValue CombineTo(SDNode *N, SDValue Res, bool AddTo = true);
    __attribute__((visibility("default"))) SDValue CombineTo(SDNode *N, SDValue Res0, SDValue Res1,
                               bool AddTo = true);

    __attribute__((visibility("default"))) bool recursivelyDeleteUnusedNodes(SDNode *N);

    __attribute__((visibility("default"))) void CommitTargetLoweringOpt(const TargetLoweringOpt &TLO);
  };



