inline LLVMAttributeRef wrap(Attribute Attr) {
  return reinterpret_cast<LLVMAttributeRef>(Attr.getRawPointer());
}


inline Attribute unwrap(LLVMAttributeRef Attr) {
  return Attribute::fromRawPointer(Attr);
}







class AttributeSet {
  friend AttributeListImpl;
  template <typename Ty, typename Enable> friend struct DenseMapInfo;






  AttributeSetNode *SetNode = nullptr;

private:
  explicit AttributeSet(AttributeSetNode *ASN) : SetNode(ASN) {}

public:

  AttributeSet() = default;
  AttributeSet(const AttributeSet &) = default;
  ~AttributeSet() = default;

  __attribute__((visibility("default"))) static AttributeSet get(LLVMContext &C, const AttrBuilder &B);
  __attribute__((visibility("default"))) static AttributeSet get(LLVMContext &C, ArrayRef<Attribute> Attrs);

  bool operator==(const AttributeSet &O) const { return SetNode == O.SetNode; }
  bool operator!=(const AttributeSet &O) const { return !(*this == O); }



  [[nodiscard]] __attribute__((visibility("default"))) AttributeSet
  addAttribute(LLVMContext &C, Attribute::AttrKind Kind) const;



  [[nodiscard]] __attribute__((visibility("default"))) AttributeSet addAttribute(
      LLVMContext &C, StringRef Kind, StringRef Value = StringRef()) const;



  [[nodiscard]] __attribute__((visibility("default"))) AttributeSet addAttributes(LLVMContext &C,
                                                    AttributeSet AS) const;



  AttributeSet addAttributes(LLVMContext &C, const AttrBuilder &B) const;



  [[nodiscard]] __attribute__((visibility("default"))) AttributeSet
  removeAttribute(LLVMContext &C, Attribute::AttrKind Kind) const;



  [[nodiscard]] __attribute__((visibility("default"))) AttributeSet removeAttribute(LLVMContext &C,
                                                      StringRef Kind) const;



  [[nodiscard]] __attribute__((visibility("default"))) AttributeSet
  removeAttributes(LLVMContext &C, const AttributeMask &AttrsToRemove) const;




  [[nodiscard]] __attribute__((visibility("default"))) std::optional<AttributeSet>
  intersectWith(LLVMContext &C, AttributeSet Other) const;


  __attribute__((visibility("default"))) unsigned getNumAttributes() const;


  bool hasAttributes() const { return SetNode != nullptr; }


  __attribute__((visibility("default"))) bool hasAttribute(Attribute::AttrKind Kind) const;


  __attribute__((visibility("default"))) bool hasAttribute(StringRef Kind) const;


  __attribute__((visibility("default"))) Attribute getAttribute(Attribute::AttrKind Kind) const;


  __attribute__((visibility("default"))) Attribute getAttribute(StringRef Kind) const;

  __attribute__((visibility("default"))) MaybeAlign getAlignment() const;
  __attribute__((visibility("default"))) MaybeAlign getStackAlignment() const;
  __attribute__((visibility("default"))) uint64_t getDereferenceableBytes() const;
  __attribute__((visibility("default"))) uint64_t getDereferenceableOrNullBytes() const;
  __attribute__((visibility("default"))) Type *getByValType() const;
  __attribute__((visibility("default"))) Type *getStructRetType() const;
  __attribute__((visibility("default"))) Type *getByRefType() const;
  __attribute__((visibility("default"))) Type *getPreallocatedType() const;
  __attribute__((visibility("default"))) Type *getInAllocaType() const;
  __attribute__((visibility("default"))) Type *getElementType() const;
  __attribute__((visibility("default"))) std::optional<std::pair<unsigned, std::optional<unsigned>>>
  getAllocSizeArgs() const;
  __attribute__((visibility("default"))) unsigned getVScaleRangeMin() const;
  __attribute__((visibility("default"))) std::optional<unsigned> getVScaleRangeMax() const;
  __attribute__((visibility("default"))) UWTableKind getUWTableKind() const;
  __attribute__((visibility("default"))) AllocFnKind getAllocKind() const;
  __attribute__((visibility("default"))) MemoryEffects getMemoryEffects() const;
  __attribute__((visibility("default"))) CaptureInfo getCaptureInfo() const;
  __attribute__((visibility("default"))) FPClassTest getNoFPClass() const;
  __attribute__((visibility("default"))) std::string getAsString(bool InAttrGrp = false) const;


  __attribute__((visibility("default"))) bool hasParentContext(LLVMContext &C) const;

  using iterator = const Attribute *;

  __attribute__((visibility("default"))) iterator begin() const;
  __attribute__((visibility("default"))) iterator end() const;



};




template <> struct DenseMapInfo<AttributeSet, void> {
  static AttributeSet getEmptyKey() {
    auto Val = static_cast<uintptr_t>(-1);
    Val <<= PointerLikeTypeTraits<void *>::NumLowBitsAvailable;
    return AttributeSet(reinterpret_cast<AttributeSetNode *>(Val));
  }

  static AttributeSet getTombstoneKey() {
    auto Val = static_cast<uintptr_t>(-2);
    Val <<= PointerLikeTypeTraits<void *>::NumLowBitsAvailable;
    return AttributeSet(reinterpret_cast<AttributeSetNode *>(Val));
  }

  static unsigned getHashValue(AttributeSet AS) {
    return (unsigned((uintptr_t)AS.SetNode) >> 4) ^
           (unsigned((uintptr_t)AS.SetNode) >> 9);
  }

  static bool isEqual(AttributeSet LHS, AttributeSet RHS) { return LHS == RHS; }
};
