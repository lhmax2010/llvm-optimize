  }

  static bool canInstrumentCallsite(const CallBase &CB) {
    return !CB.isInlineAsm() &&
           (CB.isIndirectCall() ||
            (CB.getIntrinsicID() == Intrinsic::not_intrinsic));
  }
  __attribute__((visibility("default"))) Value *getCallee() const;
  __attribute__((visibility("default"))) void setCallee(Value *Callee);
};


