  getPreferredVectorAction(MVT VT) const {

    if (VT.getVectorElementCount().isScalar())
      return TypeScalarizeVector;

    if (!VT.isPow2VectorType())
      return TypeWidenVector;

    return TypePromoteInteger;
  }
