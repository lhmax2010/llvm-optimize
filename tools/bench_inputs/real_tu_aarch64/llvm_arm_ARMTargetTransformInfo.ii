    return llvm::make_range(value_begin(), value_end());
  }


  __attribute__((visibility("default"))) std::string getOperationName(const SelectionDAG *G = nullptr) const;
  __attribute__((visibility("default"))) static const char *getIndexedModeName(ISD::MemIndexedMode AM);
  __attribute__((visibility("default"))) void print_types(raw_ostream &OS, const SelectionDAG *G) const;
