  __attribute__((visibility("default"))) static void output(const StringRef &, void *, raw_ostream &);
  __attribute__((visibility("default"))) static StringRef input(StringRef, void *, StringRef &);
  static QuotingType mustQuote(StringRef S) { return needsQuotes(S); }
