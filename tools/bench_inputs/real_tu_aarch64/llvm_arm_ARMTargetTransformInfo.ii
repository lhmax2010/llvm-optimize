    : std::bool_constant<(is_hashable_data<T>::value &&
                          is_hashable_data<U>::value &&
                          (sizeof(T) + sizeof(U)) == sizeof(std::pair<T, U>))> {
};


template <typename T> auto get_hashable_data(const T &value) {
  if constexpr (is_hashable_data<T>::value) {

    return value;
