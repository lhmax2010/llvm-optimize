    CaseIteratorImpl() = default;



    CaseIteratorImpl(SwitchInstT *SI, unsigned CaseNum) : Case(SI, CaseNum) {}



    static CaseIteratorImpl fromSuccessorIndex(SwitchInstT *SI,
