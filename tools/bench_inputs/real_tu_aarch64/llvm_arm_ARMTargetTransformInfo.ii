  SmallVector<BasicBlock*, 4> ExitingBlocks;
  L->getExitingBlocks(ExitingBlocks);
  do { } while (false);





  if (ExitingBlocks.size() > 2)
    return;



  if (ST->hasBranchPredictor() && L->getNumBlocks() > 4)
