      return std::make_reverse_iterator(end());
    }

    reverse_iterator rend() const {
      return std::make_reverse_iterator(begin());
    }

    const unsigned char *bytes_begin() const {
      return reinterpret_cast<const unsigned char *>(begin());
    }
