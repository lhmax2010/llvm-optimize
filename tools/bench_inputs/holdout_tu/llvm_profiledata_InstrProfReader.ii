      : InstrProfCorrelatorImpl<IntPtrT>(std::move(Ctx)),
        DICtx(std::move(DICtx)) {}

private:
  std::unique_ptr<DWARFContext> DICtx;


  std::optional<uint64_t> getLocation(const DWARFDie &Die) const;



  static bool isDIEOfProbe(const DWARFDie &Die);
