class Stream {
public:

  __attribute__((visibility("default"))) Stream(StringRef Input, SourceMgr &, bool ShowColors = true,
                  std::error_code *EC = nullptr);

  __attribute__((visibility("default"))) Stream(MemoryBufferRef InputBuffer, SourceMgr &,
                  bool ShowColors = true, std::error_code *EC = nullptr);
  __attribute__((visibility("default"))) ~Stream();

  __attribute__((visibility("default"))) document_iterator begin();
  __attribute__((visibility("default"))) document_iterator end();
  __attribute__((visibility("default"))) void skip();
  __attribute__((visibility("default"))) bool failed();

  bool validate() {
    skip();
    return !failed();
  }

