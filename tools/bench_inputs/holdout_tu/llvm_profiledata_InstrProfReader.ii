  __attribute__((visibility("default"))) static void output(const std::string &, void *, raw_ostream &);
  __attribute__((visibility("default"))) static StringRef input(StringRef, void *, std::string &);
  static QuotingType mustQuote(StringRef S) { return needsQuotes(S); }
};

