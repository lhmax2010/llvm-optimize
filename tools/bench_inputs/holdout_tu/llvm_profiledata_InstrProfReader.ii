void InstrProfValueSiteRecord::sortByCount() {
  llvm::stable_sort(
      ValueData, [](const InstrProfValueData &L, const InstrProfValueData &R) {
        return L.Count > R.Count;
      });

  size_t max_s = 255;
  if (ValueData.size() > max_s)
    ValueData.resize(max_s);
}

