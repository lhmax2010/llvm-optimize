    __attribute__((visibility("default"))) void resizeSmallToLarge(size_t NumOps);
    __attribute__((visibility("default"))) void resize(size_t NumOps);

    __attribute__((visibility("default"))) explicit Header(size_t NumOps, StorageType Storage);
    __attribute__((visibility("default"))) ~Header();

    MutableArrayRef<MDOperand> operands() {
      if (IsLarge)
        return getLarge();
      return MutableArrayRef(
          reinterpret_cast<MDOperand *>(this) - SmallSize, SmallNumOps);
    }

    ArrayRef<MDOperand> operands() const {
      if (IsLarge)
        return getLarge();
      return ArrayRef(reinterpret_cast<const MDOperand *>(this) - SmallSize,
                      SmallNumOps);
    }

    unsigned getNumOperands() const {
      if (!IsLarge)
