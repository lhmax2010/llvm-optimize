template <typename U> struct StaticCastFunc {
  template <typename T> decltype(auto) operator()(T &&Val) const {
    return static_cast<U>(Val);
  }
};

template <typename U> struct DynCastFunc {
  template <typename T> decltype(auto) operator()(T &&Val) const {
    return dyn_cast<U>(Val);
  }
};

