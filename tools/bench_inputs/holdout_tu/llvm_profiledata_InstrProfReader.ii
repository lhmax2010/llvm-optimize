class DbgRecord : public ilist_node<DbgRecord> {
public:

  DbgMarker *Marker = nullptr;

  enum Kind : uint8_t { ValueKind, LabelKind };

protected:
  DebugLoc DbgLoc;
  Kind RecordKind;

public:
  DbgRecord(Kind RecordKind, DebugLoc DL)
      : DbgLoc(DL), RecordKind(RecordKind) {}




  __attribute__((visibility("default"))) void deleteRecord();
  __attribute__((visibility("default"))) DbgRecord *clone() const;
  __attribute__((visibility("default"))) void print(raw_ostream &O, bool IsForDebug = false) const;
  __attribute__((visibility("default"))) void print(raw_ostream &O, ModuleSlotTracker &MST,
                      bool IsForDebug) const;
  __attribute__((visibility("default"))) bool isIdenticalToWhenDefined(const DbgRecord &R) const;



  __attribute__((visibility("default"))) DbgInfoIntrinsic *
  createDebugIntrinsic(Module *M, Instruction *InsertBefore) const;



  __attribute__((visibility("default"))) bool isEquivalentTo(const DbgRecord &R) const;

  Kind getRecordKind() const { return RecordKind; }

  void setMarker(DbgMarker *M) { Marker = M; }

  DbgMarker *getMarker() { return Marker; }
  const DbgMarker *getMarker() const { return Marker; }

  __attribute__((visibility("default"))) BasicBlock *getBlock();
  __attribute__((visibility("default"))) const BasicBlock *getBlock() const;

  __attribute__((visibility("default"))) Function *getFunction();
  __attribute__((visibility("default"))) const Function *getFunction() const;

  __attribute__((visibility("default"))) Module *getModule();
  __attribute__((visibility("default"))) const Module *getModule() const;

  __attribute__((visibility("default"))) LLVMContext &getContext();
  __attribute__((visibility("default"))) const LLVMContext &getContext() const;

  __attribute__((visibility("default"))) const Instruction *getInstruction() const;
  __attribute__((visibility("default"))) const BasicBlock *getParent() const;
  __attribute__((visibility("default"))) BasicBlock *getParent();

  __attribute__((visibility("default"))) void removeFromParent();
  __attribute__((visibility("default"))) void eraseFromParent();

  DbgRecord *getNextNode() { return &*std::next(getIterator()); }
  DbgRecord *getPrevNode() { return &*std::prev(getIterator()); }



  __attribute__((visibility("default"))) void insertBefore(DbgRecord *InsertBefore);
  __attribute__((visibility("default"))) void insertAfter(DbgRecord *InsertAfter);
  __attribute__((visibility("default"))) void moveBefore(DbgRecord *MoveBefore);
  __attribute__((visibility("default"))) void moveAfter(DbgRecord *MoveAfter);

  __attribute__((visibility("default"))) void insertBefore(self_iterator InsertBefore);
  __attribute__((visibility("default"))) void insertAfter(self_iterator InsertAfter);
  __attribute__((visibility("default"))) void moveBefore(self_iterator MoveBefore);
  __attribute__((visibility("default"))) void moveAfter(self_iterator MoveAfter);

  DebugLoc getDebugLoc() const { return DbgLoc; }
  void setDebugLoc(DebugLoc Loc) { DbgLoc = std::move(Loc); }

  __attribute__((visibility("default"))) void dump() const;

  using self_iterator = simple_ilist<DbgRecord>::iterator;
  using const_self_iterator = simple_ilist<DbgRecord>::const_iterator;

protected:




  ~DbgRecord() = default;
};

inline raw_ostream &operator<<(raw_ostream &OS, const DbgRecord &R) {
  R.print(OS);
  return OS;
}



