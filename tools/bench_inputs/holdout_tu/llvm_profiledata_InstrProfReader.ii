namespace llvm {

class Comdat;
class Metadata;

class GlobalObject : public GlobalValue {
public:



  enum VCallVisibility {

    VCallVisibilityPublic = 0,


    VCallVisibilityLinkageUnit = 1,

    VCallVisibilityTranslationUnit = 2,
  };

protected:
  GlobalObject(Type *Ty, ValueTy VTy, AllocInfo AllocInfo, LinkageTypes Linkage,
               const Twine &Name, unsigned AddressSpace = 0)
      : GlobalValue(Ty, VTy, AllocInfo, Linkage, Name, AddressSpace) {
    setGlobalValueSubClassData(0);
  }
  __attribute__((visibility("default"))) ~GlobalObject();

  Comdat *ObjComdat = nullptr;
  enum {
    LastAlignmentBit = 5,
    LastCodeModelBit = 8,
    HasSectionHashEntryBit,

    GlobalObjectBits,
  };
  static const unsigned GlobalObjectSubClassDataBits =
      GlobalValueSubClassDataBits - GlobalObjectBits;

private:
  static const unsigned AlignmentBits = LastAlignmentBit + 1;
  static const unsigned AlignmentMask = (1 << AlignmentBits) - 1;
  static const unsigned GlobalObjectMask = (1 << GlobalObjectBits) - 1;

public:
  GlobalObject(const GlobalObject &) = delete;

protected:




  MaybeAlign getAlign() const {
    unsigned Data = getGlobalValueSubClassData();
    unsigned AlignmentData = Data & AlignmentMask;
    return decodeMaybeAlign(AlignmentData);
  }


  __attribute__((visibility("default"))) void setAlignment(Align Align);




  __attribute__((visibility("default"))) void setAlignment(MaybeAlign Align);

  unsigned getGlobalObjectSubClassData() const {
    unsigned ValueData = getGlobalValueSubClassData();
    return ValueData >> GlobalObjectBits;
  }

  void setGlobalObjectSubClassData(unsigned Val) {
    unsigned OldData = getGlobalValueSubClassData();
    setGlobalValueSubClassData((OldData & GlobalObjectMask) |
                               (Val << GlobalObjectBits));
    (static_cast<void> (0));
  }

public:




  bool hasSection() const {
    return getGlobalValueSubClassData() & (1 << HasSectionHashEntryBit);
  }





  StringRef getSection() const {
    return hasSection() ? getSectionImpl() : StringRef();
  }





  __attribute__((visibility("default"))) void setSection(StringRef S);




  __attribute__((visibility("default"))) bool setSectionPrefix(StringRef Prefix);


  __attribute__((visibility("default"))) std::optional<StringRef> getSectionPrefix() const;

  bool hasComdat() const { return getComdat() != nullptr; }
  const Comdat *getComdat() const { return ObjComdat; }
  Comdat *getComdat() { return ObjComdat; }
  __attribute__((visibility("default"))) void setComdat(Comdat *C);

  using Value::addMetadata;
  using Value::clearMetadata;
  using Value::eraseMetadata;
  using Value::eraseMetadataIf;
  using Value::getAllMetadata;
  using Value::getMetadata;
  using Value::hasMetadata;
  using Value::setMetadata;


  __attribute__((visibility("default"))) void copyMetadata(const GlobalObject *Src, unsigned Offset);

  __attribute__((visibility("default"))) void addTypeMetadata(unsigned Offset, Metadata *TypeID);
  __attribute__((visibility("default"))) void setVCallVisibilityMetadata(VCallVisibility Visibility);
  __attribute__((visibility("default"))) VCallVisibility getVCallVisibility() const;






  __attribute__((visibility("default"))) bool canIncreaseAlignment() const;

protected:
  __attribute__((visibility("default"))) void copyAttributesFrom(const GlobalObject *Src);

public:

  static bool classof(const Value *V) {
    return V->getValueID() == Value::FunctionVal ||
           V->getValueID() == Value::GlobalVariableVal ||
           V->getValueID() == Value::GlobalIFuncVal;
  }

private:
  void setGlobalObjectFlag(unsigned Bit, bool Val) {
    unsigned Mask = 1 << Bit;
    setGlobalValueSubClassData((~Mask & getGlobalValueSubClassData()) |
                               (Val ? Mask : 0u));
  }

  __attribute__((visibility("default"))) StringRef getSectionImpl() const;
};

