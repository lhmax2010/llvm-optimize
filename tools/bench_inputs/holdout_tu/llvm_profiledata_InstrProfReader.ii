namespace llvm {

class DWARFContext;
class DWARFObject;
class DWARFDataExtractor;
class DWARFUnit;
class raw_ostream;

class DWARFFormValue {
public:
  enum FormClass {
    FC_Unknown,
    FC_Address,
    FC_Block,
    FC_Constant,
    FC_String,
    FC_Flag,
    FC_Reference,
    FC_Indirect,
    FC_SectionOffset,
    FC_Exprloc
  };

  struct ValueType {
    ValueType() { uval = 0; }
    ValueType(int64_t V) : sval(V) {}
    ValueType(uint64_t V) : uval(V) {}
    ValueType(const char *V) : cstr(V) {}

    union {
      uint64_t uval;
      int64_t sval;
      const char *cstr;
    };
    const uint8_t *data = nullptr;
    uint64_t SectionIndex;
  };

private:
  dwarf::Form Form;
  dwarf::DwarfFormat Format =
      dwarf::DWARF32;
  ValueType Value;
  const DWARFUnit *U = nullptr;
  const DWARFContext *C = nullptr;

  DWARFFormValue(dwarf::Form F, const ValueType &V) : Form(F), Value(V) {}

public:
  DWARFFormValue(dwarf::Form F = dwarf::Form(0)) : Form(F) {}

  __attribute__((visibility("default"))) static DWARFFormValue createFromSValue(dwarf::Form F, int64_t V);
  __attribute__((visibility("default"))) static DWARFFormValue createFromUValue(dwarf::Form F, uint64_t V);
  __attribute__((visibility("default"))) static DWARFFormValue createFromPValue(dwarf::Form F, const char *V);
  __attribute__((visibility("default"))) static DWARFFormValue createFromBlockValue(dwarf::Form F,
                                                      ArrayRef<uint8_t> D);
  __attribute__((visibility("default"))) static DWARFFormValue
  createFromUnit(dwarf::Form F, const DWARFUnit *Unit, uint64_t *OffsetPtr);
  __attribute__((visibility("default"))) static std::optional<object::SectionedAddress>
  getAsSectionedAddress(const ValueType &Val, const dwarf::Form Form,
                        const DWARFUnit *U);

  dwarf::Form getForm() const { return Form; }
  uint64_t getRawUValue() const { return Value.uval; }

  __attribute__((visibility("default"))) bool isFormClass(FormClass FC) const;
  const DWARFUnit *getUnit() const { return U; }
  __attribute__((visibility("default"))) void dump(raw_ostream &OS,
                     DIDumpOptions DumpOpts = DIDumpOptions()) const;
  __attribute__((visibility("default"))) void dumpSectionedAddress(raw_ostream &OS, DIDumpOptions DumpOpts,
                                     object::SectionedAddress SA) const;
  __attribute__((visibility("default"))) void dumpAddress(raw_ostream &OS, uint64_t Address) const;
  __attribute__((visibility("default"))) static void dumpAddress(raw_ostream &OS, uint8_t AddressSize,
                                   uint64_t Address);
  __attribute__((visibility("default"))) static void dumpAddressSection(const DWARFObject &Obj,
                                          raw_ostream &OS,
                                          DIDumpOptions DumpOpts,
                                          uint64_t SectionIndex);





  __attribute__((visibility("default"))) bool extractValue(const DWARFDataExtractor &Data,
                             uint64_t *OffsetPtr, dwarf::FormParams FormParams,
                             const DWARFContext *Context = nullptr,
                             const DWARFUnit *Unit = nullptr);

  bool extractValue(const DWARFDataExtractor &Data, uint64_t *OffsetPtr,
                    dwarf::FormParams FormParams, const DWARFUnit *U) {
    return extractValue(Data, OffsetPtr, FormParams, nullptr, U);
  }



  __attribute__((visibility("default"))) std::optional<uint64_t> getAsRelativeReference() const;
  __attribute__((visibility("default"))) std::optional<uint64_t> getAsDebugInfoReference() const;
  __attribute__((visibility("default"))) std::optional<uint64_t> getAsSignatureReference() const;
  __attribute__((visibility("default"))) std::optional<uint64_t> getAsSupplementaryReference() const;
