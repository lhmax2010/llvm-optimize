namespace llvm {

class Error;
class StringRef;

namespace cl {
class OptionCategory;
}

__attribute__((visibility("default"))) extern cl::OptionCategory &getColorCategory();


enum class HighlightColor {
  Address,
  String,
  Tag,
  Attribute,
  Enumerator,
  Macro,
  Error,
  Warning,
  Note,
  Remark
};

enum class ColorMode {


  Auto,



  Enable,

  Disable,
};



class WithColor {
public:
  using AutoDetectFunctionType = bool (*)(const raw_ostream &OS);





  [[nodiscard]] __attribute__((visibility("default"))) WithColor(raw_ostream &OS, HighlightColor S,
                                         ColorMode Mode = ColorMode::Auto);







  [[nodiscard]] WithColor(
      raw_ostream &OS, raw_ostream::Colors Color = raw_ostream::SAVEDCOLOR,
      bool Bold = false, bool BG = false, ColorMode Mode = ColorMode::Auto)
      : OS(OS), Mode(Mode) {
    changeColor(Color, Bold, BG);
  }
  __attribute__((visibility("default"))) ~WithColor();

  raw_ostream &get() { return OS; }
  operator raw_ostream &() { return OS; }
  template <typename T> WithColor &operator<<(T &O) {
    OS << O;
    return *this;
  }
  template <typename T> WithColor &operator<<(const T &O) {
    OS << O;
    return *this;
  }


  __attribute__((visibility("default"))) static raw_ostream &error();

  __attribute__((visibility("default"))) static raw_ostream &warning();

  __attribute__((visibility("default"))) static raw_ostream &note();

  __attribute__((visibility("default"))) static raw_ostream &remark();


  __attribute__((visibility("default"))) static raw_ostream &error(raw_ostream &OS, StringRef Prefix = "",
                                     bool DisableColors = false);

  __attribute__((visibility("default"))) static raw_ostream &warning(raw_ostream &OS, StringRef Prefix = "",
                                       bool DisableColors = false);

  __attribute__((visibility("default"))) static raw_ostream &note(raw_ostream &OS, StringRef Prefix = "",
                                    bool DisableColors = false);

  __attribute__((visibility("default"))) static raw_ostream &remark(raw_ostream &OS, StringRef Prefix = "",
                                      bool DisableColors = false);


  __attribute__((visibility("default"))) bool colorsEnabled();






  __attribute__((visibility("default"))) WithColor &changeColor(raw_ostream::Colors Color, bool Bold = false,
                                  bool BG = false);



  __attribute__((visibility("default"))) WithColor &resetColor();



  __attribute__((visibility("default"))) static void defaultErrorHandler(Error Err);



  __attribute__((visibility("default"))) static void defaultWarningHandler(Error Warning);


  __attribute__((visibility("default"))) static AutoDetectFunctionType defaultAutoDetectFunction();


  __attribute__((visibility("default"))) static void
  setAutoDetectFunction(AutoDetectFunctionType NewAutoDetectFunction);

private:
  raw_ostream &OS;
  ColorMode Mode;

  static AutoDetectFunctionType AutoDetectFunction;
};

}
