  bool isAndroidVersionLT(unsigned Major) const {
    (static_cast<void> (0));

    VersionTuple Version = getEnvironmentVersion();


    if (isArch64Bit() && Version.getMajor() < 21)
      return VersionTuple(21) < VersionTuple(Major);

    return Version < VersionTuple(Major);
  }


