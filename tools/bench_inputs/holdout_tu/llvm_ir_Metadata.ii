  bool isX86_FP80Ty() const { return getTypeID() == X86_FP80TyID; }


  bool isFP128Ty() const { return getTypeID() == FP128TyID; }


  bool isPPC_FP128Ty() const { return getTypeID() == PPC_FP128TyID; }




