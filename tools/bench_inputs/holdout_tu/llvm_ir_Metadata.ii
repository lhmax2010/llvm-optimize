          Metadata *StringLength, Metadata *StrLenExp, Metadata *StrLocationExp,
          Metadata *SizeInBits, uint32_t AlignInBits, unsigned Encoding,
          StorageType Storage, bool ShouldCreate = true);

  TempDIStringType cloneImpl() const {
