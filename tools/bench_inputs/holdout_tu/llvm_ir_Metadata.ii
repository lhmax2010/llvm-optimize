  __attribute__((visibility("default"))) iterator begin() const;
  __attribute__((visibility("default"))) iterator end() const;

  __attribute__((visibility("default"))) unsigned getNumAttrSets() const;




  struct index_iterator {
    unsigned NumAttrSets;
    index_iterator(int NumAttrSets) : NumAttrSets(NumAttrSets) {}
    struct int_wrapper {
      int_wrapper(unsigned i) : i(i) {}
      unsigned i;
      unsigned operator*() { return i; }
      bool operator!=(const int_wrapper &Other) { return i != Other.i; }
      int_wrapper &operator++() {


        ++i;
        return *this;
      }
    };

    int_wrapper begin() { return int_wrapper(AttributeList::FunctionIndex); }

    int_wrapper end() { return int_wrapper(NumAttrSets - 1); }
  };


  index_iterator indexes() const { return index_iterator(getNumAttrSets()); }


  bool operator==(const AttributeList &RHS) const { return pImpl == RHS.pImpl; }
  bool operator!=(const AttributeList &RHS) const { return pImpl != RHS.pImpl; }


  void *getRawPointer() const {
    return pImpl;
  }


  bool isEmpty() const { return pImpl == nullptr; }

  __attribute__((visibility("default"))) void print(raw_ostream &O) const;

  __attribute__((visibility("default"))) void dump() const;
};




template <> struct DenseMapInfo<AttributeList, void> {
  static AttributeList getEmptyKey() {
    auto Val = static_cast<uintptr_t>(-1);
    Val <<= PointerLikeTypeTraits<void*>::NumLowBitsAvailable;
    return AttributeList(reinterpret_cast<AttributeListImpl *>(Val));
  }

  static AttributeList getTombstoneKey() {
    auto Val = static_cast<uintptr_t>(-2);
    Val <<= PointerLikeTypeTraits<void*>::NumLowBitsAvailable;
    return AttributeList(reinterpret_cast<AttributeListImpl *>(Val));
  }

  static unsigned getHashValue(AttributeList AS) {
    return (unsigned((uintptr_t)AS.pImpl) >> 4) ^
           (unsigned((uintptr_t)AS.pImpl) >> 9);
  }

  static bool isEqual(AttributeList LHS, AttributeList RHS) {
    return LHS == RHS;
  }
};







class AttrBuilder {
  LLVMContext &Ctx;
  SmallVector<Attribute, 8> Attrs;

public:
  AttrBuilder(LLVMContext &Ctx) : Ctx(Ctx) {}
  AttrBuilder(const AttrBuilder &) = delete;
  AttrBuilder(AttrBuilder &&) = default;

  AttrBuilder(LLVMContext &Ctx, const Attribute &A) : Ctx(Ctx) {
    addAttribute(A);
  }

  __attribute__((visibility("default"))) AttrBuilder(LLVMContext &Ctx, AttributeSet AS);

  __attribute__((visibility("default"))) void clear();


  __attribute__((visibility("default"))) AttrBuilder &addAttribute(Attribute::AttrKind Val);


  __attribute__((visibility("default"))) AttrBuilder &addAttribute(Attribute A);


  __attribute__((visibility("default"))) AttrBuilder &addAttribute(StringRef A, StringRef V = StringRef());


  __attribute__((visibility("default"))) AttrBuilder &removeAttribute(Attribute::AttrKind Val);


  __attribute__((visibility("default"))) AttrBuilder &removeAttribute(StringRef A);


  AttrBuilder &removeAttribute(Attribute A) {
    if (A.isStringAttribute())
      return removeAttribute(A.getKindAsString());
    else
      return removeAttribute(A.getKindAsEnum());
  }



  __attribute__((visibility("default"))) AttrBuilder &merge(const AttrBuilder &B);


  __attribute__((visibility("default"))) AttrBuilder &remove(const AttributeMask &AM);



  __attribute__((visibility("default"))) bool overlaps(const AttributeMask &AM) const;


  __attribute__((visibility("default"))) bool contains(Attribute::AttrKind A) const;



  __attribute__((visibility("default"))) bool contains(StringRef A) const;


  bool hasAttributes() const { return !Attrs.empty(); }



  __attribute__((visibility("default"))) Attribute getAttribute(Attribute::AttrKind Kind) const;



  __attribute__((visibility("default"))) Attribute getAttribute(StringRef Kind) const;



  __attribute__((visibility("default"))) std::optional<ConstantRange> getRange() const;



  __attribute__((visibility("default"))) std::optional<uint64_t>
  getRawIntAttr(Attribute::AttrKind Kind) const;


  MaybeAlign getAlignment() const {
    return MaybeAlign(getRawIntAttr(Attribute::Alignment).value_or(0));
  }


  MaybeAlign getStackAlignment() const {
    return MaybeAlign(getRawIntAttr(Attribute::StackAlignment).value_or(0));
  }



  uint64_t getDereferenceableBytes() const {
    return getRawIntAttr(Attribute::Dereferenceable).value_or(0);
  }



  uint64_t getDereferenceableOrNullBytes() const {
    return getRawIntAttr(Attribute::DereferenceableOrNull).value_or(0);
  }



  FPClassTest getNoFPClass() const {
    std::optional<uint64_t> Raw = getRawIntAttr(Attribute::NoFPClass);
    return static_cast<FPClassTest>(Raw.value_or(0));
  }


  __attribute__((visibility("default"))) Type *getTypeAttr(Attribute::AttrKind Kind) const;


  Type *getByValType() const { return getTypeAttr(Attribute::ByVal); }


  Type *getStructRetType() const { return getTypeAttr(Attribute::StructRet); }


  Type *getByRefType() const { return getTypeAttr(Attribute::ByRef); }


  Type *getPreallocatedType() const {
    return getTypeAttr(Attribute::Preallocated);
  }


  Type *getInAllocaType() const { return getTypeAttr(Attribute::InAlloca); }



  __attribute__((visibility("default"))) std::optional<std::pair<unsigned, std::optional<unsigned>>>
  getAllocSizeArgs() const;


  __attribute__((visibility("default"))) AttrBuilder &addRawIntAttr(Attribute::AttrKind Kind, uint64_t Value);



  __attribute__((visibility("default"))) AttrBuilder &addAlignmentAttr(MaybeAlign Align);





  inline AttrBuilder &addAlignmentAttr(unsigned Align) {
    return addAlignmentAttr(MaybeAlign(Align));
  }



  __attribute__((visibility("default"))) AttrBuilder &addStackAlignmentAttr(MaybeAlign Align);





  inline AttrBuilder &addStackAlignmentAttr(unsigned Align) {
    return addStackAlignmentAttr(MaybeAlign(Align));
  }



  __attribute__((visibility("default"))) AttrBuilder &addDereferenceableAttr(uint64_t Bytes);



  __attribute__((visibility("default"))) AttrBuilder &addDereferenceableOrNullAttr(uint64_t Bytes);


  __attribute__((visibility("default"))) AttrBuilder &
  addAllocSizeAttr(unsigned ElemSizeArg,
                   const std::optional<unsigned> &NumElemsArg);


  __attribute__((visibility("default"))) AttrBuilder &addVScaleRangeAttr(unsigned MinValue,
                                           std::optional<unsigned> MaxValue);


  __attribute__((visibility("default"))) AttrBuilder &addTypeAttr(Attribute::AttrKind Kind, Type *Ty);


  __attribute__((visibility("default"))) AttrBuilder &addByValAttr(Type *Ty);


  __attribute__((visibility("default"))) AttrBuilder &addStructRetAttr(Type *Ty);


  __attribute__((visibility("default"))) AttrBuilder &addByRefAttr(Type *Ty);


  __attribute__((visibility("default"))) AttrBuilder &addPreallocatedAttr(Type *Ty);


  __attribute__((visibility("default"))) AttrBuilder &addInAllocaAttr(Type *Ty);



  __attribute__((visibility("default"))) AttrBuilder &addAllocSizeAttrFromRawRepr(uint64_t RawAllocSizeRepr);



  __attribute__((visibility("default"))) AttrBuilder &
  addVScaleRangeAttrFromRawRepr(uint64_t RawVScaleRangeRepr);



  __attribute__((visibility("default"))) AttrBuilder &addUWTableAttr(UWTableKind Kind);


  __attribute__((visibility("default"))) AttrBuilder &addAllocKindAttr(AllocFnKind Kind);


  __attribute__((visibility("default"))) AttrBuilder &addMemoryAttr(MemoryEffects ME);


  __attribute__((visibility("default"))) AttrBuilder &addCapturesAttr(CaptureInfo CI);


  __attribute__((visibility("default"))) AttrBuilder &addNoFPClassAttr(FPClassTest NoFPClassMask);


  __attribute__((visibility("default"))) AttrBuilder &addConstantRangeAttr(Attribute::AttrKind Kind,
                                             const ConstantRange &CR);


  __attribute__((visibility("default"))) AttrBuilder &addRangeAttr(const ConstantRange &CR);


  __attribute__((visibility("default"))) AttrBuilder &addConstantRangeListAttr(Attribute::AttrKind Kind,
                                                 ArrayRef<ConstantRange> Val);


  __attribute__((visibility("default"))) AttrBuilder &addInitializesAttr(const ConstantRangeList &CRL);




  __attribute__((visibility("default"))) AttrBuilder &addFromEquivalentMetadata(const Instruction &I);

  ArrayRef<Attribute> attrs() const { return Attrs; }

  __attribute__((visibility("default"))) bool operator==(const AttrBuilder &B) const;
  bool operator!=(const AttrBuilder &B) const { return !(*this == B); }
};

