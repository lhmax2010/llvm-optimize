  APInt &clearUnusedBits() {

    unsigned WordBits = ((BitWidth - 1) % APINT_BITS_PER_WORD) + 1;


    uint64_t mask = WORDTYPE_MAX >> (APINT_BITS_PER_WORD - WordBits);
    if (__builtin_expect((bool)(BitWidth == 0), false))
      mask = 0;

    if (isSingleWord())
      U.VAL &= mask;
    else
      U.pVal[getNumWords() - 1] &= mask;
    return *this;
