  void splice(Function::iterator ToIt, Function *FromF,
              Function::iterator FromIt) {
    auto FromItNext = std::next(FromIt);

    if (ToIt == FromIt || ToIt == FromItNext)
      return;
    splice(ToIt, FromF, FromIt, FromItNext);
  }



