  AtomicOrdering getOrdering() const {
    return getSubclassData<AtomicOrderingField>();
  }


  void setOrdering(AtomicOrdering Ordering) {
    (static_cast<void> (0));

    (static_cast<void> (0));

    setSubclassData<AtomicOrderingField>(Ordering);
  }


