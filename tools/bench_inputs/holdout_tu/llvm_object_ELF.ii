    detail::packed_endian_specific_integral<int32_t, llvm::endianness::big,
                                            aligned>;
using aligned_big64_t =
    detail::packed_endian_specific_integral<int64_t, llvm::endianness::big,
                                            aligned>;

using unaligned_uint16_t =
