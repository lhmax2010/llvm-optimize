  BranchProbability &operator/=(BranchProbability RHS) {
    (static_cast<void> (0));

    N = (static_cast<uint64_t>(N) * D + RHS.N / 2) / RHS.N;
    return *this;
  }

  BranchProbability &operator/=(uint32_t RHS) {
    (static_cast<void> (0));

    (static_cast<void> (0));
