template <class ELFT> struct Elf_Dyn_Base;

template <endianness Endianness>
struct Elf_Dyn_Base<ELFType<Endianness, false>> {
  using Elf_Addr = typename ELFType<Endianness , false>::Addr; using Elf_Off = typename ELFType<Endianness , false>::Off; using Elf_Half = typename ELFType<Endianness , false>::Half; using Elf_Word = typename ELFType<Endianness , false>::Word; using Elf_Sword = typename ELFType<Endianness , false>::Sword; using Elf_Xword = typename ELFType<Endianness , false>::Xword; using Elf_Sxword = typename ELFType<Endianness , false>::Sxword; using uintX_t = typename ELFType<Endianness , false>::uint; using Elf_Ehdr = typename ELFType<Endianness , false>::Ehdr; using Elf_Shdr = typename ELFType<Endianness , false>::Shdr; using Elf_Sym = typename ELFType<Endianness , false>::Sym; using Elf_Dyn = typename ELFType<Endianness , false>::Dyn; using Elf_Phdr = typename ELFType<Endianness , false>::Phdr; using Elf_Rel = typename ELFType<Endianness , false>::Rel; using Elf_Rela = typename ELFType<Endianness , false>::Rela; using Elf_Crel = typename ELFType<Endianness , false>::Crel; using Elf_Relr = typename ELFType<Endianness , false>::Relr; using Elf_Verdef = typename ELFType<Endianness , false>::Verdef; using Elf_Verdaux = typename ELFType<Endianness , false>::Verdaux; using Elf_Verneed = typename ELFType<Endianness , false>::Verneed; using Elf_Vernaux = typename ELFType<Endianness , false>::Vernaux; using Elf_Versym = typename ELFType<Endianness , false>::Versym; using Elf_Hash = typename ELFType<Endianness , false>::Hash; using Elf_GnuHash = typename ELFType<Endianness , false>::GnuHash; using Elf_Chdr = typename ELFType<Endianness , false>::Chdr; using Elf_Nhdr = typename ELFType<Endianness , false>::Nhdr; using Elf_Note = typename ELFType<Endianness , false>::Note; using Elf_Note_Iterator = typename ELFType<Endianness , false>::NoteIterator; using Elf_CGProfile = typename ELFType<Endianness , false>::CGProfile; using Elf_Dyn_Range = typename ELFType<Endianness , false>::DynRange; using Elf_Shdr_Range = typename ELFType<Endianness , false>::ShdrRange; using Elf_Sym_Range = typename ELFType<Endianness , false>::SymRange; using Elf_Rel_Range = typename ELFType<Endianness , false>::RelRange; using Elf_Rela_Range = typename ELFType<Endianness , false>::RelaRange; using Elf_Relr_Range = typename ELFType<Endianness , false>::RelrRange; using Elf_Phdr_Range = typename ELFType<Endianness , false>::PhdrRange;
  Elf_Sword d_tag;
  union {
    Elf_Word d_val;
    Elf_Addr d_ptr;
  } d_un;
};

template <endianness Endianness>
struct Elf_Dyn_Base<ELFType<Endianness, true>> {
  using Elf_Addr = typename ELFType<Endianness , true>::Addr; using Elf_Off = typename ELFType<Endianness , true>::Off; using Elf_Half = typename ELFType<Endianness , true>::Half; using Elf_Word = typename ELFType<Endianness , true>::Word; using Elf_Sword = typename ELFType<Endianness , true>::Sword; using Elf_Xword = typename ELFType<Endianness , true>::Xword; using Elf_Sxword = typename ELFType<Endianness , true>::Sxword; using uintX_t = typename ELFType<Endianness , true>::uint; using Elf_Ehdr = typename ELFType<Endianness , true>::Ehdr; using Elf_Shdr = typename ELFType<Endianness , true>::Shdr; using Elf_Sym = typename ELFType<Endianness , true>::Sym; using Elf_Dyn = typename ELFType<Endianness , true>::Dyn; using Elf_Phdr = typename ELFType<Endianness , true>::Phdr; using Elf_Rel = typename ELFType<Endianness , true>::Rel; using Elf_Rela = typename ELFType<Endianness , true>::Rela; using Elf_Crel = typename ELFType<Endianness , true>::Crel; using Elf_Relr = typename ELFType<Endianness , true>::Relr; using Elf_Verdef = typename ELFType<Endianness , true>::Verdef; using Elf_Verdaux = typename ELFType<Endianness , true>::Verdaux; using Elf_Verneed = typename ELFType<Endianness , true>::Verneed; using Elf_Vernaux = typename ELFType<Endianness , true>::Vernaux; using Elf_Versym = typename ELFType<Endianness , true>::Versym; using Elf_Hash = typename ELFType<Endianness , true>::Hash; using Elf_GnuHash = typename ELFType<Endianness , true>::GnuHash; using Elf_Chdr = typename ELFType<Endianness , true>::Chdr; using Elf_Nhdr = typename ELFType<Endianness , true>::Nhdr; using Elf_Note = typename ELFType<Endianness , true>::Note; using Elf_Note_Iterator = typename ELFType<Endianness , true>::NoteIterator; using Elf_CGProfile = typename ELFType<Endianness , true>::CGProfile; using Elf_Dyn_Range = typename ELFType<Endianness , true>::DynRange; using Elf_Shdr_Range = typename ELFType<Endianness , true>::ShdrRange; using Elf_Sym_Range = typename ELFType<Endianness , true>::SymRange; using Elf_Rel_Range = typename ELFType<Endianness , true>::RelRange; using Elf_Rela_Range = typename ELFType<Endianness , true>::RelaRange; using Elf_Relr_Range = typename ELFType<Endianness , true>::RelrRange; using Elf_Phdr_Range = typename ELFType<Endianness , true>::PhdrRange;
  Elf_Sxword d_tag;
  union {
    Elf_Xword d_val;
    Elf_Addr d_ptr;
  } d_un;
};


template <class ELFT>
struct Elf_Dyn_Impl : Elf_Dyn_Base<ELFT> {
  using Elf_Dyn_Base<ELFT>::d_tag;
  using Elf_Dyn_Base<ELFT>::d_un;
  using intX_t = std::conditional_t<ELFT::Is64Bits, int64_t, int32_t>;
  using uintX_t = std::conditional_t<ELFT::Is64Bits, uint64_t, uint32_t>;
  intX_t getTag() const { return d_tag; }
  uintX_t getVal() const { return d_un.d_val; }
  uintX_t getPtr() const { return d_un.d_ptr; }
};

template <endianness Endianness>
struct Elf_Rel_Impl<ELFType<Endianness, false>, false> {
  using Elf_Addr = typename ELFType<Endianness , false>::Addr; using Elf_Off = typename ELFType<Endianness , false>::Off; using Elf_Half = typename ELFType<Endianness , false>::Half; using Elf_Word = typename ELFType<Endianness , false>::Word; using Elf_Sword = typename ELFType<Endianness , false>::Sword; using Elf_Xword = typename ELFType<Endianness , false>::Xword; using Elf_Sxword = typename ELFType<Endianness , false>::Sxword; using uintX_t = typename ELFType<Endianness , false>::uint; using Elf_Ehdr = typename ELFType<Endianness , false>::Ehdr; using Elf_Shdr = typename ELFType<Endianness , false>::Shdr; using Elf_Sym = typename ELFType<Endianness , false>::Sym; using Elf_Dyn = typename ELFType<Endianness , false>::Dyn; using Elf_Phdr = typename ELFType<Endianness , false>::Phdr; using Elf_Rel = typename ELFType<Endianness , false>::Rel; using Elf_Rela = typename ELFType<Endianness , false>::Rela; using Elf_Crel = typename ELFType<Endianness , false>::Crel; using Elf_Relr = typename ELFType<Endianness , false>::Relr; using Elf_Verdef = typename ELFType<Endianness , false>::Verdef; using Elf_Verdaux = typename ELFType<Endianness , false>::Verdaux; using Elf_Verneed = typename ELFType<Endianness , false>::Verneed; using Elf_Vernaux = typename ELFType<Endianness , false>::Vernaux; using Elf_Versym = typename ELFType<Endianness , false>::Versym; using Elf_Hash = typename ELFType<Endianness , false>::Hash; using Elf_GnuHash = typename ELFType<Endianness , false>::GnuHash; using Elf_Chdr = typename ELFType<Endianness , false>::Chdr; using Elf_Nhdr = typename ELFType<Endianness , false>::Nhdr; using Elf_Note = typename ELFType<Endianness , false>::Note; using Elf_Note_Iterator = typename ELFType<Endianness , false>::NoteIterator; using Elf_CGProfile = typename ELFType<Endianness , false>::CGProfile; using Elf_Dyn_Range = typename ELFType<Endianness , false>::DynRange; using Elf_Shdr_Range = typename ELFType<Endianness , false>::ShdrRange; using Elf_Sym_Range = typename ELFType<Endianness , false>::SymRange; using Elf_Rel_Range = typename ELFType<Endianness , false>::RelRange; using Elf_Rela_Range = typename ELFType<Endianness , false>::RelaRange; using Elf_Relr_Range = typename ELFType<Endianness , false>::RelrRange; using Elf_Phdr_Range = typename ELFType<Endianness , false>::PhdrRange;
  static const bool HasAddend = false;
  static const bool IsCrel = false;
  Elf_Addr r_offset;
  Elf_Word r_info;

  uint32_t getRInfo(bool isMips64EL) const {
    (static_cast<void> (0));
    return r_info;
  }
  void setRInfo(uint32_t R, bool IsMips64EL) {
    (static_cast<void> (0));
    r_info = R;
  }



  uint32_t getSymbol(bool isMips64EL) const {
    return this->getRInfo(isMips64EL) >> 8;
  }
  unsigned char getType(bool isMips64EL) const {
    return (unsigned char)(this->getRInfo(isMips64EL) & 0x0ff);
  }
  void setSymbol(uint32_t s, bool IsMips64EL) {
    setSymbolAndType(s, getType(IsMips64EL), IsMips64EL);
  }
  void setType(unsigned char t, bool IsMips64EL) {
    setSymbolAndType(getSymbol(IsMips64EL), t, IsMips64EL);
  }
  void setSymbolAndType(uint32_t s, unsigned char t, bool IsMips64EL) {
    this->setRInfo((s << 8) + t, IsMips64EL);
  }
};

template <endianness Endianness>
struct Elf_Rel_Impl<ELFType<Endianness, false>, true>
    : public Elf_Rel_Impl<ELFType<Endianness, false>, false> {
