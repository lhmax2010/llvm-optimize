ymRange; using Elf_Rel_Range = typename ELFType<Endianness , true>::RelRange; using Elf_Rela_Range = typename ELFType<Endianness , true>::RelaRange; using Elf_Relr_Range = typename ELFType<Endianness , true>::RelrRange; using Elf_Phdr_Range = typename ELFType<Endianness , true>::PhdrRange;
