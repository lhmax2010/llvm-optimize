                  getAddRecExpr(NewStart, Step, AR->getLoop(),
                                NoWrap ? SCEV::FlagNW : SCEV::FlagAnyWrap);
              if (LHS != NewLHS) {
                LHS = NewLHS;



                ID.clear();
                ID.AddInteger(scUDivExpr);
                ID.AddPointer(LHS);
                ID.AddPointer(RHS);
