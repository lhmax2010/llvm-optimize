    SmallVector<const SCEVPredicate *, 4> Predicates;




                 __attribute__((visibility("default"))) ExitLimit(const SCEV *E);

    __attribute__((visibility("default")))
    ExitLimit(const SCEV *E, const SCEV *ConstantMaxNotTaken,
