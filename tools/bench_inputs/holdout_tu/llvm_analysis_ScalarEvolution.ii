  RetTy visitVAEndInst(VAEndInst &I) { return static_cast<SubClass*>(this)-> visitIntrinsicInst(static_cast<IntrinsicInst&>(I)); }
  RetTy visitVACopyInst(VACopyInst &I) { return static_cast<SubClass*>(this)-> visitIntrinsicInst(static_cast<IntrinsicInst&>(I)); }
  RetTy visitIntrinsicInst(IntrinsicInst &I) { return static_cast<SubClass*>(this)-> visitCallInst(static_cast<CallInst&>(I)); }
  RetTy visitCallInst(CallInst &I) { return static_cast<SubClass*>(this)-> visitCallBase(static_cast<CallBase&>(I)); }
  RetTy visitInvokeInst(InvokeInst &I) { return static_cast<SubClass*>(this)-> visitCallBase(static_cast<CallBase&>(I)); }
  RetTy visitCallBrInst(CallBrInst &I) { return static_cast<SubClass*>(this)-> visitCallBase(static_cast<CallBase&>(I)); }



  RetTy visitReturnInst(ReturnInst &I) {
    return static_cast<SubClass *>(this)->visitTerminator(I);
  }
  RetTy visitBranchInst(BranchInst &I) {
    return static_cast<SubClass *>(this)->visitTerminator(I);
  }
  RetTy visitSwitchInst(SwitchInst &I) {
    return static_cast<SubClass *>(this)->visitTerminator(I);
  }
  RetTy visitIndirectBrInst(IndirectBrInst &I) {
    return static_cast<SubClass *>(this)->visitTerminator(I);
  }
  RetTy visitResumeInst(ResumeInst &I) {
    return static_cast<SubClass *>(this)->visitTerminator(I);
  }
  RetTy visitUnreachableInst(UnreachableInst &I) {
    return static_cast<SubClass *>(this)->visitTerminator(I);
  }
  RetTy visitCleanupReturnInst(CleanupReturnInst &I) {
    return static_cast<SubClass *>(this)->visitTerminator(I);
  }
  RetTy visitCatchReturnInst(CatchReturnInst &I) {
    return static_cast<SubClass *>(this)->visitTerminator(I);
  }
  RetTy visitCatchSwitchInst(CatchSwitchInst &I) {
    return static_cast<SubClass *>(this)->visitTerminator(I);
  }
  RetTy visitTerminator(Instruction &I) { return static_cast<SubClass*>(this)-> visitInstruction(static_cast<Instruction&>(I));}





  RetTy visitCastInst(CastInst &I) { return static_cast<SubClass*>(this)-> visitUnaryInstruction(static_cast<UnaryInstruction&>(I));}
  RetTy visitUnaryOperator(UnaryOperator &I) { return static_cast<SubClass*>(this)-> visitUnaryInstruction(static_cast<UnaryInstruction&>(I));}
  RetTy visitBinaryOperator(BinaryOperator &I) { return static_cast<SubClass*>(this)-> visitInstruction(static_cast<Instruction&>(I));}
  RetTy visitCmpInst(CmpInst &I) { return static_cast<SubClass*>(this)-> visitInstruction(static_cast<Instruction&>(I));}
  RetTy visitUnaryInstruction(UnaryInstruction &I){ return static_cast<SubClass*>(this)-> visitInstruction(static_cast<Instruction&>(I));}



  RetTy visitCallBase(CallBase &I) {
    if (isa<InvokeInst>(I) || isa<CallBrInst>(I))
      return static_cast<SubClass *>(this)->visitTerminator(I);

    return static_cast<SubClass*>(this)-> visitInstruction(static_cast<Instruction&>(I));
  }







  void visitInstruction(Instruction &I) {}

private:

  RetTy delegateCallInst(CallInst &I) {
    if (const Function *F = I.getCalledFunction()) {
      switch (F->getIntrinsicID()) {
      default: return static_cast<SubClass*>(this)-> visitIntrinsicInst(static_cast<IntrinsicInst&>(I));
      case Intrinsic::memcpy:
      case Intrinsic::memcpy_inline:
        return static_cast<SubClass*>(this)-> visitMemCpyInst(static_cast<MemCpyInst&>(I));
      case Intrinsic::memmove: return static_cast<SubClass*>(this)-> visitMemMoveInst(static_cast<MemMoveInst&>(I));
      case Intrinsic::memset:
      case Intrinsic::memset_inline:
        return static_cast<SubClass*>(this)-> visitMemSetInst(static_cast<MemSetInst&>(I));
      case Intrinsic::experimental_memset_pattern:
        return static_cast<SubClass*>(this)-> visitMemSetPatternInst(static_cast<MemSetPatternInst&>(I));
      case Intrinsic::vastart: return static_cast<SubClass*>(this)-> visitVAStartInst(static_cast<VAStartInst&>(I));
      case Intrinsic::vaend: return static_cast<SubClass*>(this)-> visitVAEndInst(static_cast<VAEndInst&>(I));
      case Intrinsic::vacopy: return static_cast<SubClass*>(this)-> visitVACopyInst(static_cast<VACopyInst&>(I));
      case Intrinsic::not_intrinsic: break;
      }
    }
    return static_cast<SubClass*>(this)-> visitCallInst(static_cast<CallInst&>(I));
  }



  RetTy delegateCallInst(Instruction &I) {
    __builtin_unreachable();
  }
};



