  const SCEV *Expr;

  specificscev_ty(const SCEV *Expr) : Expr(Expr) {}

  template <typename ITy> bool match(ITy *S) const { return S == Expr; }
};


inline specificscev_ty m_scev_Specific(const SCEV *S) { return S; }

