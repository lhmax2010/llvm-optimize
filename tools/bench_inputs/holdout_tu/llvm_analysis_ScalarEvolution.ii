class ScalarEvolution {
  friend class ScalarEvolutionsTest;

public:

  enum LoopDisposition {
    LoopVariant,
    LoopInvariant,
    LoopComputable
  };


  enum BlockDisposition {
    DoesNotDominateBlock,
    DominatesBlock,
    ProperlyDominatesBlock
  };



  [[nodiscard]] static SCEV::NoWrapFlags maskFlags(SCEV::NoWrapFlags Flags,
                                                   int Mask) {
    return (SCEV::NoWrapFlags)(Flags & Mask);
  }
  [[nodiscard]] static SCEV::NoWrapFlags setFlags(SCEV::NoWrapFlags Flags,
                                                  SCEV::NoWrapFlags OnFlags) {
    return (SCEV::NoWrapFlags)(Flags | OnFlags);
  }
  [[nodiscard]] static SCEV::NoWrapFlags
  clearFlags(SCEV::NoWrapFlags Flags, SCEV::NoWrapFlags OffFlags) {
    return (SCEV::NoWrapFlags)(Flags & ~OffFlags);
  }
  [[nodiscard]] static bool hasFlags(SCEV::NoWrapFlags Flags,
                                     SCEV::NoWrapFlags TestFlags) {
    return TestFlags == maskFlags(Flags, TestFlags);
  };

  __attribute__((visibility("default"))) ScalarEvolution(Function &F, TargetLibraryInfo &TLI,
                           AssumptionCache &AC, DominatorTree &DT,
                           LoopInfo &LI);
  __attribute__((visibility("default"))) ScalarEvolution(ScalarEvolution &&Arg);
  __attribute__((visibility("default"))) ~ScalarEvolution();

  LLVMContext &getContext() const { return F.getContext(); }





  __attribute__((visibility("default"))) bool isSCEVable(Type *Ty) const;



  __attribute__((visibility("default"))) uint64_t getTypeSizeInBits(Type *Ty) const;




