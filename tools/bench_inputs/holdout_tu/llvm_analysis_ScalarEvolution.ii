  }



  constexpr ScalarTy
  getKnownScalarFactor(const FixedOrScalableQuantity &RHS) const {
    (static_cast<void> (0));
    return getKnownMinValue() / RHS.getKnownMinValue();
  }


  void print(raw_ostream &OS) const {
    if (isScalable())
      OS << "vscale x ";
    OS << getKnownMinValue();
  }
};

