class PredicatedScalarEvolution {
public:
  __attribute__((visibility("default"))) PredicatedScalarEvolution(ScalarEvolution &SE, Loop &L);

  __attribute__((visibility("default"))) const SCEVPredicate &getPredicate() const;





  __attribute__((visibility("default"))) const SCEV *getSCEV(Value *V);





  __attribute__((visibility("default"))) const SCEV *getPredicatedSCEV(const SCEV *Expr);


  __attribute__((visibility("default"))) const SCEV *getBackedgeTakenCount();


  __attribute__((visibility("default"))) const SCEV *getSymbolicMaxBackedgeTakenCount();



  __attribute__((visibility("default"))) unsigned getSmallConstantMaxTripCount();


  __attribute__((visibility("default"))) void addPredicate(const SCEVPredicate &Pred);





  __attribute__((visibility("default"))) const SCEVAddRecExpr *getAsAddRec(Value *V);


  __attribute__((visibility("default"))) void setNoOverflow(Value *V,
                              SCEVWrapPredicate::IncrementWrapFlags Flags);



  __attribute__((visibility("default"))) bool hasNoOverflow(Value *V,
                              SCEVWrapPredicate::IncrementWrapFlags Flags);


  ScalarEvolution *getSE() const { return &SE; }


  __attribute__((visibility("default"))) PredicatedScalarEvolution(const PredicatedScalarEvolution &);



  __attribute__((visibility("default"))) void print(raw_ostream &OS, unsigned Depth) const;



  __attribute__((visibility("default"))) bool areAddRecsEqualWithPreds(const SCEVAddRecExpr *AR1,
                                         const SCEVAddRecExpr *AR2) const;

private:


  void updateGeneration();



  using RewriteEntry = std::pair<unsigned, const SCEV *>;






  DenseMap<const SCEV *, RewriteEntry> RewriteMap;


  ValueMap<Value *, SCEVWrapPredicate::IncrementWrapFlags> FlagsMap;


  ScalarEvolution &SE;


  const Loop &L;



  std::unique_ptr<SCEVUnionPredicate> Preds;





  unsigned Generation = 0;


  const SCEV *BackedgeCount = nullptr;


  const SCEV *SymbolicMaxBackedgeCount = nullptr;


  std::optional<unsigned> SmallConstantMaxTripCount;
};

template <> struct DenseMapInfo<ScalarEvolution::FoldID> {
  static inline ScalarEvolution::FoldID getEmptyKey() {
    ScalarEvolution::FoldID ID(0);
    return ID;
  }
  static inline ScalarEvolution::FoldID getTombstoneKey() {
    ScalarEvolution::FoldID ID(1);
    return ID;
  }

  static unsigned getHashValue(const ScalarEvolution::FoldID &Val) {
    return Val.computeHash();
  }

  static bool isEqual(const ScalarEvolution::FoldID &LHS,
                      const ScalarEvolution::FoldID &RHS) {
    return LHS == RHS;
  }
};

}
