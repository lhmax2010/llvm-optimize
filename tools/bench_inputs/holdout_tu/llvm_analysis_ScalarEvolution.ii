    Nand,

    Or,

    Xor,

    Max,

    Min,

    UMax,

    UMin,


    FAdd,


    FSub,



    FMax,



    FMin,



    FMaximum,



    FMinimum,



    UIncWrap,



    UDecWrap,



    USubCond,



    USubSat,

    FIRST_BINOP = Xchg,
    LAST_BINOP = USubSat,
    BAD_BINOP
  };

private:
