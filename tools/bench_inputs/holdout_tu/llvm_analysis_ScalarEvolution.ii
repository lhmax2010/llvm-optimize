                                            uint8_t CC, Metadata *TypeArray,
                                            StorageType Storage,
                                            bool ShouldCreate = true);

  TempDISubroutineType cloneImpl() const {
    return getTemporary(getContext(), getFlags(), getCC(), getTypeArray());
  }

public:
  static DISubroutineType *get(LLVMContext &Context, DIFlags Flags, uint8_t CC, DITypeRefArray TypeArray) { return getImpl(Context, Flags, CC, TypeArray, Uniqued); } static DISubroutineType *getIfExists(LLVMContext &Context, DIFlags Flags, uint8_t CC, DITypeRefArray TypeArray) { return getImpl(Context, Flags, CC, TypeArray, Uniqued, false); } static DISubroutineType *getDistinct(LLVMContext &Context, DIFlags Flags, uint8_t CC, DITypeRefArray TypeArray) { return getImpl(Context, Flags, CC, TypeArray, Distinct); } static TempDISubroutineType getTemporary(LLVMContext &Context, DIFlags Flags, uint8_t CC, DITypeRefArray TypeArray) { return TempDISubroutineType( getImpl(Context, Flags, CC, TypeArray, Temporary)); }


