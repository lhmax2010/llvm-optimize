static inline unsigned getFSPassBitEnd(sampleprof::FSDiscriminatorPass P) {
  unsigned I = static_cast<unsigned>(P);
  (static_cast<void> (0));
  return BaseDiscriminatorBitWidth + I * FSDiscriminatorBitWidth - 1;
