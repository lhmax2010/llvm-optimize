template <bool mt_only> class SmartRWMutex {

  std::shared_mutex impl;



  unsigned readers = 0;
  unsigned writers = 0;

public:
  bool lock_shared() {
    if (!mt_only || llvm_is_multithreaded()) {
      impl.lock_shared();
      return true;
    }



    ++readers;
    return true;
  }

  bool unlock_shared() {
    if (!mt_only || llvm_is_multithreaded()) {
      impl.unlock_shared();
      return true;
    }



    (static_cast<void> (0));
    --readers;
    return true;
  }

  bool try_lock_shared() { return impl.try_lock_shared(); }

  bool lock() {
    if (!mt_only || llvm_is_multithreaded()) {
      impl.lock();
      return true;
    }



    (static_cast<void> (0));
    ++writers;
    return true;
  }

  bool unlock() {
    if (!mt_only || llvm_is_multithreaded()) {
      impl.unlock();
      return true;
    }



    (static_cast<void> (0));
    --writers;
    return true;
  }

  bool try_lock() { return impl.try_lock(); }
};

using RWMutex = SmartRWMutex<false>;



template <bool mt_only>
using SmartScopedReader = const std::shared_lock<SmartRWMutex<mt_only>>;
