    if (!isa<SCEVConstant>(XConstOp))
      return false;

    if (!splitBinaryAdd(Y, YConstOp, YNonConstOp, YFlagsPresent)) {
      YConstOp = getZero(Y->getType());
      YNonConstOp = Y;
      YFlagsPresent = ExpectedFlags;
    }

    if (YNonConstOp != XNonConstOp)
      return false;

    if (!isa<SCEVConstant>(YConstOp))
