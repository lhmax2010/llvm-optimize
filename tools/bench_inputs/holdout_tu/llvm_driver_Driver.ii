class ErrorAsOutParameter {
public:

  ErrorAsOutParameter(Error *Err) : Err(Err) {

    if (Err)
      (void)!!*Err;
  }

  ErrorAsOutParameter(Error &Err) : Err(&Err) {
    (void)!!Err;
  }

  ~ErrorAsOutParameter() {

    if (Err && !*Err)
      *Err = Error::success();
  }

private:
  Error *Err;
};




