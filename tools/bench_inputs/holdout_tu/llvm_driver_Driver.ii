namespace detail {


struct RecDirIterState {
  std::vector<directory_iterator> Stack;
  bool HasNoPushRequest = false;
};

}



class recursive_directory_iterator {
  FileSystem *FS;
  std::shared_ptr<detail::RecDirIterState>
      State;

public:
  __attribute__((visibility("default"))) recursive_directory_iterator(FileSystem &FS, const Twine &Path,
                                        std::error_code &EC);


  recursive_directory_iterator() = default;


  __attribute__((visibility("default"))) recursive_directory_iterator &increment(std::error_code &EC);

  const directory_entry &operator*() const { return *State->Stack.back(); }
  const directory_entry *operator->() const { return &*State->Stack.back(); }

  bool operator==(const recursive_directory_iterator &Other) const {
    return State == Other.State;
  }
  bool operator!=(const recursive_directory_iterator &RHS) const {
    return !(*this == RHS);
  }


  int level() const {
    (static_cast<void> (0));

    return State->Stack.size() - 1;
  }

  void no_push() { State->HasNoPushRequest = true; }
};


