  DiagnosticBuilder() = default;

protected:
  DiagnosticBuilder(DiagnosticsEngine *DiagObj, SourceLocation DiagLoc,
                    unsigned DiagID);

  DiagnosticsEngine *getDiagnosticsEngine() const { return DiagObj; }
  unsigned getDiagID() const { return DiagID; }


