    OFK_Host = 0x01,


    OFK_Cuda = 0x02,
    OFK_OpenMP = 0x04,
    OFK_HIP = 0x08,
    OFK_SYCL = 0x10,
  };

  static const char *getClassName(ActionClass AC);

private:
  ActionClass Kind;


  types::ID Type;

  ActionList Inputs;





  bool CanBeCollapsedWithNextDependentAction = true;

