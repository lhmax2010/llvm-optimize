  const std::vector<std::string> &getFeatures() const { return Features; }


  __attribute__((visibility("default"))) void print(raw_ostream &OS) const;


  __attribute__((visibility("default"))) void dump() const;


  __attribute__((visibility("default"))) void getDefaultSubtargetFeatures(const Triple &Triple);


  static bool hasFlag(StringRef Feature) {
    (static_cast<void> (0));

    char Ch = Feature[0];

    return Ch == '+' || Ch =='-';
  }


  static StringRef StripFlag(StringRef Feature) {
    return hasFlag(Feature) ? Feature.substr(1) : Feature;
  }


  static inline bool isEnabled(StringRef Feature) {
    (static_cast<void> (0));

    char Ch = Feature[0];

    return Ch == '+';
  }


  __attribute__((visibility("default"))) static void Split(std::vector<std::string> &V, StringRef S);
};

