                      llvm::opt::DerivedArgList &Args) const;

  bool isEnabled() const {
    return UseCUID != Kind::None && UseCUID != Kind::Invalid;
  }

private:
  Kind UseCUID = Kind::None;
  StringRef FixedCUID;
};



