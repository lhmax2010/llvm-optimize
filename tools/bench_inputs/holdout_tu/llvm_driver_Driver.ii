    : public iterator_facade_base<const_iterator, std::input_iterator_tag,
                                  const StringRef> {
  StringRef Path;
  StringRef Component;
  size_t Position = 0;
  Style S = Style::native;


  __attribute__((visibility("default"))) friend const_iterator begin(StringRef path, Style style);
  __attribute__((visibility("default"))) friend const_iterator end(StringRef path);

public:
  reference operator*() const { return Component; }
