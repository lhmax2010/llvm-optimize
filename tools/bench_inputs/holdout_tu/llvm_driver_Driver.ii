namespace llvm {

class raw_ostream;

namespace opt {

class ArgList;





class Arg {
private:

  const Option Opt;



  const Arg *BaseArg;


  StringRef Spelling;



  unsigned Index;






  mutable unsigned Claimed : 1;



  unsigned IgnoredTargetSpecific : 1;


  mutable unsigned OwnsValues : 1;


  SmallVector<const char *, 2> Values;




  std::unique_ptr<Arg> Alias;

public:
  __attribute__((visibility("default"))) Arg(const Option Opt, StringRef Spelling, unsigned Index,
               const Arg *BaseArg = nullptr);
  __attribute__((visibility("default"))) Arg(const Option Opt, StringRef Spelling, unsigned Index,
               const char *Value0, const Arg *BaseArg = nullptr);
  __attribute__((visibility("default"))) Arg(const Option Opt, StringRef Spelling, unsigned Index,
               const char *Value0, const char *Value1,
               const Arg *BaseArg = nullptr);
  Arg(const Arg &) = delete;
  Arg &operator=(const Arg &) = delete;
  __attribute__((visibility("default"))) ~Arg();

  const Option &getOption() const { return Opt; }







  StringRef getSpelling() const { return Spelling; }

  unsigned getIndex() const { return Index; }





  const Arg &getBaseArg() const {
    return BaseArg ? *BaseArg : *this;
  }
  Arg &getBaseArg() { return BaseArg ? const_cast<Arg &>(*BaseArg) : *this; }
  void setBaseArg(const Arg *BaseArg) { this->BaseArg = BaseArg; }



  const Arg* getAlias() const { return Alias.get(); }
  void setAlias(std::unique_ptr<Arg> Alias) { this->Alias = std::move(Alias); }

  bool getOwnsValues() const { return OwnsValues; }
  void setOwnsValues(bool Value) const { OwnsValues = Value; }

  bool isClaimed() const { return getBaseArg().Claimed; }
  void claim() const { getBaseArg().Claimed = true; }

  bool isIgnoredTargetSpecific() const {
    return getBaseArg().IgnoredTargetSpecific;
  }
  void ignoreTargetSpecific() {
    getBaseArg().IgnoredTargetSpecific = true;
  }

  unsigned getNumValues() const { return Values.size(); }

  const char *getValue(unsigned N = 0) const {
    return Values[N];
  }

  SmallVectorImpl<const char *> &getValues() { return Values; }
  const SmallVectorImpl<const char *> &getValues() const { return Values; }

  bool containsValue(StringRef Value) const {
    return llvm::is_contained(Values, Value);
  }


  __attribute__((visibility("default"))) void render(const ArgList &Args, ArgStringList &Output) const;






  __attribute__((visibility("default"))) void renderAsInput(const ArgList &Args, ArgStringList &Output) const;

  __attribute__((visibility("default"))) void print(raw_ostream &O) const;
  __attribute__((visibility("default"))) void dump() const;





  __attribute__((visibility("default"))) std::string getAsString(const ArgList &Args) const;
};

}

}
