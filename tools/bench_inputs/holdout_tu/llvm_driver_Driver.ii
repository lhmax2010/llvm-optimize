    MovePtrT MovePtr;
    DestroyPtrT DestroyPtr;
  };




  using CallbackPointerUnionT =
      PointerUnion<TrivialCallback *, NonTrivialCallbacks *>;



  union StorageUnionT {


    struct OutOfLineStorageT {
      void *StoragePtr;
      size_t Size;
      size_t Alignment;
    } OutOfLineStorage;
    static_assert(
