  public:
    ObjCEncOptions() : Bits(0) {}
# 3666 "/home/linhao/Toolchain/development/llvm-optimize/temp/gbs-root-x86_64-debuginfo-j4-v2/local/BUILD-ROOTS/scratch.x86_64.0/home/abuild/rpmbuild/BUILD/llvm-22.1.8/clang/include/clang/AST/ASTContext.h"
ObjCEncOptions& setExpandPointedToStructures() { Bits |= 1 << 0; return *this; } ObjCEncOptions& setExpandStructures() { Bits |= 1 << 1; return *this; } ObjCEncOptions& setIsOutermostType() { Bits |= 1 << 2; return *this; } ObjCEncOptions& setEncodingProperty() { Bits |= 1 << 3; return *this; } ObjCEncOptions& setIsStructField() { Bits |= 1 << 4; return *this; } ObjCEncOptions& setEncodeBlockParameters() { Bits |= 1 << 5; return *this; } ObjCEncOptions& setEncodeClassNames() { Bits |= 1 << 6; return *this; }



bool ExpandPointedToStructures() const { return Bits & 1 << 0; } bool ExpandStructures() const { return Bits & 1 << 1; } bool IsOutermostType() const { return Bits & 1 << 2; } bool EncodingProperty() const { return Bits & 1 << 3; } bool IsStructField() const { return Bits & 1 << 4; } bool EncodeBlockParameters() const { return Bits & 1 << 5; } bool EncodeClassNames() const { return Bits & 1 << 6; }




    [[nodiscard]] ObjCEncOptions keepingOnly(ObjCEncOptions Mask) const {
      return Bits & Mask.Bits;
    }

    [[nodiscard]] ObjCEncOptions forComponentType() const {
      ObjCEncOptions Mask = ObjCEncOptions()
                                .setIsOutermostType()
                                .setIsStructField();
      return Bits & ~Mask.Bits;
    }
  };


