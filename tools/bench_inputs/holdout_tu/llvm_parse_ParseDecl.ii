  }



  ArrayRef<ValueDecl *> getUniqueDeclsRef() const {
    return static_cast<const T *>(this)
        ->template getTrailingObjectsNonStrict<ValueDecl *>(
            NumUniqueDeclarations);
  }



  void setUniqueDecls(ArrayRef<ValueDecl *> UDs) {
