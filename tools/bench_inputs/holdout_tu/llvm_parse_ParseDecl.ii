  template <typename T,
            typename = std::enable_if_t<std::is_base_of<NamedDecl, T>::value>>
  bool ActOnDuplicateODRHashDefinition(T *Duplicate, T *Previous) {
    if (Duplicate->getODRHash() != Previous->getODRHash())
      return false;


    makeMergedDefinitionVisible(Previous);
    return true;
  }




