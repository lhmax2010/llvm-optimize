      }
      ResultKind = LookupResultKind::Found;
      resolveKind();



      if (ResultKind == LookupResultKind::Ambiguous) {
        (void)WasAmbiguous;
        (static_cast<void> (0));
        Ambiguity = *SavedAK;
      } else if (Paths) {
        deletePaths(Paths);
        Paths = nullptr;
      }
    }
