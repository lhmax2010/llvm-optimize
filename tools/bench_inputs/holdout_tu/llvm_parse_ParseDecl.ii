  static bool isSupportedCXXABI(const llvm::Triple &T, Kind Kind) {
    switch (Kind) {
    case GenericARM:
      return T.isARM() || T.isAArch64();

    case iOS:
    case WatchOS:
    case AppleARM64:
      return T.isOSDarwin();

    case Fuchsia:
      return T.isOSFuchsia();

    case GenericAArch64:
      return T.isAArch64();

    case GenericMIPS:
      return T.isMIPS();

    case WebAssembly:
      return T.isWasm();

    case XL:
      return T.isOSAIX();

    case GenericItanium:
      return true;

    case Microsoft:
      return T.isKnownWindowsMSVCEnvironment();
    }
    __builtin_unreachable();
  }


