class DeclIDBase {
public:
# 108 "/home/linhao/Toolchain/development/llvm-optimize/temp/gbs-root-x86_64-debuginfo-j4-v2/local/BUILD-ROOTS/scratch.x86_64.0/home/abuild/rpmbuild/BUILD/llvm-22.1.8/clang/include/clang/AST/DeclID.h"
  using DeclID = uint64_t;

protected:
