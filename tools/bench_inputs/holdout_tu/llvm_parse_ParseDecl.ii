      Actions.OpenMP().startOpenMPLoop();
    if (getLangOpts().CPlusPlus)
      return Tok.is(tok::kw_using) ||
             isCXXSimpleDeclaration( true);
    return isDeclarationSpecifier(ImplicitTypenameContext::No, true);
  }


