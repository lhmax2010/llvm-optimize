class SLocEntry {
  static constexpr int OffsetBits = 8 * sizeof(SourceLocation::UIntTy) - 1;
  SourceLocation::UIntTy Offset : OffsetBits;
  __attribute__((preferred_type(bool)))
  SourceLocation::UIntTy IsExpansion : 1;
  union {
    FileInfo File;
    ExpansionInfo Expansion;
  };

public:
  SLocEntry() : Offset(), IsExpansion(), File() {}

  SourceLocation::UIntTy getOffset() const { return Offset; }

  bool isExpansion() const { return IsExpansion; }
  bool isFile() const { return !isExpansion(); }

  const FileInfo &getFile() const {
    return const_cast<SLocEntry *>(this)->getFile();
  }

  FileInfo &getFile() {
    (static_cast<void> (0));
    return File;
  }

  const ExpansionInfo &getExpansion() const {
    (static_cast<void> (0));
    return Expansion;
  }


  static SLocEntry getOffsetOnly(SourceLocation::UIntTy Offset) {
    (static_cast<void> (0));
    SLocEntry E;
    E.Offset = Offset;
    return E;
  }

  static SLocEntry get(SourceLocation::UIntTy Offset, const FileInfo &FI) {
    (static_cast<void> (0));
    SLocEntry E;
    E.Offset = Offset;
    E.IsExpansion = false;
    E.File = FI;
    return E;
  }

  static SLocEntry get(SourceLocation::UIntTy Offset,
                       const ExpansionInfo &Expansion) {
    (static_cast<void> (0));
    SLocEntry E;
    E.Offset = Offset;
    E.IsExpansion = true;
    new (&E.Expansion) ExpansionInfo(Expansion);
    return E;
  }
};

}


