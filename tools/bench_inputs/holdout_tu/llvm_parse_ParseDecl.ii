  bool shouldLinkPossiblyHiddenDecl(const NamedDecl *Old,
                                    const NamedDecl *New) {
    if (isVisible(Old))
      return true;


    if (New->isExternallyDeclarable()) {
      (static_cast<void> (0));

      return true;
    }
    return false;
  }
