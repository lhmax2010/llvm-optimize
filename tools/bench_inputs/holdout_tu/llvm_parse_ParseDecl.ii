  static bool TooManyArguments(size_t NumParams, size_t NumArgs,
                               bool PartialOverloading = false) {

    if (NumArgs > 0 && PartialOverloading)
      return NumArgs + 1 > NumParams;
    return NumArgs > NumParams;
  }




