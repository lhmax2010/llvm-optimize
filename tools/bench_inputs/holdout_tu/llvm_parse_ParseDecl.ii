  }
  const detail::PropertyData &getPropertyDataBuffer() const {
    (static_cast<void> (0));
    return *getTrailingObjects<detail::PropertyData>();
  }

  size_t allocated_size() const;

public:
  ParsedAttr(const ParsedAttr &) = delete;
  ParsedAttr(ParsedAttr &&) = delete;
