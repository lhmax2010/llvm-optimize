  enum PragmaMsStackAction {
    PSK_Reset = 0x0,
    PSK_Set = 0x1,
    PSK_Push = 0x2,
    PSK_Pop = 0x4,
    PSK_Show = 0x8,
    PSK_Push_Set = PSK_Push | PSK_Set,
    PSK_Pop_Set = PSK_Pop | PSK_Set,
  };

