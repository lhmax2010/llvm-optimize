                        SourceDeductionGuideKind SourceKind)
      : FunctionDecl(CXXDeductionGuide, C, DC, StartLoc, NameInfo, T, TInfo,
                     SC_None, false, false, ConstexprSpecKind::Unspecified,
                     TrailingRequiresClause),
        Ctor(Ctor), ExplicitSpec(ES),
