+                      '--target=x86_64-tizen-linux-gnu', '-resource-dir='+str(resource_dir),
+                      '-O2', '-g', '-std=c++17', '-I'+str(source/'llvm/include'),
+                      '-I'+str(build/'include'), '-c', str(source/relative)]))
+    return cases
