BuildRequires: python3 >= 3.9
BuildRequires: xz











Requires: libllvm = 22.1.8-1

%description
LLVM is a compiler infrastructure designed for compile-time, link-time, runtime,
and idle-time optimization of programs from arbitrary programming languages.
LLVM is written in C++ and has been developed since 2000 at the University of
Illinois and Apple. It currently supports compilation of C and C++ programs,
using front-ends derived from GCC 4.0.1. A new front-end for the C family of
languages is in development. The compiler infrastructure
includes mirror sets of programming tools as well as libraries with equivalent
functionality.

%package devel
Summary: Libraries and Header Files for LLVM 22.1.8
Requires: llvm = 22.1.8

%description devel
This package contains library and header files needed to develop
new native programs that use the LLVM infrastructure.

%package static-devel
Summary: Static libraries for LLVM
Requires: llvm = 22.1.8

%description static-devel
This package contains static libraries needed to develop new
native programs that use the LLVM infrastructure.

%package -n libllvm
Summary: LLVM shared libraries

%description -n libllvm
Shared libraries for the LLVM compiler infrastructure.

%package -n clang
Summary: Clang 22.1.8 (C Language family frontend for LLVM)
License: NCSA
Requires: llvm = 22.1.8-1
Provides: libclang.so.22.1.8

%description -n clang
A new front-end for the C family of languages is in development.

%package -n clang-devel
Summary: Clang 22.1.8 Development Library
Requires: clang = 22.1.8-1

%description -n clang-devel
This package contains the clang (C language) frontend for LLVM.
(development files)

%package -n lldb
Summary: LLDB
License: NCSA

%description -n lldb
LLDB is a next generation, high-performance debugger. It is built as a set
of reusable components which highly leverage existing libraries in the
larger LLVM Project, such as the Clang expression parser and LLVM
disassembler.

%package -n lldb-devel
Summary: Development header files for LLDB
Requires: lldb = 22.1.8-1

%description -n lldb-devel
The package contains header files for the LLDB debugger.

%package -n compiler-rt
Summary: Compiler runtime libraries

%description -n compiler-rt
Compiler runtime libraries

%package -n libomp
Summary:    OpenMP runtime

%description -n libomp
OpenMP runtime.

%package -n libomp-devel
Summary:    Development files for the OpenMP runtime

%description -n libomp-devel
Development files for the OpenMP runtime.

%package -n python-clang
Summary: Python bindings to parts of the Clang library

%description -n python-clang
Python bindings to parts of the Clang library

%prep
cd '/home/linhao/rpmbuild/BUILD'
rm -rf 'llvm-22.1.8'
/usr/lib/rpm/rpmuncompress -x '/home/linhao/Toolchain/development/llvm-optimize/temp/bolt-v4-20261019-disk-diagnostics/export/llvm-22.1.8.tar.gz'
STATUS=$?
if [ $STATUS -ne 0 ]; then
  exit $STATUS
fi
cd 'llvm-22.1.8'
/bin/chmod -Rf a+rX,u+w,g-w,o-w .
# 0001-Add-support-for-Tizen-toolchain-vendor.patch
echo "Patch #0 (0001-Add-support-for-Tizen-toolchain-vendor.patch):"
/usr/bin/patch --no-backup-if-mismatch -f -p1  --fuzz=0 < /home/linhao/Toolchain/development/llvm-optimize/temp/bolt-v4-20261019-disk-diagnostics/export/0001-Add-support-for-Tizen-toolchain-vendor.patch

# 0002-Link-libclang_rt.asan.so-against-libatomic-when-nece.patch
echo "Patch #1 (0002-Link-libclang_rt.asan.so-against-libatomic-when-nece.patch):"
/usr/bin/patch --no-backup-if-mismatch -f -p1  --fuzz=0 < /home/linhao/Toolchain/development/llvm-optimize/temp/bolt-v4-20261019-disk-diagnostics/export/0002-Link-libclang_rt.asan.so-against-libatomic-when-nece.patch

# 0003-Fix-armv7l-build-when-compiler-is-clang.patch
echo "Patch #2 (0003-Fix-armv7l-build-when-compiler-is-clang.patch):"
/usr/bin/patch --no-backup-if-mismatch -f -p1  --fuzz=0 < /home/linhao/Toolchain/development/llvm-optimize/temp/bolt-v4-20261019-disk-diagnostics/export/0003-Fix-armv7l-build-when-compiler-is-clang.patch

# 0004-clang-add-support-for-LLVM-gold-plugin-in-case-of-ac.patch
echo "Patch #3 (0004-clang-add-support-for-LLVM-gold-plugin-in-case-of-ac.patch):"
/usr/bin/patch --no-backup-if-mismatch -f -p1  --fuzz=0 < /home/linhao/Toolchain/development/llvm-optimize/temp/bolt-v4-20261019-disk-diagnostics/export/0004-clang-add-support-for-LLVM-gold-plugin-in-case-of-ac.patch

# 0005-Merge-MLGO-AOT-compilation-support-and-optimization-.patch
echo "Patch #4 (0005-Merge-MLGO-AOT-compilation-support-and-optimization-.patch):"
/usr/bin/patch --no-backup-if-mismatch -f -p1  --fuzz=0 < /home/linhao/Toolchain/development/llvm-optimize/temp/bolt-v4-20261019-disk-diagnostics/export/0005-Merge-MLGO-AOT-compilation-support-and-optimization-.patch

# 0006-libcxxabi-declare-__gnu_unwind_frame-in-cxa_personal.patch
echo "Patch #5 (0006-libcxxabi-declare-__gnu_unwind_frame-in-cxa_personal.patch):"
/usr/bin/patch --no-backup-if-mismatch -f -p1  --fuzz=0 < /home/linhao/Toolchain/development/llvm-optimize/temp/bolt-v4-20261019-disk-diagnostics/export/0006-libcxxabi-declare-__gnu_unwind_frame-in-cxa_personal.patch

# 0007-libcxx-backport-EH-ABI-forced-unwind-handling.patch
echo "Patch #6 (0007-libcxx-backport-EH-ABI-forced-unwind-handling.patch):"
/usr/bin/patch --no-backup-if-mismatch -f -p1  --fuzz=0 < /home/linhao/Toolchain/development/llvm-optimize/temp/bolt-v4-20261019-disk-diagnostics/export/0007-libcxx-backport-EH-ABI-forced-unwind-handling.patch

mkdir -p mlgo_verify_assets
tar -C mlgo_verify_assets -xzf /home/linhao/Toolchain/development/llvm-optimize/temp/bolt-v4-20261019-disk-diagnostics/export/mlgo_x86_model.tar.gz


cp /home/linhao/Toolchain/development/llvm-optimize/temp/bolt-v4-20261019-disk-diagnostics/export/llvm.manifest .



# Strip pre-existing optimization flags and remove performance-harming flags, then force -O3 + ThinLTO
OPTFLAGS_CFLAGS=$(echo "$CFLAGS" | sed \
    -e 's/\-O[0-9sz]//g' \
    -e 's/\-Ofast//g' \
    -e 's/\-fstack-protector-strong//g' \
    -e 's/\-fstack-protector-all//g' \
    -e 's/\-fstack-protector//g' \
    -e 's/\-fno-inline-functions//g' \
    -e 's/\-fno-omit-frame-pointer//g' \
    -e 's/\-momit-leaf-frame-pointer//g')
OPTFLAGS_CXXFLAGS=$(echo "$CXXFLAGS" | sed \
    -e 's/\-O[0-9sz]//g' \
    -e 's/\-Ofast//g' \
    -e 's/\-fstack-protector-strong//g' \
    -e 's/\-fstack-protector-all//g' \
    -e 's/\-fstack-protector//g' \
    -e 's/\-fno-inline-functions//g' \
    -e 's/\-fno-omit-frame-pointer//g' \
    -e 's/\-momit-leaf-frame-pointer//g')
export CFLAGS="$OPTFLAGS_CFLAGS -O3 -flto=thin -fomit-frame-pointer -Wno-unused-command-line-argument"
export CXXFLAGS="$OPTFLAGS_CXXFLAGS -O3 -flto=thin -fomit-frame-pointer -Wno-unused-command-line-argument"

# Set up MLGO AOT model paths from bundled verify assets
MLGO_AOT_DIR="$PWD/mlgo_verify_assets"
MLGO_BUILD_DIR="$PWD/build"
MLGO_RUNTIME_OBJECTS="${MLGO_AOT_DIR}/xla_runtime_objects/xla_compiled_cpu_function.cc.o;${MLGO_AOT_DIR}/xla_runtime_objects/cpu_function_runtime.cc.o;${MLGO_AOT_DIR}/xla_runtime_objects/custom_call_status.cc.o;${MLGO_AOT_DIR}/xla_runtime_objects/executable_run_options.cc.o;${MLGO_AOT_DIR}/xla_runtime_objects/runtime_single_threaded_matmul_f32.cc.o"
MLGO_REQUIRED_RUNTIME_OBJECTS="xla_compiled_cpu_function.cc.o cpu_function_runtime.cc.o custom_call_status.cc.o executable_run_options.cc.o runtime_single_threaded_matmul_f32.cc.o"

mkdir -p build
cd build
cmake \
    -G Ninja \
    -DTIZEN=1 \
    -DCMAKE_C_COMPILER=clang \
    -DCMAKE_CXX_COMPILER=clang++ \
    -DLLVM_HOST_TRIPLE=x86_64-pc-linux-gnu \
    -DLLVM_DEFAULT_TARGET_TRIPLE=x86_64-pc-linux-gnu \
    -DLLVM_TARGET_TRIPLE_ENV=x86_64-pc-linux-gnu \
    -DCMAKE_ASM_FLAGS="$CFLAGS" \
    -DCMAKE_C_FLAGS="$CFLAGS" \
    -DCMAKE_CXX_FLAGS="$CXXFLAGS" \
    -DCMAKE_SHARED_LINKER_FLAGS="-fuse-ld=lld -flto=thin -ffunction-sections -fdata-sections -Wl,--gc-sections" \
    -DCMAKE_EXE_LINKER_FLAGS="-fuse-ld=lld -flto=thin -ffunction-sections -fdata-sections -Wl,--gc-sections" \
    -DLLVM_USE_LINKER=lld \
    -DLLVM_ENABLE_LTO=Thin \
    -DCMAKE_RANLIB=/usr/bin/llvm-ranlib \
    -DCMAKE_AR=/usr/bin/llvm-ar \
    -DLLVM_ENABLE_ASSERTIONS=No \
    -DLLVM_ENABLE_RTTI=ON \
    -DCMAKE_BUILD_TYPE=Release \
    -DLLVM_TARGETS_TO_BUILD='X86;ARM;AArch64;BPF' \
    -DCLANG_ENABLE_ARCMT=OFF \
    -DLLVM_BUILD_LLVM_DYLIB=ON \
    -DCLANG_BUILD_CLANG_DYLIB=ON \
    -DLLVM_LINK_LLVM_DYLIB=OFF \
    -DCLANG_LINK_CLANG_DYLIB=OFF \
    -DLLVM_ENABLE_PROJECTS="clang;lldb;clang-tools-extra;lld;compiler-rt;openmp" \
    -DLLVM_ENABLE_PER_TARGET_RUNTIME_DIR=OFF \
    -DLLVM_BUILD_EXAMPLES=OFF \
    -DLLVM_INCLUDE_EXAMPLES=OFF \
    -DLLVM_BUILD_TESTS=OFF \
    -DLLVM_INCLUDE_TESTS=OFF \
    -DLLVM_ENABLE_DOXYGEN=OFF \
    -DLLVM_BUILD_DOCS=OFF \
    -DLLVM_INCLUDE_DOCS=OFF \
    -DLLVM_OPTIMIZED_TABLEGEN=ON \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DLLVM_LIBDIR_SUFFIX=`echo lib64 | sed s/lib//g` \
    -DCLANG_RESOURCE_DIR="../lib64/clang/22" \
    -DLLVM_BINUTILS_INCDIR=/usr/include \
    -DLLVM_PARALLEL_COMPILE_JOBS=6 \
    -DLLVM_PARALLEL_LINK_JOBS=2 \
    -DTENSORFLOW_AOT_PATH="${MLGO_AOT_DIR}/mlgo_sysroot" \
    -DLLVM_MLGO_EXPORT_TF_XLA_RUNTIME=OFF \
    -DLLVM_MLGO_EMBED_TF_XLA_RUNTIME_OBJECTS="${MLGO_RUNTIME_OBJECTS}" \
    -DLLVM_OVERRIDE_MODEL_HEADER_INLINERSIZEMODEL="${MLGO_AOT_DIR}/InlinerSizeModel.h" \
    -DLLVM_OVERRIDE_MODEL_OBJECT_INLINERSIZEMODEL="${MLGO_AOT_DIR}/InlinerSizeModel.o" \
    -DLLVM_OVERRIDE_MODEL_HEADER_REGALLOCEVICTMODEL="${MLGO_AOT_DIR}/RegAllocEvictModel.h" \
    -DLLVM_OVERRIDE_MODEL_OBJECT_REGALLOCEVICTMODEL="${MLGO_AOT_DIR}/RegAllocEvictModel.o" \
    ../llvm


# Full build using ninja (already in build/ directory after cd build)
if BOLT_BUILD_OUTPUT=$(ninja -d keeprsp -j 6 2>&1); then
  printf '%s\n' "$BOLT_BUILD_OUTPUT" || exit 1
else
  printf '%s\n' "$BOLT_BUILD_OUTPUT" || true
  printf '%s\n' "$BOLT_BUILD_OUTPUT" | python3 -B /home/linhao/Toolchain/development/llvm-optimize/temp/bolt-v4-20261019-disk-diagnostics/export/clang-bolt-helper.py disk-diagnose ordinary-build /dev/stdin || true
  exit 1
fi

%install
cd build
# Reject debug-named buildroots before any BOLT action.
case $(printf '%s' '/home/linhao/rpmbuild/BUILDROOT/llvm-22.1.8-1.x86_64' | LC_ALL=C tr '[:upper:]' '[:lower:]') in
  *debug*) echo 'BOLT buildroot absolute path contains debug' >&2; exit 1 ;;
esac
BOLT_BUILD="$PWD"
BOLT_WORK="$PWD/clang-bolt"
BOLT_INSTALL_ROOT="/home/linhao/rpmbuild/BUILDROOT/llvm-22.1.8-1.x86_64"
BOLT_PROFILE_SOURCE="/home/linhao/Toolchain/development/llvm-optimize/temp/bolt-v4-20261019-disk-diagnostics/export/clang-bolt-v2.fdata.xz"
export BOLT_BUILD BOLT_WORK BOLT_INSTALL_ROOT BOLT_PROFILE_SOURCE
bolt_fail() {
  python3 -B /home/linhao/Toolchain/development/llvm-optimize/temp/bolt-v4-20261019-disk-diagnostics/export/clang-bolt-helper.py disk-diagnose "$1" "$2" || true
  exit 1
}
bolt_checked() {
  bolt_stage=$1
  bolt_log=$2
  shift 2
  if bolt_output=$("$@" 2>&1); then
    printf '%s\n' "$bolt_output" || bolt_fail "$bolt_stage-output" -
  else
    printf '%s\n' "$bolt_output" || true
    # The step transcript remains available in memory if its log cannot be written.
    printf '%s\n' "$bolt_output" | python3 -B /home/linhao/Toolchain/development/llvm-optimize/temp/bolt-v4-20261019-disk-diagnostics/export/clang-bolt-helper.py disk-diagnose "$bolt_stage" /dev/stdin || true
    exit 1
  fi
}
bolt_step() {
  bolt_stage=$1
  shift
  bolt_checked "$bolt_stage" "$BOLT_WORK/$bolt_stage.log" python3 -B /home/linhao/Toolchain/development/llvm-optimize/temp/bolt-v4-20261019-disk-diagnostics/export/clang-bolt-helper.py run-step "$bolt_stage" "$BOLT_WORK/$bolt_stage.log" -- "$@"
}
bolt_capture() {
  bolt_stage=$1
  bolt_output=$2
  shift 2
  bolt_checked "$bolt_stage" "$BOLT_WORK/$bolt_stage.log" python3 -B /home/linhao/Toolchain/development/llvm-optimize/temp/bolt-v4-20261019-disk-diagnostics/export/clang-bolt-helper.py run-step "$bolt_stage" "$BOLT_WORK/$bolt_stage.log" --output "$bolt_output" -- "$@"
}
# Observability only: sizes vary with this build, so no disk admission budget.
python3 -B /home/linhao/Toolchain/development/llvm-optimize/temp/bolt-v4-20261019-disk-diagnostics/export/clang-bolt-helper.py disk-report begin
bolt_step ordinary-install cmake -DCMAKE_INSTALL_PREFIX=/home/linhao/rpmbuild/BUILDROOT/llvm-22.1.8-1.x86_64/usr -P cmake_install.cmake
echo "BOLT_BUILDROOT_OK /home/linhao/rpmbuild/BUILDROOT/llvm-22.1.8-1.x86_64" || bolt_fail buildroot-output -
bolt_step preflight python3 -B /home/linhao/Toolchain/development/llvm-optimize/temp/bolt-v4-20261019-disk-diagnostics/export/clang-bolt-helper.py preflight
bolt_step certified python3 -B /home/linhao/Toolchain/development/llvm-optimize/temp/bolt-v4-20261019-disk-diagnostics/export/clang-bolt-helper.py certified
if [ -r /proc/self/stat ]; then echo BOLT_PROC_OK; else echo BOLT_PROC_MISSING; fi
# One relink: emit-relocs, then LLVM strip-debug, BOLT and full strip.
# The package build owns its original ThinLTO cache; do not duplicate it.
# File-list baseline is the actual ordinary CMake install, not a name whitelist.
bolt_step snapshot python3 -B /home/linhao/Toolchain/development/llvm-optimize/temp/bolt-v4-20261019-disk-diagnostics/export/clang-bolt-helper.py snapshot "/home/linhao/rpmbuild/BUILDROOT/llvm-22.1.8-1.x86_64" "$BOLT_WORK/install-before.json"
bolt_step manifest-copy cp install_manifest.txt "$BOLT_WORK/install-manifest-before.txt"
bolt_step ordinary-copy cp -p bin/clang-22 "$BOLT_WORK/ordinary-clang-22"
bolt_capture link-command "$BOLT_WORK/link.original" ninja -t commands -s bin/clang-22
bolt_step unpack python3 -B /home/linhao/Toolchain/development/llvm-optimize/temp/bolt-v4-20261019-disk-diagnostics/export/clang-bolt-helper.py unpack /home/linhao/Toolchain/development/llvm-optimize/temp/bolt-v4-20261019-disk-diagnostics/export/clang-bolt-v2.fdata.xz "$BOLT_WORK/profile.fdata"
bolt_step configure cmake -S ../llvm -B .   '-DLLVM_ENABLE_PROJECTS=clang;lldb;clang-tools-extra;lld;compiler-rt;openmp;bolt'   -DBOLT_BUILD_TOOLS=OFF -DBOLT_ENABLE_RUNTIME=OFF   -DBOLT_INCLUDE_TESTS=OFF -DBOLT_TARGETS_TO_BUILD=X86
# Only certified BOLT tasks and the paired configure-refreshed TF anchor.
echo BOLT_TOOL_DRY_RUN_BEGIN || bolt_fail dry-run-output -
LC_ALL=C NINJA_STATUS='[%f/%t] ' bolt_capture tool-dry-run "$BOLT_WORK/tool-dry-run.txt" ninja -n llvm-bolt
echo BOLT_TOOL_DRY_RUN_END || bolt_fail dry-run-output -
bolt_capture tool-plan "$BOLT_WORK/tool-plan.json" python3 -B /home/linhao/Toolchain/development/llvm-optimize/temp/bolt-v4-20261019-disk-diagnostics/export/clang-bolt-helper.py tool-plan "$BOLT_WORK/tool-dry-run.txt"
bolt_step tool-prepare python3 -B /home/linhao/Toolchain/development/llvm-optimize/temp/bolt-v4-20261019-disk-diagnostics/export/clang-bolt-helper.py tool-prepare "$PWD" "$BOLT_WORK/tool-plan.json" "$BOLT_WORK/tool-before.json"
LC_ALL=C NINJA_STATUS='[%f/%t] ' bolt_checked tool-build "$BOLT_WORK/tool-build.txt" python3 -B /home/linhao/Toolchain/development/llvm-optimize/temp/bolt-v4-20261019-disk-diagnostics/export/clang-bolt-helper.py run-step tool-build "$BOLT_WORK/tool-build.txt" --success-marker BOLT_NINJA_EXIT_0 -- ninja -j 1 llvm-bolt
bolt_step tool-verify python3 -B /home/linhao/Toolchain/development/llvm-optimize/temp/bolt-v4-20261019-disk-diagnostics/export/clang-bolt-helper.py tool-verify "$PWD" "$BOLT_WORK/tool-plan.json" "$BOLT_WORK/tool-build.txt"   "$BOLT_WORK/tool-before.json" "$BOLT_WORK/tool-build-verification.json"
python3 -B /home/linhao/Toolchain/development/llvm-optimize/temp/bolt-v4-20261019-disk-diagnostics/export/clang-bolt-helper.py disk-report tool-built
bolt_step pipeline python3 -B /home/linhao/Toolchain/development/llvm-optimize/temp/bolt-v4-20261019-disk-diagnostics/export/clang-bolt-helper.py pipeline "$PWD" "$BOLT_WORK" "$PWD/bin/llvm-bolt"
echo BOLT_PIPELINE_PASS || bolt_fail pipeline-output -
python3 -B /home/linhao/Toolchain/development/llvm-optimize/temp/bolt-v4-20261019-disk-diagnostics/export/clang-bolt-helper.py disk-report pipeline
# BOLT configuration/build/rewrite must not change the ordinary installation.
# Do not reinstall: that would add BOLT libraries, unregistered aliases and exports.
bolt_step compare-root python3 -B /home/linhao/Toolchain/development/llvm-optimize/temp/bolt-v4-20261019-disk-diagnostics/export/clang-bolt-helper.py compare-root "/home/linhao/rpmbuild/BUILDROOT/llvm-22.1.8-1.x86_64" "$BOLT_WORK/install-before.json"   "$BOLT_WORK/install-after-pipeline.json"
echo BOLT_COMPARE_ROOT_PASS || bolt_fail compare-root-output -
# Any subsequent buildroot mutation (including native archive conversion) must follow this gate.
bolt_step install-write-1 ln -sf /usr/bin/clang++ /home/linhao/rpmbuild/BUILDROOT/llvm-22.1.8-1.x86_64/usr/bin/clang++-22

bolt_step install-write-2 ln -sf clang /home/linhao/rpmbuild/BUILDROOT/llvm-22.1.8-1.x86_64/usr/bin/x86_64-pc-linux-gnu-clang
bolt_step install-write-3 ln -sf clang++ /home/linhao/rpmbuild/BUILDROOT/llvm-22.1.8-1.x86_64/usr/bin/x86_64-pc-linux-gnu-clang++
# Use host triple and resource dir by default via <lang>.cfg
bolt_step clang-config /bin/sh -c 'cat >> "$1"' sh /home/linhao/rpmbuild/BUILDROOT/llvm-22.1.8-1.x86_64//usr/bin/clang.cfg << EOF
-target x86_64-pc-linux-gnu
-resource-dir /usr/lib64/clang/22
EOF
bolt_step install-write-4 ln -sf clang.cfg /home/linhao/rpmbuild/BUILDROOT/llvm-22.1.8-1.x86_64//usr/bin/clang++.cfg

# copy lldb for sdk
bolt_step install-write-5 mkdir -p /home/linhao/rpmbuild/BUILDROOT/llvm-22.1.8-1.x86_64/home/owner/share/tmp/sdk_tools/lldb/bin
bolt_step install-write-6 mkdir -p /home/linhao/rpmbuild/BUILDROOT/llvm-22.1.8-1.x86_64/home/owner/share/tmp/sdk_tools/lldb/lib64

bolt_step install-write-7 mv /home/linhao/rpmbuild/BUILDROOT/llvm-22.1.8-1.x86_64/usr/bin/lldb /home/linhao/rpmbuild/BUILDROOT/llvm-22.1.8-1.x86_64/home/owner/share/tmp/sdk_tools/lldb/bin
bolt_step install-write-8 mv /home/linhao/rpmbuild/BUILDROOT/llvm-22.1.8-1.x86_64/usr/bin/lldb-argdumper /home/linhao/rpmbuild/BUILDROOT/llvm-22.1.8-1.x86_64/home/owner/share/tmp/sdk_tools/lldb/bin
bolt_step install-write-9 mv /home/linhao/rpmbuild/BUILDROOT/llvm-22.1.8-1.x86_64/usr/bin/lldb-server /home/linhao/rpmbuild/BUILDROOT/llvm-22.1.8-1.x86_64/home/owner/share/tmp/sdk_tools/lldb/bin

bolt_step install-write-10 ln -sf /home/owner/share/tmp/sdk_tools/lldb/bin/lldb /home/linhao/rpmbuild/BUILDROOT/llvm-22.1.8-1.x86_64/usr/bin/

bolt_step install-write-11 cp -P /home/linhao/rpmbuild/BUILDROOT/llvm-22.1.8-1.x86_64/usr/lib64/liblldb.so* /home/linhao/rpmbuild/BUILDROOT/llvm-22.1.8-1.x86_64/home/owner/share/tmp/sdk_tools/lldb/lib64/

# Install the clang python bits
bolt_step install-write-12 mkdir -p /home/linhao/rpmbuild/BUILDROOT/llvm-22.1.8-1.x86_64%{python3_sitelib}
bolt_step install-write-13 cp -a ../clang/bindings/python/clang /home/linhao/rpmbuild/BUILDROOT/llvm-22.1.8-1.x86_64%{python3_sitelib}/

bolt_step install-write-14 rm -rf /home/linhao/rpmbuild/BUILDROOT/llvm-22.1.8-1.x86_64/usr/lib64/debug/*
bolt_step install-write-15 rm -rf /home/linhao/rpmbuild/BUILDROOT/llvm-22.1.8-1.x86_64/usr/lib/libear/*
bolt_step install-write-16 rm -rf /home/linhao/rpmbuild/BUILDROOT/llvm-22.1.8-1.x86_64/usr/lib/libscanbuild/*

# Run after compilation has finished; these workers do not overlap build jobs.
# Preserve the standard RPM post-processing, including archive strip -g.
bolt_step install-write-17 rm -rf "/home/linhao/rpmbuild/BUILD/llvm-22.1.8/build/native-archive-conversion"
bolt_step install-write-18 python3 /home/linhao/Toolchain/development/llvm-optimize/temp/bolt-v4-20261019-disk-diagnostics/export/llvm-static-archives-native.py --root "/home/linhao/rpmbuild/BUILDROOT/llvm-22.1.8-1.x86_64" \
    --build "/home/linhao/rpmbuild/BUILD/llvm-22.1.8/build" \
    --evidence "/home/linhao/rpmbuild/BUILD/llvm-22.1.8/build/native-archive-conversion" \
    --arch x86_64 \
    --compiler "/home/linhao/rpmbuild/BUILD/llvm-22.1.8/build/bin/clang-22" \
    --disassembler "/home/linhao/rpmbuild/BUILD/llvm-22.1.8/build/bin/llvm-dis" \
    --nm "/home/linhao/rpmbuild/BUILD/llvm-22.1.8/build/bin/llvm-nm" \
    --jobs 4 --address-space-bytes 4294967296 || exit 1

# Candidate is fully stripped before the one unchanged platform post-processing chain.
# Capture in memory: a full work filesystem must not break logging after commit.
if BOLT_INSTALL_OUTPUT=$(python3 -B /home/linhao/Toolchain/development/llvm-optimize/temp/bolt-v4-20261019-disk-diagnostics/export/clang-bolt-helper.py install "/home/linhao/rpmbuild/BUILDROOT/llvm-22.1.8-1.x86_64" "$BOLT_WORK/clang.candidate" \
  "$BOLT_WORK/install-state.json" "$BOLT_WORK/identity.json" 2>&1); then
  printf '%s\n' "$BOLT_INSTALL_OUTPUT" || bolt_fail install-output -
else
  printf '%s\n' "$BOLT_INSTALL_OUTPUT" || true
  printf '%s\n' "$BOLT_INSTALL_OUTPUT" | python3 -B /home/linhao/Toolchain/development/llvm-optimize/temp/bolt-v4-20261019-disk-diagnostics/export/clang-bolt-helper.py disk-diagnose install /dev/stdin || true
  exit 1
fi

