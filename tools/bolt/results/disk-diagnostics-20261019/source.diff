+def filesystem(path):
+    path = Path(path).absolute()
+    while not path.exists():
+        path = path.parent
+    if not path.is_dir():
+        path = path.parent
+    return {'path': str(path), 'device': path.stat().st_dev,
+            'free_bytes': shutil.disk_usage(path).free, 'time_ns': time.time_ns()}
+
