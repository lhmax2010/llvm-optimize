+def live_session_members(sid):
+    require(proc_stat('/proc/self/stat')[0] == os.getpid(), 'PID namespace mismatch in /proc/self/stat')
+    members = []
+    try:
+        with os.scandir('/proc') as entries:
+            for entry in entries:
+                if not entry.name.isdecimal():
+                    continue
+                try:
+                    pid, state, pgrp, threads, session = proc_stat('/proc/'+entry.name+'/stat')
+                except (FileNotFoundError, ProcessLookupError):
+                    continue
+                if session == sid and (state not in ('Z', 'X') or threads > 1):
+                    members.append((pid, state))
+    except OSError as error:
+        raise GateError('cannot enumerate/read process session: '+str(error)) from error
+    return sorted(members)
+
+
+def wait_session_exit(sid, timeout=10, *, kill=False):
+    # The unreaped session leader pins the SID. Descendants that call setsid()
+    # themselves escape this session and are outside this tracking model.
+    deadline = time.monotonic()+timeout
+    while True:
+        members = live_session_members(sid)
+        if not members:
+            return
+        if kill:
+            # A job may have its own process group (e.g. ninja 1.13 jobs).
+            # Scan again after killing to catch forks during the previous scan.
+            for pid, state in members:
+                try:
+                    os.kill(pid, signal.SIGKILL)
+                except ProcessLookupError:
+                    pass
+        if time.monotonic() >= deadline:
+            raise LiveDescendantsError('process session %d still alive: %s' %
+                                       (sid, ', '.join('%d:%s' % item for item in members)))
+        time.sleep(.02)
+
+
+def kill_session(sid, timeout=10):
+    # Kill the leader's group even if a subsequent /proc scan fails.
+    try:
+        os.killpg(sid, signal.SIGKILL)
+    except ProcessLookupError:
+        pass
+    wait_session_exit(sid, timeout, kill=True)
+
