{"project":"platform/upstream/llvm","branch":"tizen_base","id":"I1c0d0bcccb1dc3c64efbb635e3e6f3de6748209e","number":359934,"subject":"packaging: classify -feliminate-unused-debug-types and mirror recorded backend policy","owner":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"url":"https://review.tizen.org/gerrit/c/platform/upstream/llvm/+/359934","hashtags":[],"createdOn":1793626936,"lastUpdated":1793793594,"open":true,"status":"NEW","comments":[{"timestamp":1793626936,"reviewer":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"message":"Uploaded patch set 1."},{"timestamp":1793627017,"reviewer":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"message":"Patch Set 1: Verified-1"},{"timestamp":1793627440,"reviewer":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"message":"Patch Set 2: Patch Set 1 was rebased\n\nCopied Votes:\n* Verified-1 (copy condition: \"**changekind:NO_CHANGE**\")\n"},{"timestamp":1793675638,"reviewer":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"message":"Uploaded patch set 3.\n\nOutdated Votes:\n* Verified-1 (copy condition: \"changekind:NO_CHANGE\")\n"},{"timestamp":1793682758,"reviewer":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"message":"Patch Set 4: Patch Set 3 was rebased"},{"timestamp":1793688550,"reviewer":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"message":"Uploaded patch set 5."},{"timestamp":1793688675,"reviewer":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"message":"Uploaded patch set 6."},{"timestamp":1793689188,"reviewer":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"message":"Uploaded patch set 7."},{"timestamp":1793745861,"reviewer":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"message":"Patch Set 7: Verified+1"},{"timestamp":1793754330,"reviewer":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"message":"Patch Set 7:\n\n(1 comment)"},{"timestamp":1793756163,"reviewer":{"name":"Juitem JoonWoo Kim","email":"jw1772.kim@samsung.com","username":"juitem"},"message":"Patch Set 7: Code-Review+1"},{"timestamp":1793770391,"reviewer":{"name":"Lin Hao","email":"hao.lin@samsung.com","username":"lhmax2025"},"message":"Patch Set 7:\n\n(5 comments)"},{"timestamp":1793793138,"reviewer":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"message":"Uploaded patch set 8: Commit message was updated.\n\nOutdated Votes:\n* Code-Review+1 (copy condition: \"changekind:NO_CHANGE OR is:MIN\")\n* Verified+1 (copy condition: \"changekind:NO_CHANGE\")\n"},{"timestamp":1793793160,"reviewer":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"message":"Uploaded patch set 9."},{"timestamp":1793793471,"reviewer":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"message":"Patch Set 9:\n\n(5 comments)"},{"timestamp":1793793594,"reviewer":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"message":"Uploaded patch set 10."}],"currentPatchSet":{"number":10,"revision":"13c3e223d9e1b35e4affb55255c5042f8c940f35","parents":["cf4b6777d056131e2534ecb460c5575327d99646"],"ref":"refs/changes/34/359934/10","uploader":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"createdOn":1793793594,"author":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"kind":"REWORK","sizeInsertions":60,"sizeDeletions":7},"patchSets":[{"number":1,"revision":"3791246ff68a4a31b675cabbe9d20d4245266ecc","parents":["9b8d74af825d3caab67f8ff7cbc19fcda8a7ad64"],"ref":"refs/changes/34/359934/1","uploader":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"createdOn":1793626936,"author":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"kind":"REWORK","approvals":[{"type":"Verified","description":"Verified","value":"-1","grantedOn":1793627017,"by":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"}}],"sizeInsertions":20,"sizeDeletions":0},{"number":2,"revision":"2f7d15af3956425d5f3a77da7b2548977f2826e6","parents":["aa58167dc9e6cfa0de90f0155022b5237f357d5b"],"ref":"refs/changes/34/359934/2","uploader":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"createdOn":1793627440,"author":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"kind":"NO_CHANGE","approvals":[{"type":"Verified","description":"Verified","value":"-1","grantedOn":1793627440,"by":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"}}],"sizeInsertions":20,"sizeDeletions":0},{"number":3,"revision":"7ae2cbac6eb5c6effed50b7d91cabf626f02b497","parents":["9b8d74af825d3caab67f8ff7cbc19fcda8a7ad64"],"ref":"refs/changes/34/359934/3","uploader":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"createdOn":1793675638,"author":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"kind":"REWORK","sizeInsertions":50,"sizeDeletions":7},{"number":4,"revision":"d761f94b8df6d4c495e9a67be8a7d694da0182f1","parents":["aa58167dc9e6cfa0de90f0155022b5237f357d5b"],"ref":"refs/changes/34/359934/4","uploader":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"createdOn":1793682758,"author":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"kind":"NO_CHANGE","sizeInsertions":50,"sizeDeletions":7},{"number":5,"revision":"8b95c173dcc4aca5c34ca01f8fe35a7af1648f03","parents":["9b8d74af825d3caab67f8ff7cbc19fcda8a7ad64"],"ref":"refs/changes/34/359934/5","uploader":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"createdOn":1793688550,"author":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"kind":"REWORK","sizeInsertions":52,"sizeDeletions":9},{"number":6,"revision":"27f41ab4edf7b48dc8529a533daaa76c7487fa4f","parents":["cf4b6777d056131e2534ecb460c5575327d99646"],"ref":"refs/changes/34/359934/6","uploader":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"createdOn":1793688675,"author":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"kind":"REWORK","sizeInsertions":50,"sizeDeletions":7},{"number":7,"revision":"463c9a133a6dfea9adf1e6c8e07ab705cbf2a587","parents":["cf4b6777d056131e2534ecb460c5575327d99646"],"ref":"refs/changes/34/359934/7","uploader":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"createdOn":1793689188,"author":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"kind":"REWORK","approvals":[{"type":"Verified","description":"Verified","value":"1","grantedOn":1793745861,"by":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"}},{"type":"Code-Review","description":"Code-Review","value":"1","grantedOn":1793756163,"by":{"name":"Juitem JoonWoo Kim","email":"jw1772.kim@samsung.com","username":"juitem"}}],"comments":[{"file":"/PATCHSET_LEVEL","line":0,"reviewer":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"message":"Builds are verified on QB\n- https://quickbuild.tizen.org/build/1216400\n- https://quickbuild.tizen.org/build/1216401"},{"file":"/PATCHSET_LEVEL","line":0,"reviewer":{"name":"Lin Hao","email":"hao.lin@samsung.com","username":"lhmax2025"},"message":"We would like to share our approach for your review. The two approaches can work together.\n\n**Our changes** (`sandbox/lhmax2025/bolt_pgo`, three commits on top of 67619ec8):\n1. d4d6ca16: hybrid linking\n2. f2553114: BOLT optimization of clang, with a matching debug symbol file in clang-debuginfo\n3. 9e39fa8a: fixed x86_64 build flags for LLVM, and release-mode support in the archive converter\n\n**How commit 3 handles 1214821**\n- LLVM no longer inherits the project-wide CFLAGS. CFLAGS/CXXFLAGS are fixed to the flag string that passed in QuickBuild 1215143 (Tizen-Base-Toolchain). Only the -march family of flags is taken from the project.\n- Any other project flag is removed, and the build log lists the removed flags. A flag outside the expected list produces a warning for manual review. -march\u003dnative / -mtune\u003dnative still fail the build.\n- This also covers -fno-inline-functions, which was the reason for f999bd40.\n- The spec passes the build mode to the converter (`--debug-info yes|no`). Every recorded command must match that mode. In release mode, a converted member that still has debug sections is rejected.\n\nAs a result, LLVM is built with the same flags in both projects, and the converter never sees project-specific tokens such as -feliminate-unused-debug-types or --param.\n\n**Verification**\n- QuickBuild passes in both projects with 9e39fa8a:\n  - Tizen-Base-Toolchain (debug): \u003cQB link\u003e\n  - Tizen-Base-Dev (release): \u003cQB link\u003e\n- Local full builds with the same build.conf and repositories also pass, and all in-build checks pass. From the local Base-Dev build log:\n\n```\nTIZEN_LLVM_DROPPED_FLAGS CFLAGS\u003d[-fno-inline-functions -Wl,-z,relro,--as-needed -feliminate-unused-debug-types --param\u003dssp-buffer-size\u003d4] CXXFLAGS\u003d[-fno-inline-functions -Wl,-z,relro,--as-needed -feliminate-unused-debug-types --param\u003dssp-buffer-size\u003d4] LDFLAGS\u003d[]\nNATIVE_ARCHIVES_END ... PASS 225\n```\n\nIn Base-Dev, all 3853 converted members have no debug sections. A package-by-package comparison against the previous build is still in progress.\n\n**Plan:** We will rebase our three commits onto this change. We will keep your token classification and per-switch replay, and add the checks described in the inline comments. Two of the inline comments are changes we would like to see in this patch; the third is optional.\n\nCould you also take a look at the fixed-flags approach in 9e39fa8a？\n\nBranch: https://review.tizen.org/gerrit/gitweb?p\u003dplatform/upstream/llvm.git;a\u003dshortlog;h\u003drefs/heads/sandbox/lhmax2025/bolt_pgo"},{"file":"packaging/llvm-static-archives-native.py","line":216,"reviewer":{"name":"Lin Hao","email":"hao.lin@samsung.com","username":"lhmax2025"},"message":"Minor, optional: Clang only acts on --param ssp-buffer-size\u003dN. It becomes -stack-protector-buffer-size and then a function attribute, so it is already in the IR. Clang ignores other --param values (clang/lib/Driver/ToolChains/Clang.cpp, RenderSSPOptions, LLVM 22 lines 3465-3474). To keep the converter fail-closed for unknown tokens, we suggest accepting only ssp-buffer-size\u003d\u003cdigits\u003e and rejecting other --param values. This comment handles the \"--param X\" form; the next comment handles \"--param\u003dX\".\n\n```suggestion\n            if index+1 \u003d\u003d len(argv) or argv[index+1].startswith(\u0027-\u0027):\n                raise ValueError(\u0027missing operand for \u0027+token)\n            if token \u003d\u003d \u0027--param\u0027 and not re.fullmatch(r\u0027ssp-buffer-size\u003d\\d+\u0027, argv[index+1]):\n                raise ValueError(\u0027unclassified --param value: \u0027+argv[index+1])\n            category, reason \u003d \u0027irrelevant\u0027, \u0027preprocessing, driver resource, output or language operand\u0027\n```"},{"file":"packaging/llvm-static-archives-native.py","line":216,"reviewer":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"message":"Done"},{"file":"packaging/llvm-static-archives-native.py","line":246,"reviewer":{"name":"Lin Hao","email":"hao.lin@samsung.com","username":"lhmax2025"},"message":"Same as the previous comment, for the \"--param\u003dX\" form: only ssp-buffer-size\u003d\u003cdigits\u003e is accepted, and it is removed from the generic prefix list, so that other values are reported as unclassified.\n\n```suggestion\n        elif token \u003d\u003d \u0027-flto\u003dthin\u0027:\n            category, reason \u003d \u0027irrelevant\u0027, \u0027pre-link bitcode format already materialized; never replay LTO\u0027\n        elif re.fullmatch(r\u0027--param\u003dssp-buffer-size\u003d\\d+\u0027, token):\n            category, reason \u003d \u0027ir\u0027, \u0027stack-protector-buffer-size function attribute already in the IR\u0027\n        elif (token.startswith((\u0027-W\u0027, \u0027-D\u0027, \u0027-I\u0027, \u0027--target\u003d\u0027, \u0027-fmessage-length\u003d\u0027,\n```"},{"file":"packaging/llvm-static-archives-native.py","line":246,"reviewer":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"message":"Done"},{"file":"packaging/llvm-static-archives-native.py","line":260,"reviewer":{"name":"Lin Hao","email":"hao.lin@samsung.com","username":"lhmax2025"},"message":"The commit message says the -gdwarf-4 requirement is kept \"when debug options are present (fail-closed)\", but this check only runs when a -gdwarf-N token is recorded. A command that records only -g or -g2 passes the check, and is then replayed without -g. Suggest checking for any -g option:\n\n```suggestion\n    has_debug_options \u003d any(token.startswith(\u0027-g\u0027) for token in argv)\n    if has_debug_options and (not dwarfs or dwarfs[-1] !\u003d \u0027-gdwarf-4\u0027):\n        raise ValueError(\u0027uncertified last DWARF option: \u0027+str(dwarfs[-1:] or \u0027missing\u0027))\n```"},{"file":"packaging/llvm-static-archives-native.py","line":260,"reviewer":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"message":"Done"},{"file":"packaging/llvm-static-archives-native.py","line":663,"reviewer":{"name":"Lin Hao","email":"hao.lin@samsung.com","username":"lhmax2025"},"message":"Since -g is now decided per member, it would be good to check the output as well. The backend still emits DWARF whenever the input IR carries debug metadata, even if -g is not passed; we confirmed this with a release member that had debug metadata injected. So if the replay used no debug options, the converted object should have no debug sections:\n\n```suggestion\n                data \u003d target.read_bytes()\n                if settings[\u0027policy\u0027][\u0027dwarf\u0027] is None and elf_details(data)[1]:\n                    raise ValueError(\u0027release conversion unexpectedly emitted debug sections\u0027)\n                relocs \u003d pic_relocations(data)\n```"},{"file":"packaging/llvm-static-archives-native.py","line":663,"reviewer":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"message":"Done"}],"sizeInsertions":52,"sizeDeletions":9},{"number":8,"revision":"4b2ae324d8d47eb99a08a5a7896871e5f1326565","parents":["cf4b6777d056131e2534ecb460c5575327d99646"],"ref":"refs/changes/34/359934/8","uploader":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"createdOn":1793793138,"author":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"kind":"NO_CODE_CHANGE","sizeInsertions":55,"sizeDeletions":9},{"number":9,"revision":"d24ec0feea1b65adfdbb89a5152fd7a3e15dd263","parents":["cf4b6777d056131e2534ecb460c5575327d99646"],"ref":"refs/changes/34/359934/9","uploader":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"createdOn":1793793160,"author":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"kind":"REWORK","comments":[{"file":"/PATCHSET_LEVEL","line":0,"reviewer":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"message":"Thanks for sharing the approach. The fixed-flags design in 9e39a8a looks reasonable — the converter never seeing project-specific tokens is a cleaner fix at the source. PS9 already covers the inline-comment checks (–param restricted to ssp-buffer-size, -g/-gdwarf-4 fail-closed, and post-conversion debug-section rejection), so they\u0027re ready for your rebase. I\u0027ll take a closer look at 9e39a8a and report back."}],"sizeInsertions":60,"sizeDeletions":7},{"number":10,"revision":"13c3e223d9e1b35e4affb55255c5042f8c940f35","parents":["cf4b6777d056131e2534ecb460c5575327d99646"],"ref":"refs/changes/34/359934/10","uploader":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"createdOn":1793793594,"author":{"name":"Dongkyun Son","email":"dongkyun.s@samsung.com","username":"dkson95"},"kind":"REWORK","sizeInsertions":60,"sizeDeletions":7}]}
