%clean

%post -p /sbin/ldconfig

%postun -p /sbin/ldconfig

# ==========================================================
# files section
# ==========================================================
%files
%manifest %{name}.manifest
%license LICENSE-APACHE
%license LICENSE-MIT
%{_rust_dylibdir}/lib%{real_crate_name}.so
