# Generated by rust2rpm 23
%global _rpm_strip_disable 1
%global debug_package %{nil}

%global crate static_assertions
%global real_crate_name static_assertions
%global rustc_edition 2015

Name:           rust-static_assertions
Version:        1.1.0
Release:        1
Summary:        Compile-time assertions to ensure that invariants are met

License:        MIT OR Apache-2.0
URL:            https://crates.io/crates/static_assertions
Source:         %{crate}-%{version}.tar.gz
Source1:        %{name}.manifest
