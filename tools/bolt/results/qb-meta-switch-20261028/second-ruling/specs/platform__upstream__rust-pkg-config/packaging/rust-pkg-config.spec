# Generated by rust2rpm 23
%global _rpm_strip_disable 1
%global debug_package %{nil}

%global crate pkg-config
%global real_crate_name pkg_config
%global rustc_edition 2015

Name:           rust-pkg-config
Version:        0.3.26
Release:        1
Summary:        Library to run the pkg-config system tool at build time in order to be used in Cargo build scripts

License:        MIT OR Apache-2.0
URL:            https://crates.io/crates/pkg-config
Source:         %{crate}-%{version}.tar.gz
Source1:        %{name}.manifest

# ==========================================================
# BuildRequires
# specifies build-time dependencies for the package
# ==========================================================
BuildRequires:  rust

# ==========================================================
# dev-dependencies
# ==========================================================
# BuildRequires:  rust-lazy_static 


%description
Library to run the pkg-config system tool at build time in order to be used in
Cargo build scripts.

%prep
%setup -q
cp %{SOURCE1} .

# ==========================================================
# build section
# crate-type : dylib, proc-macro, cdylib, bin, etc.
# ==========================================================
%build
 %{rustc_std_build} --crate-type=dylib \
         --crate-name=%{real_crate_name} \
         %{?rustc_edition:--edition=%{rustc_edition}} \
         ./src/lib.rs

%check
%if 0%{?run_tests}
 %{rustc_std_build} --test --crate-type=dylib \
         --crate-name=%{real_crate_name} \
         %{?rustc_edition:--edition=%{rustc_edition}} \
         ./src/lib.rs

./%{real_crate_name}
%endif

# ==========================================================
# install section
# ==========================================================
%install
 install -d -m 0755 %{buildroot}%{_rust_dylibdir}
 install -m 0644 lib%{real_crate_name}.so %{buildroot}/%{_rust_dylibdir}/lib%{real_crate_name}.so

%clean

%post -p /sbin/ldconfig

%postun -p /sbin/ldconfig

# ==========================================================
# files section
# ==========================================================
%files
%manifest %{name}.manifest
 %license LICENSE-APACHE
 %license LICENSE-MIT
 %{_rust_dylibdir}/lib%{real_crate_name}.so
