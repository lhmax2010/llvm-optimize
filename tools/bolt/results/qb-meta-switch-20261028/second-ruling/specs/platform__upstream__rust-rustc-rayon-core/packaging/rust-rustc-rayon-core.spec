# Generated by rust2rpm 23
%global _rpm_strip_disable 1
%global debug_package %{nil}

%global crate rustc-rayon-core
%global real_crate_name rustc_rayon_core
%global rustc_edition 2018

Name:           rust-rustc-rayon-core
Version:        0.4.1
Release:        1
Summary:        Core APIs for Rayon - fork for rustc

License:        MIT OR Apache-2.0
URL:            https://crates.io/crates/rustc-rayon-core
Source:         %{crate}-%{version}.tar.gz
Source1:        %{name}.manifest

# ==========================================================
# BuildRequires
# specifies build-time dependencies for the package
# ==========================================================
BuildRequires:  rust
BuildRequires:  rust-crossbeam-channel
BuildRequires:  rust-crossbeam-deque
BuildRequires:  rust-crossbeam-utils
BuildRequires:  rust-num_cpus

# ==========================================================
# dev-dependencies
# ==========================================================
%if 0%{?run_tests}
# BuildRequires:  rust-libc 
BuildRequires:  rust-rand 
BuildRequires:  rust-rand_xorshift 
# BuildRequires:  rust-scoped-tls 
%endif

%description
Core APIs for Rayon - fork for rustc.

%prep
%setup -q
cp %{SOURCE1} .

# ==========================================================
# build section
# crate-type : dylib, proc-macro, cdylib, bin, etc.
# ==========================================================
%build
%{rustc_std_build} --crate-type=dylib \
        --crate-name=%{real_crate_name} \
        %{?rustc_edition:--edition=%{rustc_edition}} \
        %rust_dylib_extern crossbeam_channel \
        %rust_dylib_extern crossbeam_deque \
        %rust_dylib_extern crossbeam_utils \
        %rust_dylib_extern num_cpus \
        ./src/lib.rs

%check
%if 0%{?run_tests}
%{rustc_std_build} --test --crate-type=dylib \
        --crate-name=%{real_crate_name} \
        %{?rustc_edition:--edition=%{rustc_edition}} \
        %rust_dylib_extern crossbeam_channel \
        %rust_dylib_extern crossbeam_deque \
        %rust_dylib_extern crossbeam_utils \
        %rust_dylib_extern num_cpus \
        %rust_dylib_extern rand \
        %rust_dylib_extern rand_xorshift \
        ./src/lib.rs

./%{real_crate_name}
%endif
# ==========================================================
# install section
# ==========================================================
%install
 install -d -m 0755 %{buildroot}%{_rust_dylibdir}
 install -m 0644 lib%{real_crate_name}.so %{buildroot}/%{_rust_dylibdir}/lib%{real_crate_name}.so

%clean

%post -p /sbin/ldconfig

%postun -p /sbin/ldconfig

# ==========================================================
# files section
# ==========================================================
%files
%manifest %{name}.manifest
 %license LICENSE-APACHE
 %license LICENSE-MIT
 %{_rust_dylibdir}/lib%{real_crate_name}.so
