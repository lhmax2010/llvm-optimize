# Generated by rust2rpm 23
%global _rpm_strip_disable 1
%global debug_package %{nil}

%global crate system-deps
%global real_crate_name system_deps
%global rustc_edition 2018

Name:           rust-system-deps
Version:        6.0.4
Release:        1
Summary:        Discover and configure system dependencies from declarative dependencies in Cargo.toml

License:        MIT OR Apache-2.0
URL:            https://crates.io/crates/system-deps
Source:         %{crate}-%{version}.tar.gz
Source1:        %{name}.manifest

# ==========================================================
# BuildRequires
# specifies build-time dependencies for the package
# ==========================================================
BuildRequires:  rust
BuildRequires:  rust-cfg-expr
BuildRequires:  rust-heck
BuildRequires:  rust-pkg-config
BuildRequires:  rust-toml
BuildRequires:  rust-version-compare

Requires:       rust-cfg-expr
Requires:       rust-heck
Requires:       rust-pkg-config
Requires:       rust-toml
Requires:       rust-version-compare

# ==========================================================
# dev-dependencies
# ==========================================================
%if 0%{?run_tests}
BuildRequires:  rust-assert_matches 
BuildRequires:  rust-itertools 
BuildRequires:  rust-lazy_static 
%endif


%description
Discover and configure system dependencies from declarative dependencies in
Cargo.toml.

%prep
%setup -q
cp %{SOURCE1} .

# ==========================================================
# build section
# crate-type : dylib, proc-macro, cdylib, bin, etc.
# ==========================================================
%build
%{rustc_std_build} --crate-type=dylib \
        --crate-name=%{real_crate_name} \
        %{?rustc_edition:--edition=%{rustc_edition}} \
        %rust_dylib_extern toml \
        %rust_dylib_extern heck \
        %rust_dylib_extern cfg_expr \
        %rust_dylib_extern pkg_config \
        %rust_dylib_extern version_compare \
        ./src/lib.rs

# ==========================================================
# install section
# ==========================================================
%install
install -d -m 0755 %{buildroot}%{_rust_dylibdir}
install -m 0644 lib%{real_crate_name}.so %{buildroot}/%{_rust_dylibdir}/lib%{real_crate_name}.so

%check
%if 0%{?run_tests}
%{rustc_std_build} --test --crate-type=dylib \
        --crate-name=%{real_crate_name} \
        %{?rustc_edition:--edition=%{rustc_edition}} \
        %rust_dylib_extern toml \
        %rust_dylib_extern heck \
        %rust_dylib_extern cfg_expr \
        %rust_dylib_extern pkg_config \
        %rust_dylib_extern version_compare \
        %rust_dylib_extern itertools \
        %rust_dylib_extern lazy_static \
        %rust_dylib_extern assert_matches \
        ./src/lib.rs

./%{real_crate_name}
%endif

%clean

%post -p /sbin/ldconfig

%postun -p /sbin/ldconfig

# ==========================================================
# files section
# ==========================================================
%files
%manifest %{name}.manifest
%license LICENSE-APACHE
%license LICENSE-MIT
%{_rust_dylibdir}/lib%{real_crate_name}.so
