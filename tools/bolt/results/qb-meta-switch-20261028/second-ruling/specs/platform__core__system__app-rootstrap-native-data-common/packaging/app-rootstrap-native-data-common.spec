%prep
%setup -q

%build

%install
rm -rf %{buildroot}
mkdir -p %{buildroot}/tmp/rs_resource

# Save public file list
cp -R ./rs_resource_public/. %{buildroot}/tmp/rs_resource/
find %{buildroot}/tmp/rs_resource -type f | sed "s|%{buildroot}||" | sort > public_files.txt

# Save internal file list
cp -R ./rs_resource_internal/. %{buildroot}/tmp/rs_resource/
find %{buildroot}/tmp/rs_resource -type f | sed "s|%{buildroot}||" | sort > all_files.txt
comm -13 public_files.txt all_files.txt > internal_files.txt

%files -n app-rootstrap-native-data-public -f public_files.txt
%defattr(-,root,root,-)

%files -n app-rootstrap-native-data-internal -f internal_files.txt
%defattr(-,root,root,-)
