# Generated by rust2rpm 23
%global _rpm_strip_disable 1
%global debug_package %{nil}

%global crate concolor
%global real_crate_name concolor
%global rustc_edition 2021

Name:           rust-concolor
Version:        0.1.1
Release:        1
Summary:        Control console coloring across all dependencies

License:        MIT OR Apache-2.0
URL:            https://crates.io/crates/concolor
Source:         %{crate}-%{version}.tar.gz
Source1:        %{name}.manifest

# ==========================================================
# BuildRequires
# specifies build-time dependencies for the package
# ==========================================================
BuildRequires:  rust
BuildRequires:  rust-bitflags
BuildRequires:  rust-concolor-override
BuildRequires:  rust-concolor-query
BuildRequires:  rust-is-terminal



%description
Control console coloring across all dependencies.

%prep
%setup -q
cp %{SOURCE1} .

# ==========================================================
# build section
# crate-type : dylib, proc-macro, cdylib, bin, etc.
# ==========================================================
%build
%{rustc_std_build} --crate-type=dylib \
        --crate-name=%{real_crate_name} \
        %{?rustc_edition:--edition=%{rustc_edition}} \
        --cfg='feature="std"' \
        ./src/lib.rs

# ==========================================================
# install section
# ==========================================================
%install
install -d -m 0755 %{buildroot}%{_rust_dylibdir}
install -m 0644 lib%{real_crate_name}.so %{buildroot}/%{_rust_dylibdir}/lib%{real_crate_name}.so

%check
%if 0%{?run_tests}
%{rustc_std_build} --test --crate-type=dylib \
        --crate-name=%{real_crate_name} \
        %{?rustc_edition:--edition=%{rustc_edition}} \
        --cfg='feature="std"' \
        ./src/lib.rs

./%{real_crate_name}
%endif

%clean

%post -p /sbin/ldconfig

%postun -p /sbin/ldconfig

# ==========================================================
# files section
# ==========================================================
%files
%manifest %{name}.manifest
%license LICENSE-APACHE
%license LICENSE-MIT
