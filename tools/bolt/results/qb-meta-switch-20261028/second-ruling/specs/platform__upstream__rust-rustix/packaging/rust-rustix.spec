# Generated by rust2rpm 23
%global _rpm_strip_disable 1
%global debug_package %{nil}

%global crate rustix
%global real_crate_name rustix
%global rustc_edition 2018

Name:           rust-rustix
Version:        0.36.8
Release:        1
Summary:        Safe Rust bindings to POSIX/Unix/Linux/Winsock2-like syscalls

License:        Apache-2.0 WITH LLVM-exception OR Apache-2.0 OR MIT
URL:            https://crates.io/crates/rustix
Source:         %{crate}-%{version}.tar.gz
Source1:        %{name}.manifest

# ==========================================================
# BuildRequires
# specifies build-time dependencies for the package
# ==========================================================
BuildRequires:  rust
BuildRequires:  rust-libc
BuildRequires:  rust-bitflags
BuildRequires:  rust-errno
BuildRequires:  rust-io-lifetimes
BuildRequires:  rust-itoa
BuildRequires:  rust-linux-raw-sys
BuildRequires:  rust-once_cell
BuildRequires:  rust-rustc-std-workspace-alloc
Requires:  rust-libc
Requires:  rust-bitflags
Requires:  rust-errno
Requires:  rust-io-lifetimes
Requires:  rust-itoa
Requires:  rust-linux-raw-sys
Requires:  rust-once_cell


%description
Safe Rust bindings to POSIX/Unix/Linux/Winsock2-like syscalls.

%prep
%setup -q
cp %{SOURCE1} .

# ==========================================================
# build section
# crate-type : dylib, proc-macro, cdylib, bin, etc.
# ==========================================================
%build
%{rustc_std_build} --crate-type=dylib \
        --crate-name=%{real_crate_name} \
        %{?rustc_edition:--edition=%{rustc_edition}} \
        --extern libc_errno=%{_rust_dylibdir}/liberrno.so \
        %rust_dylib_extern libc \
        %rust_dylib_extern bitflags \
        %rust_dylib_extern io_lifetimes \
        %rust_dylib_extern itoa \
        %rust_dylib_extern linux_raw_sys \
        %rust_dylib_extern once_cell \
        --cfg=libc \
        --cfg='feature="std"' \
        --cfg='feature="fs"' \
        --cfg='feature="mm"' \
        --cfg='feature="net"' \
        --cfg='feature="param"' \
        --cfg='feature="process"' \
        --cfg='feature="rand"' \
        --cfg='feature="runtime"' \
        --cfg='feature="termios"' \
        --cfg='feature="thread"' \
        --cfg='feature="time"' \
        ./src/lib.rs

# ==========================================================
# install section
# ==========================================================
%install
install -d -m 0755 %{buildroot}%{_rust_dylibdir}
install -m 0644 lib%{real_crate_name}.so %{buildroot}/%{_rust_dylibdir}/lib%{real_crate_name}.so

%clean

%post -p /sbin/ldconfig

%postun -p /sbin/ldconfig

# ==========================================================
# files section
# ==========================================================
%files
%manifest %{name}.manifest
%license LICENSE-APACHE
%license LICENSE-MIT
%license LICENSE-Apache-2.0_WITH_LLVM-exception
%{_rust_dylibdir}/lib%{real_crate_name}.so
