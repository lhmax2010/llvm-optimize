# Generated by rust2rpm 23
%global _rpm_strip_disable 1
%global debug_package %{nil}

%global crate rustc-rayon
%global real_crate_name rustc_rayon
%global rustc_edition 2018

Name:           rust-rustc-rayon
Version:        0.4.0
Release:        1
Summary:        Simple work-stealing parallelism for Rust - fork for rustc

License:        MIT OR Apache-2.0
URL:            https://crates.io/crates/rustc-rayon
Source:         %{crate}-%{version}.tar.gz
Source1:        %{name}.manifest

# ==========================================================
# BuildRequires
# specifies build-time dependencies for the package
# ==========================================================
BuildRequires:  rust
BuildRequires:  rust-autocfg
BuildRequires:  rust-crossbeam-deque
BuildRequires:  rust-either
BuildRequires:  rust-rustc-rayon-core
BuildRequires:  rust-rayon-core

# ==========================================================
# dev-dependencies
# ==========================================================
# BuildRequires:  rust-docopt 
# BuildRequires:  rust-lazy_static 
# BuildRequires:  rust-rand 
# BuildRequires:  rust-rand_xorshift 
# BuildRequires:  rust-serde 


%description
Simple work-stealing parallelism for Rust - fork for rustc.

%prep
%setup -q
cp %{SOURCE1} .

# ==========================================================
# build section
# crate-type : dylib, proc-macro, cdylib, bin, etc.
# ==========================================================
%build
 %{rustc_std_build} --crate-type=dylib \
         --crate-name=%{real_crate_name} \
         %{?rustc_edition:--edition=%{rustc_edition}} \
         %rust_dylib_extern rayon_core \
         %rust_dylib_extern crossbeam_deque \
         %rust_dylib_extern either \
         ./src/lib.rs

# ==========================================================
# install section
# ==========================================================
%install
 install -d -m 0755 %{buildroot}%{_rust_dylibdir}
 install -m 0644 lib%{real_crate_name}.so %{buildroot}/%{_rust_dylibdir}/lib%{real_crate_name}.so

%clean

%post -p /sbin/ldconfig

%postun -p /sbin/ldconfig

# ==========================================================
# files section
# ==========================================================
%files
%manifest %{name}.manifest
 %license LICENSE-APACHE
 %license LICENSE-MIT
 %{_rust_dylibdir}/lib%{real_crate_name}.so
