%global _rpm_strip_disable 1
%global debug_package %{nil}

%global crate crossbeam-utils
%global real_crate_name crossbeam_utils
%global rustc_edition 2018

Name:           rust-crossbeam-utils
Version:        0.8.15
Release:        1
Summary:        Utilities for concurrent programming

License:        MIT OR Apache-2.0
URL:            https://crates.io/crates/crossbeam-utils
Source:         %{crate}-%{version}.tar.gz
Source1:        %{name}.manifest

# ==========================================================
# BuildRequires
# specifies build-time dependencies for the package
# ==========================================================
BuildRequires:  rust
BuildRequires:  rust-cfg-if

Requires:       rust-cfg-if

# ==========================================================
# dev-dependencies
# ==========================================================
%if 0%{?run_tests}
BuildRequires:  rust-rustversion 
BuildRequires:  rust-rand 
%endif


%description
Utilities for concurrent programming.

%prep
%setup -q
cp %{SOURCE1} .

# ==========================================================
# build section
# crate-type : dylib, proc-macro, cdylib, bin, etc.
# ==========================================================
%build
%{rustc_std_build} --crate-type=dylib \
        --crate-name=%{real_crate_name} \
        %{?rustc_edition:--edition=%{rustc_edition}} \
        %rust_dylib_extern cfg_if \
        --cfg='feature="std"' \
        ./src/lib.rs

# ==========================================================
# install section
# ==========================================================
%install
install -d -m 0755 %{buildroot}%{_rust_dylibdir}
install -m 0644 lib%{real_crate_name}.so %{buildroot}/%{_rust_dylibdir}/lib%{real_crate_name}.so

%check
%if 0%{?run_tests}
export unit_test_list="atomic_cell cache_padded parker sharded_lock thread wait_group"
for unit_test in ${unit_test_list}
do
%{rustc_std_build} --test --crate-type=dylib \
        --crate-name=${unit_test} \
        %{?rustc_edition:--edition=%{rustc_edition}} \
        %rust_dylib_extern cfg_if \
        %rust_dylib_extern rustversion \
        %rust_dylib_extern rand \
        --cfg='feature="std"' \
        --extern %{real_crate_name}=./lib%{real_crate_name}.so \
        ./tests/${unit_test}.rs
done

for unit_test in ${unit_test_list}
do
./${unit_test}
done
%endif

%clean

%post -p /sbin/ldconfig

%postun -p /sbin/ldconfig

