# Generated by rust2rpm 23
%global _rpm_strip_disable 1
%global debug_package %{nil}

%global crate libxml
%global real_crate_name libxml
%global rustc_edition 2021

Name:           rust-libxml
Version:        0.3.3
Release:        1
Summary:        Rust wrapper for libxml2 - the XML C parser and toolkit developed for the Gnome project

License:        MIT
URL:            https://crates.io/crates/libxml
Source:         %{crate}-%{version}.tar.gz
Source1:        %{name}.manifest

# ==========================================================
# BuildRequires
# specifies build-time dependencies for the package
# ==========================================================
BuildRequires:  rust
BuildRequires:  rust-libc
BuildRequires:  rust-pkg-config

BuildRequires:  libxml2-devel
Requires:       libxml2-devel
# ==========================================================
# dev-dependencies
# ==========================================================
%if 0%{?run_tests}
BuildRequires:  rust-criterion 
BuildRequires:  rust-rayon 
%endif


%description
Rust wrapper for libxml2 - the XML C parser and toolkit developed for the Gnome
project.

%prep
%setup -q
cp %{SOURCE1} .

# ==========================================================
# build section
# crate-type : dylib, proc-macro, cdylib, bin, etc.
# ==========================================================
%build
%{rustc_std_build} --crate-type=dylib \
        --crate-name=%{real_crate_name} \
        %{?rustc_edition:--edition=%{rustc_edition}} \
        -L%{_libdir} -lxml2 \
        %rust_dylib_extern libc \
        ./src/lib.rs

%check
%if 0%{?run_tests}
export unit_test_list="base_tests codec_tests mutability_guards readonly_tests schema_tests tree_tests xpath_tests"
for unit_test in ${unit_test_list}
do
%{rustc_std_build} --test \
        --crate-name=${unit_test} \
        %{?rustc_edition:--edition=%{rustc_edition}} \
        --extern %{real_crate_name}=./lib%{real_crate_name}.so \
        %rust_dylib_extern libc \
        ./tests/${unit_test}.rs

done

for unit_test in ${unit_test_list}
do
./${unit_test}
done
%endif
# ==========================================================
# install section
# ==========================================================
%install
install -d -m 0755 %{buildroot}%{_rust_dylibdir}
install -m 0644 lib%{real_crate_name}.so %{buildroot}/%{_rust_dylibdir}/lib%{real_crate_name}.so

%clean

%post -p /sbin/ldconfig

%postun -p /sbin/ldconfig

# ==========================================================
# files section
# ==========================================================
%files
%manifest %{name}.manifest
%license LICENSE
%{_rust_dylibdir}/lib%{real_crate_name}.so
