%global _rpm_strip_disable 1
%global debug_package %{nil}

%global crate tiny-keccak
%global real_crate_name tiny_keccak
%global rustc_edition 2018

Name:           rust-tiny-keccak
Version:        2.0.2
Release:        1
Summary:        Implementation of Keccak derived functions

License:        CC0-1.0
URL:            https://crates.io/crates/tiny-keccak
Source:         %{crate}-%{version}.tar.gz
