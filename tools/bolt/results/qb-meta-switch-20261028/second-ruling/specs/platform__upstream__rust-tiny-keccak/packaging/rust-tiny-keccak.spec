        --cfg='feature="shake"' \
        --cfg='feature="sha3"' \
        --cfg='feature="cshake"' \
        --cfg='feature="kmac"' \
        --cfg='feature="tuple_hash"' \
        --cfg='feature="parallel_hash"' \
        --cfg='feature="k12"' \
