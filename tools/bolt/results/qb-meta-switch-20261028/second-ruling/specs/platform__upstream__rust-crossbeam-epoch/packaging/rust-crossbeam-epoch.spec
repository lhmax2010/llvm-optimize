        %{?rustc_edition:--edition=%{rustc_edition}} \
        --cfg='feature="std"' \
        --cfg='feature="alloc"' \
        --cfg='feature="crossbeam_loom"' \
        %rust_dylib_extern cfg_if \
        ./src/lib.rs

# ==========================================================
# install section
# ==========================================================
