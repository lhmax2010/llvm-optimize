        <package repo="profile/mobile/apps/native/ug-setting-notification-efl"/>
        <package repo="profile/mobile/apps/native/video-player"/>
        <package repo="profile/mobile/apps/native/wallpaper-ui-service"/>
        <package repo="profile/mobile/apps/native/email-app"/>
