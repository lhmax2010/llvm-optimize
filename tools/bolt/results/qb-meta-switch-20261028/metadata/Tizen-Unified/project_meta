    </abs>
    <abs>
      <branch source="tizen" output="tizen_tizeniot_tpk"/>
      <rootstrap url="ABS/TIZEN/Tizen/Tizen-Unified/latest/"/>
      <packages>
        <package repo="profile/iot/apps/native/homescreen-efl"/>
