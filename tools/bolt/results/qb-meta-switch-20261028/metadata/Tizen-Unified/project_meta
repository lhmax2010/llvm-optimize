    </abs>
    <abs>
      <branch source="tizen" output="tizen_wearable_tpk"/>
      <rootstrap url="ABS/TIZEN/Tizen/Tizen-Unified/latest/"/>
      <packages>
        <package repo="profile/wearable/apps/native/apptray-widget"/>
        <package repo="profile/wearable/apps/native/call-setting"/>
