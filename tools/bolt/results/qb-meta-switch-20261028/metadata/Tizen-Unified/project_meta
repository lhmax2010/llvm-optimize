<project name="Tizen-Unified">
  <debuginfo>
    <enable/>
  </debuginfo>
  <repository name="standard">
    <arch name="armv7l"/>
    <arch name="aarch64"/>
    <arch name="x86_64"/>
    <image name="tizen-aarch64-generic-hal.ks"/>
    <image name="tizen-armv7l-generic-hal.ks"/>
    <image name="tizen-boot-aarch64-c4.ks"/>
    <image name="tizen-boot-aarch64-vim3.ks"/>
    <image name="tizen-boot-aarch64-rpi.ks"/>
    <image name="tizen-boot-aarch64-rpi-rt.ks"/>
    <image name="tizen-boot-aarch64-rubikpi3.ks"/>
    <image name="tizen-boot-aarch64-orinnano.ks"/>
    <image name="tizen-boot-armv7l-rpi.ks"/>
    <image name="tizen-boot-armv7l-rpi-rt.ks"/>
    <image name="tizen-headed-aarch64.ks"/>
    <image name="tizen-headed-armv7l.ks"/>
    <image name="tizen-headless-aarch64.ks"/>
    <image name="tizen-headless-armv7l.ks"/>
  </repository>
  <repository name="standard_gcov" reference="standard">
    <arch name="armv7l"/>
  </repository>
  <repository name="emulator">
    <arch name="x86_64"/>
    <image name="tizen-headed-emulator64-wayland.ks"/>
  </repository>
  <branch_candidate name="tizen">
    <default/>
    <org name="">
      <branch name="tizen"/>
      <branch name="tizen_mobile_tpk"/>
      <branch name="tizen_wearable_tpk"/>
      <branch name="tizen_tizeniot_tpk"/>
    </org>
  </branch_candidate>
  <abs_config>
    <abs>
      <branch source="tizen" output="tizen_mobile_tpk"/>
      <rootstrap url="ABS/TIZEN/Tizen/Tizen-Unified/latest/"/>
      <packages>
        <package repo="profile/mobile/apps/native/call-setting"/>
