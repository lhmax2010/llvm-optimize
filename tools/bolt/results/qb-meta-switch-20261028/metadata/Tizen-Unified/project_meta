        <package repo="profile/mobile/apps/native/camera-app"/>
        <package repo="profile/mobile/apps/native/gallery"/>
        <package repo="profile/mobile/apps/native/homescreen-efl"/>
        <package repo="profile/mobile/apps/native/lockscreen"/>
        <package repo="profile/mobile/apps/native/message"/>
        <package repo="profile/mobile/apps/native/music-player"/>
        <package repo="profile/mobile/apps/native/myfiles"/>
        <package repo="profile/mobile/apps/native/phone-contacts"/>
        <package repo="profile/mobile/apps/native/quickpanel"/>
        <package repo="profile/mobile/apps/native/settings"/>
        <package repo="profile/mobile/apps/native/share-panel"/>
        <package repo="profile/mobile/apps/native/taskmanager"/>
        <package repo="profile/mobile/apps/native/ug-gallery-efl"/>
