+  if(BOLT_BUILT_STANDALONE)
+    # The runtime uses its own architecture and ABI flags. Clear distribution
+    # flags that can conflict with them, such as -msse4.2 and
+    # -mgeneral-regs-only.
+    list(APPEND extra_args -DCMAKE_C_FLAGS= -DCMAKE_CXX_FLAGS=)
