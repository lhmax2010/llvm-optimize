diff --git a/bolt/lib/Target/X86/CMakeLists.txt b/bolt/lib/Target/X86/CMakeLists.txt
index baaabab1c1e8..0d2bb1f3c3f4 100644
--- a/bolt/lib/Target/X86/CMakeLists.txt
+++ b/bolt/lib/Target/X86/CMakeLists.txt
@@ -24,14 +24,17 @@ set(LLVMBOLT_TARGET_X86_SOURCES
 # The standalone mirror TU needs generated .inc files that only exist when
 # this bolt is configured standalone (see tablegen() calls above); upstream
 # LLVMX86Desc already provides these symbols in whole-LLVM builds.
-if(BOLT_BUILT_STANDALONE)
+if(BOLT_BUILT_STANDALONE AND LLVM_LINK_LLVM_DYLIB)
   list(APPEND LLVMBOLT_TARGET_X86_SOURCES X86BoltMnemonicTables.cpp)
+else()
+  list(APPEND LLVM_OPTIONAL_SOURCES X86BoltMnemonicTables.cpp)
 endif()
 
 add_llvm_library(LLVMBOLTTargetX86
   ${LLVMBOLT_TARGET_X86_SOURCES}
 
   NO_EXPORT
+  ${BOLT_LLVM_LINK_MODE}
 
   DEPENDS
   X86CommonTableGen
@@ -40,7 +43,7 @@ add_llvm_library(LLVMBOLTTargetX86
 # The installed LLVM may not provide llvm::X86::isNOP & friends (they are
 # compiled into LLVMX86Desc upstream); build them into this target instead.
 # Must run after add_llvm_library().
-if(BOLT_BUILT_STANDALONE)
+if(BOLT_BUILT_STANDALONE AND LLVM_LINK_LLVM_DYLIB)
   target_compile_definitions(LLVMBOLTTargetX86 PRIVATE BOLT_STANDALONE_X86_TABLES=1)
 endif()
 
