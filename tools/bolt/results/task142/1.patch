 19 files changed, 31 insertions(+), 4 deletions(-)

diff --git a/bolt/CMakeLists.txt b/bolt/CMakeLists.txt
index ce08094e25ba..e3b99f725bb2 100644
--- a/bolt/CMakeLists.txt
+++ b/bolt/CMakeLists.txt
@@ -154,6 +154,9 @@ if (BOLT_ENABLE_RUNTIME)
   endif()
 
   include(ExternalProject)
+  if(BOLT_BUILT_STANDALONE)
+    list(APPEND extra_args -DCMAKE_C_FLAGS= -DCMAKE_CXX_FLAGS=)
+  endif()
   ExternalProject_Add(bolt_rt
     SOURCE_DIR "${CMAKE_CURRENT_SOURCE_DIR}/runtime"
     STAMP_DIR ${CMAKE_CURRENT_BINARY_DIR}/bolt_rt-stamps
@@ -169,8 +172,6 @@ if (BOLT_ENABLE_RUNTIME)
                # (-mgeneral-regs-only etc.); distro optflags inherited from
                # the environment conflict with them (e.g. -msse4.2 with
                # -mgeneral-regs-only), so start from clean flag sets.
-               -DCMAKE_C_FLAGS=
-               -DCMAKE_CXX_FLAGS=
                ${extra_args}
     INSTALL_COMMAND ""
     BUILD_ALWAYS True
@@ -200,6 +201,12 @@ include_directories(
   ${CMAKE_CURRENT_BINARY_DIR}/include
   )
 
+if(BOLT_BUILT_STANDALONE AND LLVM_LINK_LLVM_DYLIB)
+  set(BOLT_LLVM_LINK_MODE)
+else()
+  set(BOLT_LLVM_LINK_MODE DISABLE_LLVM_LINK_LLVM_DYLIB)
+endif()
+
 add_subdirectory(lib)
 add_subdirectory(tools)
 
