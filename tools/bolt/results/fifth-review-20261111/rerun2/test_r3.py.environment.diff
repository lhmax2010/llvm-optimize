+   for fn in ('bolt_fail fixture -','bolt_checked fixture - /bin/false'):
+    for mode in ('status','signal'):
+     for code in ((0,1,2,129,130,143) if mode=='status' else (1,2,15)):
+      py=('import sys;sys.exit('+str(code)+')' if mode=='status' else
+          'import importlib.util,os,signal,sys;s=importlib.util.spec_from_file_location("h",sys.argv[1]);h=importlib.util.module_from_spec(s);s.loader.exec_module(h);h.main=lambda:os.kill(os.getpid(),'+str(code)+');sys.exit(h.cli())')
+      cmd=shlex.join([sys.executable,'-B','-c',py,str(S/'packaging/clang-bolt-helper.py')])
+      body=re.sub(r'python3 -B \S+ disk-diagnose (?:.*?)(?= \|\| bolt_status_exit)',lambda _:cmd,functions)
+      self.assertNotIn('disk-diagnose',body)
+      result=subprocess.run([shell,'-e','-c',body+'\n'+fn+'\necho AFTER_DIAG\n'],capture_output=True,text=True,timeout=10)
+      expected=128+code if mode=='signal' else code if code in (129,130,143) else 1
+      self.assertEqual(result.returncode,expected,(shell,fn,mode,code,result.stderr))
+      self.assertNotIn('AFTER_DIAG',result.stdout)
+      results.append(dict(shell=shell,function=fn,mode=mode,input=code,expected=expected,rc=result.returncode,stdout=result.stdout,stderr=result.stderr))
+  observed.append(dict(case='diagnostic-status-matrix',rows=results))
+ def entry_probe(self,tool,mode,sig,ignored=False,late=True):
+  source=S/'packaging'/('clang-bolt-helper.py' if tool=='helper' else 'llvm-static-archives-native.py')
+  program=r'''import importlib.util,os,signal,sys
+tool,mode,sig,ignored,late=sys.argv[2:];sig=int(sig);ignored=ignored=='True';late=late=='True'
+if ignored:signal.signal(signal.SIGHUP,signal.SIG_IGN)
+elif sig:signal.signal(sig,signal.SIG_DFL)
+sp=importlib.util.spec_from_file_location('m',sys.argv[1]);m=importlib.util.module_from_spec(sp);sp.loader.exec_module(m)
+original=signal.signal
+handlers={s:signal.getsignal(s) for s in (signal.SIGTERM,signal.SIGHUP,signal.SIGINT)}
+state={'armed':False,'sent':False}
+def intercept(s,h):
+ if h==handlers.get(s) and state['armed'] and not state['sent'] and late and sig:
+  state['sent']=True;os.kill(os.getpid(),sig);print('REAL_SIGNAL_BEFORE_RESTORE',sig,flush=True)
+ result=original(s,h)
+ if h!=handlers.get(s):state['armed']=True
+ return result
+signal.signal=intercept
+def work(*args,**kwargs):
+ if not late and sig:os.kill(os.getpid(),sig);print('AFTER_SIGNAL',flush=True)
+ if mode=='known':raise (m.GateError('known failure') if tool=='helper' else RuntimeError('known failure'))
+ if mode=='unexpected':raise KeyError('unexpected failure')
+if tool=='helper':
+ m.main=work;m.diagnose_safely=lambda *a,**k:None;rc=m.cli()
+else:
+ m.install=work
+ sys.argv=['converter','--root','/unused','--build','/unused','--evidence','/unused','--arch','x86_64','--debug-info','no','--compiler','/unused/clang','--disassembler','/unused/llvm-dis','--nm','/unused/llvm-nm']
+ rc=m.install_main()
+print('RETURNED',rc,flush=True);sys.exit(rc)
+'''
+  result=subprocess.run([sys.executable,'-B','-c',program,str(source),tool,mode,str(sig),str(ignored),str(late)],capture_output=True,text=True,timeout=15)
+  observed.append(dict(case='entry-window',tool=tool,mode=mode,signal=sig,ignored=ignored,late=late,rc=result.returncode,stdout=result.stdout,stderr=result.stderr))
+  return result
