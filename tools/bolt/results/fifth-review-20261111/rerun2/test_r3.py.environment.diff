+    for sig in (15,1,2):
+     with self.subTest(tool=tool,mode=mode,sig=sig):
+      r=self.entry_probe(tool,mode,sig)
+      self.assertEqual(r.returncode,128+sig,r.stderr);self.assertIn('REAL_SIGNAL_BEFORE_RESTORE',r.stdout)
+      if tool=='helper':self.assertIn('BOLT_CANCELLED: signal '+str(sig),r.stderr)
+      elif mode=='normal':self.assertIn('NATIVE_ARCHIVES_CANCELLED after completion',r.stdout)
+      if mode=='unexpected' or (tool=='converter' and mode=='known'):self.assertIn('Traceback',r.stderr)
+ def test_no_signal_entry_behaviour(self):
