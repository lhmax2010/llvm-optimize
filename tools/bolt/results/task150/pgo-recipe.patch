-        output = row.get('output', '')
-        flags = [a for a in tokens if re.match(r'-f(?:no-)?(?:cs-)?(?:profile|auto-profile)', a)]
-        is_compile = ('-c' in tokens and
-                      any(Path(name).suffix in ('.c','.cc','.cpp','.cxx','.C','.m','.mm')
-                          for name in (row.get('file', ''),)))
-        runtime = pgo_runtime_target(output)
-        if is_compile:
-            checked['compile'] += 1
-            checked['runtime_compile'] += int(runtime)
-        if not expected or runtime:
-            require(not flags, 'unexpected PGO option for '+output+': '+str(flags))
-        elif is_compile or flags:
-            require(flags == ['-fprofile-instr-use='+expected],
-                    'wrong PGO option for '+output+': '+str(flags))
-            checked['profile_use'] += int(is_compile)
-    require(checked['compile'] > 0, 'could not identify C/C++ compile edges')
+    report = scan_pgo_commands(commands, expected)
+    if report['violations']:
+        print('PGO_NINJA_REPORT', json.dumps(report), flush=True)
+        message = '; '.join(dict.fromkeys(item['reason'] for item in report['violations']))
+        raise GateError(f'PGO Ninja check found {report["violation_count"]} violation(s): {message}')
+    require(report['compile'] > 0, 'could not identify C/C++ compile edges')
     if expected:
-        require(checked['profile_use'] and checked['runtime_compile'],
+        require(report['profile_use'] and report['runtime_compile'],
                 'PGO check missed main or runtime targets')
-    return checked
+    return report
 
 
 def verify_pgo_ninja(build, enabled=False):
@@ -221,7 +258,7 @@ def verify_pgo_ninja(build, enabled=False):
         expected = str((build/'pgo-profiles/clang.profdata').resolve())
         require(profile['path'] == expected and digest(expected) == profile['sha256'],
                 'configured profdata identity mismatch')
-    run = subprocess.run(['ninja', '-t', 'compdb'], cwd=build, check=True, capture_output=True)
+    run = subprocess.run(['ninja', '-t', 'compdb', '-x'], cwd=build, check=True, capture_output=True)
     result = check_pgo_commands(json.loads(run.stdout), expected)
     print('PGO_NINJA_CHECK', json.dumps(result), flush=True)
     if enabled:
