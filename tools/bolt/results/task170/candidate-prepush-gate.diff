+def expand(d,name,arch,spec):
+    e, macros=rpm_settings(arch)
+    ver=command([*RPM,"--version"],env=e).stdout
+    require("4.14.1" in ver,"RPM parser is not the designated version")
+    (d/"rpm-version.txt").write_text(ver)
+    opts=[*macros,"--target",arch+"-tizen-linux","--define","_toolchain clang",
           "--define","_topdir "+str(d/"rpmdir"),"--define","_sourcedir "+str(spec.parent)]
     return logged(d,f"{name}-{arch}",[*RPM,"-P",*opts,spec],env=e).stdout
+
+
+def candidate_argv_gate(d,spec,helper,profile_name,bolt_name):
+    env, macros=rpm_settings("x86_64")
+    cfg={"argv":RPM,"env":{"RPM_CONFIGDIR":env["RPM_CONFIGDIR"]},"base_args":macros}
+    result=verify_helper_argv(spec,helper,cfg,d/"argv-fixed",profile_name,bolt_name,
+                              "llvm-profiles.manifest")
+    require(result["status"]=="PASS","helper argument matrix failed")
+    return result
+
+
+def require_argv_receipt(d,tip):
+    result=read(d/"argv-fixed/result.json")
+    cases={f"{project}-pgo{pgo}-bolt{bolt}" for project in ("T","D")
+           for pgo in (0,1) for bolt in (0,1)}
+    require(result["status"]=="PASS" and result["matrix"].keys()==cases and all(
+        not row["errors"] for row in result["matrix"].values()),"helper argument matrix is incomplete")
+    for path,field in ((SPEC,"spec_sha256"),(HELPER,"helper_sha256")):
+        actual=hashlib.sha256(show(tip,path).encode("utf-8")).hexdigest()
+        require(actual==result[field],"helper argument receipt does not match candidate blob: "+path)
 
