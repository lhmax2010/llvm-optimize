diff --git a/packaging/clang-bolt-helper.py b/packaging/clang-bolt-helper.py
index cb841b445c1b..2ad38975b10d 100644
--- a/packaging/clang-bolt-helper.py
+++ b/packaging/clang-bolt-helper.py
@@ -302,8 +302,8 @@ def call(argv, log, cwd=None, timeout=300):
         with log.open('wb') as output:
             check_cancel()
             # All child processes must be started through call(): it resets
-            # SIGCHLD and reaps children itself; an inherited SIG_IGN would
-            # otherwise turn failed exit codes into 0.
+            # SIGCHLD and reaps children itself; an inherited SIG_IGN can
+            # otherwise discard exit status and defeat reliable failure reporting.
             # Signal handlers must not raise while _SPAWNING is set; otherwise
             # the forked child would be unknown to call() and could be orphaned.
             # Publish the SID before honoring a deferred second signal.
