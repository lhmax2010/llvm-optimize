++<<<<<<< HEAD
 +cmake -DCMAKE_INSTALL_PREFIX=%{buildroot}/usr -P cmake_install.cmake
 +%ifarch x86_64
 +%if %{llvm_bolt_enabled}
 +
 +# Reject debug-named buildroots before any BOLT action.
 +# Keep the ordinary install and BOLT payload under the same platform debug-path policy.
 +case $(printf '%%s' '%{buildroot}' | LC_ALL=C tr '[:upper:]' '[:lower:]') in
 +  *debug*) echo 'BOLT buildroot absolute path contains debug' >&2; exit 1 ;;
 +esac
 +BOLT_BUILD="$PWD"
 +BOLT_WORK="$PWD/clang-bolt"
 +BOLT_INSTALL_ROOT="%{buildroot}"
 +BOLT_PROFILE_SOURCE="%{SOURCE1200}"
 +export BOLT_BUILD BOLT_WORK BOLT_INSTALL_ROOT BOLT_PROFILE_SOURCE
 +bolt_fail() {
 +  python3 -B %{SOURCE1201} disk-diagnose "$1" "$2" || bolt_status_exit $?
 +  exit 1
 +}
 +bolt_status_exit() {
 +  case "$1" in
 +    129|130|143) exit "$1" ;;
 +    *) exit 1 ;;
 +  esac
 +}
 +bolt_checked() {
 +  bolt_stage=$1
 +  bolt_log=$2
 +  shift 2
 +  if bolt_output=$("$@" 2>&1); then
 +    printf '%%s\n' "$bolt_output" || bolt_fail "$bolt_stage-output" -
 +  else
 +    bolt_status=$?
 +    printf '%%s\n' "$bolt_output" || true
 +    case "$bolt_status" in
 +      129|130|143) exit "$bolt_status" ;;
 +    esac
 +    printf '%%s\n' "$bolt_output" | python3 -B %{SOURCE1201} disk-diagnose "$bolt_stage" /dev/stdin || bolt_status_exit $?
 +    exit 1
 +  fi
 +}
 +bolt_optional() {
 +  if "$@"; then
 +    return 0
 +  else
 +    bolt_optional_rc=$?
 +    case $bolt_optional_rc in
 +      129|130|143) exit "$bolt_optional_rc" ;;
 +      *) return 0 ;;
 +    esac
 +  fi
 +}
 +bolt_step() {
 +  bolt_stage=$1
 +  shift
 +  bolt_checked "$bolt_stage" "$BOLT_WORK/$bolt_stage.log" python3 -B %{SOURCE1201} run-step "$bolt_stage" "$BOLT_WORK/$bolt_stage.log" -- "$@"
 +}
 +bolt_optional python3 -B %{SOURCE1201} disk-report begin
 +echo "BOLT_BUILDROOT_OK %{buildroot}"
 +python3 -B %{SOURCE1201} preflight || bolt_status_exit $?
 +python3 -B %{SOURCE1201} certified || bolt_status_exit $?
 +if [ -r /proc/self/stat ]; then echo BOLT_PROC_OK; else echo BOLT_PROC_MISSING; fi
 +# One relink: emit-relocs, then LLVM strip-debug, BOLT and full strip.
 +# The handed-off build owns its original ThinLTO cache; do not duplicate it.
 +mkdir -p "$BOLT_WORK" || exit 1
 +# File-list baseline is the actual ordinary CMake install, not a name whitelist.
 +python3 -B %{SOURCE1201} installed-baseline "%{buildroot}" "$BOLT_WORK/installed-baseline.json" || bolt_status_exit $?
 +python3 -B %{SOURCE1201} snapshot "%{buildroot}" "$BOLT_WORK/install-before.json" || bolt_status_exit $?
 +bolt_step manifest-copy cp install_manifest.txt "$BOLT_WORK/install-manifest-before.txt"
 +bolt_step ordinary-copy cp -p bin/clang-22 "$BOLT_WORK/ordinary-clang-22"
 +bolt_checked link-command "$BOLT_WORK/link-command.log" python3 -B %{SOURCE1201} run-step link-command "$BOLT_WORK/link-command.log" --output "$BOLT_WORK/link.original" -- ninja -t commands -s bin/clang-22
 +python3 -B %{SOURCE1201} unpack %{SOURCE1200} "$BOLT_WORK/profile.fdata" || bolt_status_exit $?
 +bolt_step configure cmake -S ../llvm -B . \
 +  '-DLLVM_ENABLE_PROJECTS=clang;lldb;clang-tools-extra;lld;compiler-rt;openmp;bolt' \
 +  -DBOLT_BUILD_TOOLS=OFF -DBOLT_ENABLE_RUNTIME=OFF \
 +  -DBOLT_INCLUDE_TESTS=OFF -DBOLT_TARGETS_TO_BUILD=X86
 +# Only certified BOLT tasks and the paired configure-refreshed TF anchor.
 +bolt_step dry-run-begin /bin/echo BOLT_TOOL_DRY_RUN_BEGIN
 +# LC_ALL=C applies only to this ninja invocation.
 +bolt_checked tool-dry-run "$BOLT_WORK/tool-dry-run.log" python3 -B %{SOURCE1201} run-step tool-dry-run "$BOLT_WORK/tool-dry-run.log" --output "$BOLT_WORK/tool-dry-run.txt" -- env LC_ALL=C NINJA_STATUS='[%%f/%%t] ' ninja -n llvm-bolt
 +bolt_step dry-run-end /bin/echo BOLT_TOOL_DRY_RUN_END
 +python3 -B %{SOURCE1201} tool-plan "$BOLT_WORK/tool-dry-run.txt" > "$BOLT_WORK/tool-plan.json" || bolt_status_exit $?
 +cat "$BOLT_WORK/tool-plan.json"
 +python3 -B %{SOURCE1201} tool-prepare "$PWD" "$BOLT_WORK/tool-plan.json" "$BOLT_WORK/tool-before.json" || bolt_status_exit $?
 +# LC_ALL=C applies only to this ninja invocation.
 +bolt_checked tool-build "$BOLT_WORK/tool-build.txt" python3 -B %{SOURCE1201} run-step tool-build "$BOLT_WORK/tool-build.txt" --success-marker BOLT_NINJA_EXIT_0 -- env LC_ALL=C NINJA_STATUS='[%%f/%%t] ' ninja -j %{mlgo_build_jobs} llvm-bolt
 +python3 -B %{SOURCE1201} tool-verify "$PWD" "$BOLT_WORK/tool-plan.json" "$BOLT_WORK/tool-build.txt" \
 +  "$BOLT_WORK/tool-before.json" "$BOLT_WORK/tool-build-verification.json" || bolt_status_exit $?
 +cat "$BOLT_WORK/tool-build-verification.json"
 +bolt_optional python3 -B %{SOURCE1201} disk-report tool-built
 +%if %{llvm_release_build}
 +python3 -B %{SOURCE1201} pipeline "$PWD" "$BOLT_WORK" "$PWD/bin/llvm-bolt" || bolt_status_exit $?
 +%else
 +python3 -B %{SOURCE1201} pipeline "$PWD" "$BOLT_WORK" "$PWD/bin/llvm-bolt" --debug-symbols || bolt_status_exit $?
 +%endif
 +echo BOLT_PIPELINE_PASS
 +bolt_optional python3 -B %{SOURCE1201} disk-report pipeline
 +# BOLT configuration/build/rewrite must not change the ordinary installation.
 +# Do not reinstall: that would add BOLT libraries, unregistered aliases and exports.
 +python3 -B %{SOURCE1201} compare-root "%{buildroot}" "$BOLT_WORK/install-before.json" \
 +  "$BOLT_WORK/install-after-pipeline.json" || bolt_status_exit $?
 +echo BOLT_COMPARE_ROOT_PASS
 +# No subsequent step consumes this ThinLTO cache.
 +# Release it only inside the enabled x86_64 BOLT block.
 +bolt_optional python3 -B %{SOURCE1201} cache-release "$PWD" "$BOLT_WORK"
 +# Any subsequent buildroot mutation (including native archive conversion) must follow this gate.
 +%endif
 +%endif
