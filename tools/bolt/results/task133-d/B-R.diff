+def unpack_pgo_asset(source, dest, info):
+    for key in ('sha256', 'xz_sha256'):
+        require(re.fullmatch(r'[0-9a-f]{64}', info[key]), 'invalid profile digest '+key)
+    for key in ('bytes', 'xz_bytes'):
+        require(type(info[key]) is int and info[key] > 0, 'invalid profile size '+key)
+    source, dest = Path(source), Path(dest)
+    require(source.name == info['file'] and source.stat().st_size == info['xz_bytes']
+            and digest(source) == info['xz_sha256'], 'compressed profile identity mismatch: '+str(source))
+    # Limit writes to the declared size and publish only a verified stream.
+    dest.parent.mkdir(parents=True, exist_ok=True)
+    with tempfile.NamedTemporaryFile(dir=dest.parent, delete=False) as packed:
+        tmp = Path(packed.name)
+        try:
+            size = 0
+            with lzma.open(source, 'rb') as src:
+                first = True
+                for block in iter(lambda: src.read(1024*1024), b''):
+                    check_cancel()
+                    require(not (first and block.startswith(b'PLACEHOLDER')), 'placeholder profile payload')
+                    first = False
+                    size += len(block)
+                    require(size <= info['bytes'], 'profile exceeds declared size')
+                    packed.write(block)
+            packed.flush()
+            require(size == info['bytes'] and digest(tmp) == info['sha256'],
+                    'uncompressed profile identity mismatch: '+str(source))
+            os.replace(tmp, dest)
+        finally:
+            tmp.unlink(missing_ok=True)
+    return {'path': str(dest.resolve()), 'sha256': info['sha256'], 'bytes': size}
+
+
+def prepare_pgo(manifest, project, work, profile, bolt_profile=None):
+    row = select_pgo_profile(manifest, project, True, bolt_profile is not None)
+    work = Path(work).absolute()
+    require(not (work/'state.json').exists(), 'PGO state already exists, use a fresh build')
+    result = {'project': project, 'manifest_sha256': digest(manifest),
+              'profdata': unpack_pgo_asset(profile, work/'clang.profdata', row['profdata'])}
+    if bolt_profile is not None:
+        result['bolt'] = unpack_pgo_asset(bolt_profile, work/'clang.fdata', row['bolt_profile'])
+    save(work/'state.json', result)
+    return result
+
