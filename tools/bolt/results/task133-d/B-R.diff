+def pgo_runtime_target(output):
+    # Targets observed in the historical Ninja progress stream, plus their
+    # separate-build directory names and the runtime libraries' link outputs.
+    parts = Path(output).parts
+    return (bool({'compiler-rt', 'openmp', 'runtimes', 'offload'} & set(parts))
+            or Path(output).name.startswith(('libclang_rt.', 'libomp.', 'libompd.',
+                                             'libarcher.', 'libomptarget.')))
+
+
+def check_pgo_commands(commands, expected=None):
+    checked = {'compile': 0, 'profile_use': 0, 'runtime_compile': 0}
+    for row in commands:
+        tokens = shlex.split(row['command'])
+        output = row.get('output', '')
+        flags = [a for a in tokens if re.match(r'-f(?:no-)?(?:cs-)?(?:profile|auto-profile)', a)]
+        is_compile = ('-c' in tokens and
+                      any(Path(name).suffix in ('.c','.cc','.cpp','.cxx','.C','.m','.mm')
+                          for name in (row.get('file', ''),)))
+        runtime = pgo_runtime_target(output)
+        if is_compile:
+            checked['compile'] += 1
+            checked['runtime_compile'] += int(runtime)
+        if not expected or runtime:
+            require(not flags, 'unexpected PGO option for '+output+': '+str(flags))
+        elif is_compile or flags:
+            require(flags == ['-fprofile-instr-use='+expected],
+                    'wrong PGO option for '+output+': '+str(flags))
+            checked['profile_use'] += int(is_compile)
+    require(checked['compile'] > 0, 'could not identify C/C++ compile edges')
+    if expected:
+        require(checked['profile_use'] and checked['runtime_compile'],
+                'PGO check missed main or runtime targets')
+    return checked
+
+
+def verify_pgo_ninja(build, enabled=False):
+    build = Path(build)
+    require((build/'build.ninja').is_file(), 'missing primary Ninja graph')
+    expected = None
+    if enabled:
+        state = json.loads((build/'pgo-profiles/state.json').read_text())
+        profile = state['profdata']
+        expected = str((build/'pgo-profiles/clang.profdata').resolve())
+        require(profile['path'] == expected and digest(expected) == profile['sha256'],
+                'configured profdata identity mismatch')
+    run = subprocess.run(['ninja', '-t', 'compdb'], cwd=build, check=True, capture_output=True)
+    result = check_pgo_commands(json.loads(run.stdout), expected)
+    print('PGO_NINJA_CHECK', json.dumps(result), flush=True)
+    if enabled:
+        print('PGO_MATCH UNKNOWN method-not-qualified', flush=True)
+    return result
+
+
+def pgo_runtime_dependencies(root, enabled=False):
+    """Inspect installed ELF and every member of the static-devel archives."""
+    root = Path(root)
+    marker = re.compile(r'(?<![A-Za-z0-9_])(?:_?_llvm_prf_[A-Za-z0-9_]+|__llvm_profile_[A-Za-z0-9_]+)')
+    needed = re.compile(r'\(NEEDED\).*?\[libclang_rt\.profile[^]]*\]')
+    result = {'status': 'PASS', 'archives': 0, 'elf': 0, 'findings': []}
+    paths = set((root/'usr/lib64').glob('lib*.a')) | set((root/'usr/lib').glob('lib*.a'))
+    try:
+        for path in sorted(set(root.rglob('*')) | paths):
+            check_cancel()
+            if path.is_symlink() or not path.is_file():
+                continue
+            with path.open('rb') as source:
+                head = source.read(20)
+            archive = path in paths
+            if archive:
+                require(head.startswith(b'!<arch>\n'), 'invalid static-devel archive: '+str(path))
+            else:
+                if len(head) < 20 or head[:4] != b'\x7fELF':
+                    continue
+                if int.from_bytes(head[16:18], 'little' if head[5]==1 else 'big') not in (2,3):
+                    continue
+                relative = path.relative_to(root).parts
+                if path.suffix == '.debug' or 'debug' in relative[:-1]:
+                    continue
+            result['archives' if archive else 'elf'] += 1
+            with subprocess.Popen(['readelf','-W','-h','-S','-s','-d',str(path)],
+                                  stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
+                                  encoding='utf-8', errors='replace',
+                                  env={**os.environ, 'LC_ALL': 'C'}) as reader:
+                members = headers = 0
+                member = None
+                for line in reader.stdout:
+                    if line.startswith('File:'):
+                        member = line.split(':', 1)[1].strip()
+                        members += 1
+                    if line.lstrip().startswith('ELF Header:'):
+                        headers += 1
+                    if marker.search(line) or needed.search(line):
+                        result['status'] = 'FAIL'
+                        if len(result['findings']) < 30:
+                            result['findings'].append({'path':str(path),'member':member,'line':line.strip()})
+                    if re.search(r'readelf: (?:Error|Warning):', line):
+                        result['status'] = 'FAIL'
+                        if len(result['findings']) < 30:
+                            result['findings'].append({'path':str(path),'line':line.strip()})
+                require(reader.wait() == 0 and (headers == members if archive else headers == 1),
+                        'could not inspect complete ELF payload: '+str(path))
+    except (OSError, GateError, ValueError) as error:
+        if isinstance(error, GateError) and error.cancel_originated:
+            raise
+        result['status'] = 'FAIL'
+        result['error'] = str(error)
+    print('PGO_RUNTIME_CHECK', json.dumps(result), flush=True)
+    require(not enabled or result['status']=='PASS', 'PGO runtime dependency gate failed')
+    return result
+
+
+def paired_bolt_profile():
+    state_path = os.environ.get('TIZEN_PGO_STATE')
+    if state_path is None:
+        return None
+    state = json.loads(Path(state_path).read_text())
+    profile = state['bolt']
+    require(digest(profile['path']) == profile['sha256'], 'paired BOLT profile identity mismatch')
+    return profile
+
 
