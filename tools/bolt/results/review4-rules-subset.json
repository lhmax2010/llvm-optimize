    "command": "$PRE_LINK && /bin/clang++ $FLAGS $LINK_FLAGS $in -o $TARGET_FILE $LINK_PATH $LINK_LIBRARIES && $POST_BUILD",
    "description": "Linking CXX executable $TARGET_FILE",
    "restat": "$RESTAT"
  }
}
