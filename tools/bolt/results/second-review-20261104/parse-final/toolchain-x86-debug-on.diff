+tizen_llvm_flags()
+{
+    tizen_llvm_kind=$1
+    tizen_llvm_input=$2
+    tizen_llvm_release=$3
+    case $tizen_llvm_release in 0|1) ;; *)
+        echo "TIZEN_LLVM_FIXED_FLAGS_FAILED invalid TIZEN_LLVM_RELEASE=$tizen_llvm_release" >&2
+        return 1 ;;
+    esac
