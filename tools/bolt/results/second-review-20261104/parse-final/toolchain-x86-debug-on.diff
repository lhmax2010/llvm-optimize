+    tizen_llvm_unreviewed=
+    tizen_llvm_arch=
+    tizen_llvm_debug_head=
+    tizen_llvm_debug_tail=
+    TIZEN_LLVM_NORMALIZED=
+    TIZEN_LLVM_DROPPED=
