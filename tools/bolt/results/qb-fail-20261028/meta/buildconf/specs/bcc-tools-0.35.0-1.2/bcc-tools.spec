%{_libdir}/libbcc.so
%{_libdir}/pkgconfig/libbcc.pc

%files static
%{_libdir}/libbcc.a
%{_libdir}/libbcc-loader-static.a
%{_libdir}/libbcc_bpf.a

%if %{with examples}
%files examples
%{_datadir}/bcc/*
%endif
