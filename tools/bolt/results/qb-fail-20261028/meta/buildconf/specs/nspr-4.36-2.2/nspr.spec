Name:           nspr
VCS:            platform/upstream/nspr#2bb09649768cd73920426547c6e2fbec233e76be
Version:        4.36
Release:        2.2
License:        MPL-2.0 and BSD-3-Clause
Summary:        Netscape Portable Runtime
Url:            http://www.mozilla.org/projects/nspr/
Group:          Base/Libraries
Source:         https://ftp.mozilla.org/pub/nspr/releases/v%{version}/src/nspr-%{version}.tar.bz2
Source1:        baselibs.conf
Source2:        nspr.changes
Source1001: 	nspr.manifest
# Patches auto-generated by git-buildpackage:
Patch0:         bf6daa6-to-5765144.diff.gz
BuildRequires:  gcc-c++
BuildRequires:  pkg-config
BuildRoot:      %{_tmppath}/%{name}-%{version}-build

%description
NSPR provides platform independence for non-GUI operating system
facilities. These facilities include threads, thread synchronization,
normal file and network I/O, interval timing and calendar time, basic
memory management (malloc and free), and shared library linking.

%package devel
Summary:        Netscape Portable Runtime development files
Group:          Base/Development
Requires:       nspr = %{version}

%description devel
NSPR provides platform independence for non-GUI operating system
facilities. These facilities include threads, thread synchronization,
normal file and network I/O, interval timing and calendar time, basic
memory management (malloc and free), and shared library linking.

%prep
%setup -n nspr-%{version} -q
# bf6daa6-to-5765144.diff.gz
%patch0 -p1
cp %{SOURCE1001} .

%build
# set buildtime to "last-modification-time"
#modified="$(sed -n '/^----/n;s/ - .*$//;p;q' "%{_sourcedir}/%{name}.changes")"
BUILD_STRING="$(date -u ${modified:+-d "$modified"} "+%%F %%T")"
BUILD_TIME="$(date -u ${modified:+-d "$modified"} "+%%s000000")"
#cd nspr
export CFLAGS="%{optflags}"
export LDFLAGS="$LDFLAGS -Wl,-z,relro,-z,now"
%configure --enable-optimize="$CFLAGS" \
%ifarch x86_64
	    --enable-64bit \
%endif
	    --includedir=%{_includedir}/nspr4 \
            --disable-debug

# Add --as-needed to DSO_LDOPTS so it appears before OS_LIBS (-lpthread -lrt -ldl)
# in the shared library link command, dropping unused NEEDED entries

# Check if DSO_LDOPTS line exists before patching
if ! grep -q '^DSO_LDOPTS' config/autoconf.mk; then
	echo "ERROR: Cannot find DSO_LDOPTS in config/autoconf.mk" >&2
	echo "ERROR: --as-needed patch cannot be applied" >&2
	exit 1
fi

# Append -Wl,--as-needed to the end of DSO_LDOPTS line
sed -i '/^DSO_LDOPTS/s/$/ -Wl,--as-needed/' config/autoconf.mk

# Verify that --as-needed was actually added
if ! grep -q '\-Wl,\-\-as-needed' config/autoconf.mk; then
	echo "ERROR: sed failed to add -Wl,--as-needed to config/autoconf.mk" >&2
	exit 1
fi
grep '^DSO_LDOPTS' config/autoconf.mk >&2

make SH_DATE="$BUILD_STRING" SH_NOW="$BUILD_TIME" %{?_smp_mflags}

%check
# Run test suite
perl ./pr/tests/runtests.pl 2>&1 | tee output.log
TEST_FAILURES=`grep -c FAILED ./output.log` || :
if [ $TEST_FAILURES -ne 0 ]; then
  echo "error: test suite returned failure(s)"
  exit 1
fi
echo "test suite completed"


%install
mkdir -p %{buildroot}%{_bindir}
mkdir -p %{buildroot}%{_libdir}/nspr
mkdir -p %{buildroot}%{_libdir}/pkgconfig
mkdir -p %{buildroot}%{_includedir}/nspr4
cp config/nspr-config %{buildroot}%{_bindir}/
cp config/nspr.pc %{buildroot}%{_libdir}/pkgconfig
cp -L dist/lib/*.so %{buildroot}%{_libdir}
cp -L dist/lib/*.a  %{buildroot}%{_libdir}/nspr/
cp -rL dist/include/nspr/* %{buildroot}%{_includedir}/nspr4/
chmod -x %{buildroot}%{_includedir}/nspr4/prvrsion.h

%post -p /sbin/ldconfig

%postun -p /sbin/ldconfig

%files
%manifest %{name}.manifest
%defattr(-, root, root)
%license LICENSE LICENSE.BSD-3-Clause
%{_libdir}/*.so

%files devel
%manifest %{name}.manifest
%defattr(-, root, root)
%{_bindir}/nspr-config
%{_libdir}/pkgconfig/nspr.pc
%{_includedir}/nspr4/
%exclude %{_includedir}/nspr4/md/*
%{_libdir}/nspr/

%changelog
