Name:           gzip
VCS:            product/upstream/gzip#8329a9ff170c06443a957c2481437dd1fd843d22
Version:        1.3.12
Release:        1.11
License:        GPL-2.0-or-later
Summary:        The GNU data compression program
Url:            http://www.gnu.org/software/gzip/
Group:          Base/Compression
Source0:        %{name}-%{version}.tar.xz
Source1001: 	gzip.manifest
# Patches auto-generated by git-buildpackage:
Patch0:         0001-Fix-build-error.patch
Requires:       /usr/bin/mktemp

%description
The gzip package contains the popular GNU gzip data compression
program. Gzipped files have a .gz extension.

Gzip should be installed on your system, because it is a
very commonly used data compression program.


%prep
%setup -q
# 0001-Fix-build-error.patch
%patch0 -p1
cp %{SOURCE1001} .

%build
CFLAGS="$CFLAGS -fPIE"
LDFLAGS="$LDFLAGS -pie"

%configure \
    --bindir=%{_bindir} \
    %{?asan:gzip_cv_underline=no}

make %{?_smp_mflags}

%install
%make_install

%docs_package

%files
%manifest %{name}.manifest
%defattr(-,root,root,-)
%license COPYING
