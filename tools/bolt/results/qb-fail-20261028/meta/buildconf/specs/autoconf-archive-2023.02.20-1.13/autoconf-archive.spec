Name:           autoconf-archive
VCS:            platform/upstream/autoconf-archive#19744df176039484ef85b14a4b51931c6a40f2ff
Version:        2023.02.20
Release:        1.13
Summary:        Collection of reusable Autoconf macros
License:        GPL-3.0-or-later AND Autoconf-exception-3.0
URL:            https://www.gnu.org/software/autoconf-archive/
Source0:        %{name}-%{version}.tar.xz
Source1:        %{name}.manifest
Source2:        remove_subdirs_directory.patch
# Patches auto-generated by git-buildpackage:
