Name:           xz
VCS:            platform/upstream/xz#473a5d3073f8cb2401a889a5bb158fb6d0b425ae
Version:        5.8.1
Release:        1.12
License:        GPL-2.0+
Summary:        A Program for Compressing Files
Url:            http://tukaani.org/lzma/
Group:          Base/Compression
Source:         http://tukaani.org/xz/%{name}-%{version}.tar.bz2
Source1:        xz.manifest
Source2:        add_pie_compile_option.patch
Source3:        add_as_needed_link_option.patch
# Patches auto-generated by git-buildpackage:
Patch0:         0001-Bump-to-5.8.1.patch.gz
BuildRequires:  pkgconfig
BuildRequires:  gettext-devel

%{?_toolchain:
%if %{toolchain_is clang}
BuildRequires:  compiler-rt
%endif
}

Provides:       lzma = %{version}
Obsoletes:      lzma < %{version}

%ifarch %{arm}
%define do_profiling 0
%endif

# avoid bootstrapping problem
%define _binary_payload w9.bzdio

%description
The xz command is a very powerful program for compressing files.

* Average compression ratio of LZMA is about 30% better than that of
   gzip, and 15% better than that of bzip2.

* Decompression speed is only little slower than that of gzip, being
   two to five times faster than bzip2.

* In fast mode, compresses faster than bzip2 with a comparable
   compression ratio.

* Achieving the best compression ratios takes four to even twelve
   times longer than with bzip2. However. this doesn't affect
   decompressing speed.

* Very similar command line interface to what gzip and bzip2 have.

%package -n liblzma
Summary:    LZMA library
License:	0BSD

%description -n liblzma
Library for encoding/decoding LZMA files.

%package -n liblzma-static
Summary:    LZMA staitc library
License:	0BSD

%description -n liblzma-static
Static Library for encoding/decoding LZMA files.

%package devel
Summary:    Development package for the LZMA library
Group:      Base/Libraries
Requires:   liblzma = %{version}
Provides:   lzma-devel = %{version}
Obsoletes:  lzma-devel < %{version}
Provides:   lzma-alpha-devel = %{version}
Obsoletes:  lzma-alpha-devel < %{version}

%description devel
This package contains the header files and libraries needed for
compiling programs using the LZMA library.


%prep
%setup -q
# 0001-Bump-to-5.8.1.patch.gz
%patch0 -p1
cp %{SOURCE1} .
%{__patch} -p1 < %{SOURCE2}
%{__patch} -p1 < %{SOURCE3}

%build
%if "%{asan}" == "1"
export PTHREAD_LIBS=" -lpthread "
%endif
export CFLAGS="$CFLAGS -fPIC"

%if %{do_profiling}
profiledir=$(mktemp -d)
trap "rm -rf $profiledir" EXIT
export CFLAGS="%{optflags} %{cflags_profile_generate}=$profiledir -fprofile-correction -fPIC" 

%configure --disable-static --with-pic --docdir=%{_docdir}/%{name}  SKIP_WERROR_CHECK=yes
%__make

CFLAGS="%{optflags}"
%if %{defined _toolchain}
   %if %{toolchain_is clang}
      %__make LLVM_PROFILE_FILE=$profiledir/default.profraw check
      llvm-profdata merge -output=$profiledir/default.profdata $profiledir/default.profraw
      CFLAGS="$CFLAGS %{cflags_profile_feedback}=$profiledir/default.profdata"
   %else
      %__make check
      CFLAGS="$CFLAGS %{cflags_profile_feedback}=$profiledir"
   %endif
%else
   %__make check
   CFLAGS="$CFLAGS %{cflags_profile_feedback}=$profiledir"
%endif

CFLAGS="$CFLAGS -Wno-coverage-mismatch -fprofile-correction -fPIC"
%endif # do_profiling end

%configure --disable-shared --with-pic --docdir=%{_docdir}/%{name} SKIP_WERROR_CHECK=yes
%__make
cp src/liblzma/.libs/liblzma.a .

%configure --disable-static --with-pic --docdir=%{_docdir}/%{name} SKIP_WERROR_CHECK=yes
%__make

%install
%make_install
install -p -m 644 liblzma.a %{buildroot}%{_libdir}/

# License shouldn't be packaged as documentation
rm -f %{buildroot}%{_docdir}/%{name}/COPYING*

%find_lang %{name}
%remove_docs

%post -n liblzma -p /sbin/ldconfig

%postun -n liblzma -p /sbin/ldconfig

%lang_package

%files
%manifest %{name}.manifest
%license COPYING COPYING.GPLv2
%{_bindir}/*

%files -n liblzma
%manifest %{name}.manifest
%license COPYING COPYING.0BSD
%{_libdir}/lib*.so.5*

%files -n liblzma-static
%manifest %{name}.manifest
%license COPYING COPYING.0BSD
%{_libdir}/lib*.a


%files devel
%manifest %{name}.manifest
%license COPYING COPYING.GPLv2
%{_includedir}/*.h
%{_includedir}/lzma
%{_libdir}/lib*.so
%{_libdir}/pkgconfig/*.pc
