Name:           ninja
VCS:            platform/upstream/ninja#73fe09e873bcc72ca72c1d30bfade668c468682c
Version:        1.13.1
Release:        1.14
License:        Apache-2.0
Summary:        Ninja build system
Url:            http://martine.github.com/ninja/
Group:          System/Utilities
Source:         %{name}.tar.bz2
Source1001:     ninja.manifest
# Patches auto-generated by git-buildpackage:
Patch0:     0001-Bump-to-1.13.1.patch

BuildRequires:  python3-base

%description
Ninja is a small build system with a focus on speed.
http://martine.github.com/ninja/

See the manual -- http://martine.github.com/ninja/manual.html or
doc/manual.asciidoc included in the distribution -- for background
and more details.

%prep
%setup -q
# 0001-Bump-to-1.13.1.patch
%patch0 -p1
cp %{SOURCE1001} .

%build
# Support large file more than 2GB. (e.g., for stat syscall).
export CFLAGS="$CFLAGS -fPIC -pie -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE=1"

python3 ./configure.py --bootstrap

%install
mkdir -p %{buildroot}%{_bindir}
install -m 0755 ninja %{buildroot}%{_bindir}/ninja

%files
%manifest %{name}.manifest
%license COPYING
%{_bindir}/ninja

