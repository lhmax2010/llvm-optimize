%global major_version 1.0
%global _vpath_builddir builddir

Name:           mm-common
VCS:            platform/upstream/mm-common#3a9130b40eca7557f75e5dd728e96bdd0a29bbf2
Version:        1.0.7
Release:        1.1
Summary:        Common build files of the C++ bindings

BuildArch:      noarch
License:        GPL-2.0+
URL:            http://gtkmm.org
Source0:        http://download.gnome.org/sources/%{name}/%{major_version}/%{name}-%{version}.tar.xz
Source1:        libstdc++.tag
Source1001:     %{name}.manifest
# Patches auto-generated by git-buildpackage:
Patch0:     0001-Bump-to-1.0.7.patch

BuildRequires:  meson
BuildRequires:  ninja

Requires:       pkgconfig
# Requires:       doxygen
# Requires:       libxslt

%description
The mm-common module provides the build infrastructure and utilities
shared among the GNOME C++ binding libraries.  It is a required dependency
to build glibmm and gtkmm from git.

%prep
%setup -q
# 0001-Bump-to-1.0.7.patch
%patch0 -p1
cp %{SOURCE1001} .
mkdir -p builddir
cp %{SOURCE1} ./builddir

%build
# %{__meson} --prefix /usr --libdir %{_libdir} builddir
%{meson}
%{meson_build}


%install
# DESTDIR=%{buildroot} ninja -C builddir install
%meson_install

%remove_docs

%files
%manifest %{name}.manifest
%license COPYING
%{_bindir}/mm-common-get
%{_bindir}/mm-common-prepare
%{_datadir}/aclocal/*
%dir %{_datadir}/%{name}
%{_datadir}/%{name}/*
%{_datadir}/pkgconfig/mm-common-libstdc++.pc
%{_datadir}/pkgconfig/mm-common-util.pc
