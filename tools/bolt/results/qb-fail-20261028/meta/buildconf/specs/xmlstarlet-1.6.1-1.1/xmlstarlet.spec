%build
CFLAGS="$CFLAGS -fPIC"
%{?_toolchain:
%if %{toolchain_is clang}
CFLAGS="$CFLAGS -Wno-error=incompatible-function-pointer-types"
%endif
}
%if %{undefined ATTRIBUTE_UNUSED}
export CFLAGS="$CFLAGS -DATTRIBUTE_UNUSED="
%endif
LDFLAGS="$LDFLAGS -pie"

%configure --with-libxml-include-prefix=%{_includedir}/libxml2/
make

%install
%make_install
ln -s xml %{buildroot}%{_bindir}/%{name}

%files
