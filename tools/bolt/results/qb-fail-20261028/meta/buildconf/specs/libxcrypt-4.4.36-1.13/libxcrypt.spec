%{_mandir}/man3/crypt_gensalt_rn.3*
%{_mandir}/man3/crypt_preferred_method.3*

%files devel-static
%{_libdir}/libcrypt.a
%{_libdir}/libxcrypt.a
%{_libdir}/libowcrypt.a
