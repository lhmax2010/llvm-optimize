Name:           iniparser
VCS:            platform/upstream/iniparser#1bc885b5a62a82e4edaff5f50d7ab6226785d2d6
Version:        4.2.6
Release:        1.1
License:        MIT
Summary:        Stand-alone ini file parsing library
URL:            https://gitlab.com/iniparser/iniparser/
Source0:        %{name}-%{version}.tar.gz
Source1001:     %{name}.manifest
# Patches auto-generated by git-buildpackage:
Patch0:     0001-Bump-to-4.2.6.patch

BuildRequires:  cmake

%description
iniparser is a free stand-alone ini file parsing library.
It is written in portable ANSI C and should compile anywhere.
iniparser is distributed under an MIT license.

%package devel
Summary:        Development files for %{name}
Requires:       %{name} = %{version}-%{release}

%description devel
This package contains the header files and development documentation
for %{name}. If you like to develop programs using %{name}, you will need
to install %{name}-devel.

%prep
%setup -q -n %{name}-%{version}
# 0001-Bump-to-4.2.6.patch
%patch0 -p1
cp %{SOURCE1001} .

%build
%cmake . \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_SHARED_LIBS=ON \
    -DBUILD_STATIC_LIBS=OFF \
    -DBUILD_EXAMPLES=OFF \
    -DBUILD_DOCS=OFF \
    -DCMAKE_INSTALL_LIBDIR=%{_libdir} \
    -DCMAKE_INSTALL_PREFIX=%{_prefix} 

%__make %{?_smp_mflags}

%install
%make_install
install -m 644 src/*.h %{buildroot}/%{_includedir}

# Remove static libraries and .la files
find %{buildroot} -name "*.a" -delete
find %{buildroot} -name "*.la" -delete

%post -p /sbin/ldconfig

%postun -p /sbin/ldconfig

%files
%manifest %{name}.manifest
%license LICENSE
%{_libdir}/lib%{name}.so.*

%files devel
%manifest %{name}.manifest
%{_includedir}/%{name}/
%{_libdir}/lib%{name}.so
%{_libdir}/pkgconfig/%{name}.pc
%{_libdir}/cmake/%{name}/
%{_includedir}/*.h
