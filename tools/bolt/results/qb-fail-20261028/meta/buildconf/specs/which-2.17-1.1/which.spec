Name:           which
VCS:            product/upstream/which#2c292ce41d3965b84ed07c9fc2a1614f328b73cf
Version:        2.17
Release:        1.1
License:        GPL-2.0
Summary:        Displays where a particular program in your path is located
Url:            http://savannah.gnu.org/projects/which
Group:          Applications/System
Source0:        http://ftp.gnu.org/gnu/which/%{name}-%{version}.tar.gz
Source1001: 	which.manifest
# Patches auto-generated by git-buildpackage:
Patch0:         0001-Fix-build-for-Clang.patch
BuildRequires:  readline-devel

%description
The which command shows the full pathname of a specified program, if
the specified program is in your PATH.

%prep
%setup -q
# 0001-Fix-build-for-Clang.patch
%patch0 -p1
cp %{SOURCE1001} .

%build
export CFLAGS="$CFLAGS -Wno-error=implicit-function-declaration -std=c99"
%configure

make %{?_smp_mflags}

%install
%make_install

%docs_package

%files
%manifest %{name}.manifest
%defattr(-,root,root)
%license COPYING
%{_bindir}/*
