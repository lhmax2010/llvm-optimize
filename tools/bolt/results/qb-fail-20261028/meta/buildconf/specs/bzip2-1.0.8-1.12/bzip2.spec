Name:           bzip2
VCS:            platform/upstream/bzip2#15a32da9960f85cbe49426281b5338020f176d2d
Version:        1.0.8
Release:        1.12
Provides:       bzip
Obsoletes:      bzip
BuildRequires:  libtool
BuildRequires:  pkg-config
Url:            http://www.bzip.org/
Summary:        A Program for Compressing Files
License:        bzip2
Group:          Base/Tools
Source:         bzip2-%{version}.tar.gz
Source1:        bznew.gz
Source2:        bznew.1.gz
Source3:        baselibs.conf
Source4:        bzip2.pc
Source5:        fix_link_makefile.patch
Source100:      rpmlintrc
Source1001: 	bzip2.manifest
# Patches auto-generated by git-buildpackage:
Patch0:     0001-Fixed-missed-compilation-flags-and-tests-library-pat.patch
Patch1:     0002-Add-PIE-security-build-option.patch

%description
The bzip2 program is a very powerful program for compressing files.


%package -n libbz2
Summary:        The bzip2 runtime library
Group:          System/Libraries
Provides:       bzip2-libs

%description -n libbz2
The bzip2 runtime library

%package devel
Summary:        The bzip2 runtime library development files
Group:          Development/Libraries
Requires:       libbz2 = %{version} glibc-devel

%description devel
The bzip2 runtime library development files.

%prep
%setup -q
# 0001-Fixed-missed-compilation-flags-and-tests-library-pat.patch
%patch0 -p1
# 0002-Add-PIE-security-build-option.patch
%patch1 -p1
cp %{SOURCE4} .
cp %{SOURCE1001} .
%{__patch} -p1 < %{SOURCE5}


%build

CFLAGS="$CFLAGS -fPIC"
LDFLAGS="$LDFLAGS -pie"
make -f Makefile-libbz2_so %{?_smp_mflags} \
    CC="%{__cc}" AR="%{__ar}" RANLIB="%{__ranlib}"
make %{?_smp_mflags} CC="%{__cc}" AR="%{__ar}" RANLIB="%{__ranlib}"


%install
make install PREFIX=%{buildroot}%{_prefix} LIBDIR=%{_lib}
make -f Makefile-libbz2_so install \
    CC="%{__cc}" AR="%{__ar}" RANLIB="%{__ranlib}" \
    PREFIX=%{buildroot}%{_prefix} LIBDIR=%{_lib}

rm -f %{buildroot}%{_libdir}/libbz2.a

install -D -m 644 bzip2.pc %{buildroot}%{_libdir}/pkgconfig/bzip2.pc

gzip -dc %{SOURCE1} > bznew
install -D -m 755 bznew $RPM_BUILD_ROOT%{_bindir}/bznew


%remove_docs


%post -n libbz2 -p /sbin/ldconfig

%postun -n libbz2  -p /sbin/ldconfig


%files
%manifest %{name}.manifest
%defattr(-,root,root)
%{_bindir}/*

%files -n libbz2
%manifest %{name}.manifest
%defattr(-,root,root)
%license LICENSE
%{_libdir}/libbz2.so.1
%{_libdir}/libbz2.so.1.*

%files devel
%manifest %{name}.manifest
%{_includedir}/bzlib.h
%{_libdir}/libbz2.so
%{_libdir}/pkgconfig/bzip2.pc

