%define keepstatic 1
Name:           bison
VCS:            platform/upstream/bison#3118cb95e838800f49a61d4b48a4ae1bf08abc16
BuildRequires:  gcc-c++ gettext-tools flex
Version:        3.0.5
Release:        1.14
Summary:        The GNU Parser Generator
License:        GPL-3.0+
Group:          Platform Development/Utilities
Url:            http://www.gnu.org/software/bison/bison.html
Source:         bison-%{version}.tar.xz
Source1001:     bison.manifest
# Patches auto-generated by git-buildpackage:
Patch0:         0001-CVE-2018-17942-vasnprintf-Fix-heap-memory-overrun-bu.patch
Patch1:         0002-Fix-build-for-Clang.patch
Requires:       m4

%description
Bison is a parser generator similar to yacc(1).

%prep
%setup -q
# 0001-CVE-2018-17942-vasnprintf-Fix-heap-memory-overrun-bu.patch
%patch0 -p1
# 0002-Fix-build-for-Clang.patch
%patch1 -p1
cp %{SOURCE1001} .

%build
%configure --disable-nls
%__make %{?_smp_mflags}

%check
%__make %{?_smp_mflags} check

%install
%make_install
rm -rf %{buildroot}/%{_datadir}/doc

%files
%manifest %{name}.manifest
%license COPYING
%{_bindir}/bison
%{_bindir}/yacc
%{_libdir}/liby.a
%{_datadir}/bison
%{_datadir}/aclocal/bison-i18n.m4
%doc %{_infodir}/bison.info*.gz
%doc %{_mandir}/man1/bison.1.gz
%doc %{_mandir}/man1/yacc.1.gz
