Name:           lttng-ust
VCS:            platform/upstream/lttng-ust#cb9de5ce358bb80f19d1f28305b16c6f0149b5a7
Version:        2.14.0
Release:        1.1
License:        LGPL-2.1-only and GPL-2.0-only and MIT
Group:          Development/Libraries
Summary:        LTTng Userspace Tracer library
URL:            https://lttng.org
Source0:        https://lttng.org/files/lttng-ust/%{name}-%{version}.tar.gz
Source1001:     %{name}.manifest
# Patches auto-generated by git-buildpackage:
Patch0:     0001-Bump-to-2.14.0.patch

BuildRequires:  pkgconfig(liburcu)
BuildRequires:  libuuid-devel
BuildRequires:  texinfo
BuildRequires:  python3

%description
This library may be used by user-space applications to generate 
trace-points using LTTng.

%package -n %{name}-devel
Summary:        LTTng Userspace Tracer library headers and development files
Group:          Development/Libraries
Requires:       %{name} = %{version}
Requires:       userspace-rcu-devel

%description -n %{name}-devel
This library provides support for developing programs using 
LTTng user-space tracing

%prep
%setup -q
# 0001-Bump-to-2.14.0.patch
%patch0 -p1
cp %{SOURCE1001} .

%build
%ifarch s390 s390x
# workaround rhbz#837572 (ICE in gcc)
%global optflags %(echo %{optflags} | sed 's/-O2/-O1/')
%endif

%{?asan:%restore_fcommon}

# Reinitialize libtool with the fedora version to remove Rpath
autoreconf -vif

%configure --docdir=%{_docdir}/%{name} \
           --disable-static \
           --disable-numa \
           --disable-man-pages

make %{?_smp_mflags} V=1

%install
make DESTDIR=%{buildroot} install
rm -vf %{buildroot}%{_libdir}/*.la
rm -vf %{buildroot}%{_docdir}/%{name}/LICENSE

# Remove documentation and manual pages as recommended for Tizen
%remove_docs

%post -p /sbin/ldconfig
%postun -p /sbin/ldconfig

%files
%manifest %{name}.manifest
%license LICENSE
%{_libdir}/*.so.*



%files -n %{name}-devel
%license LICENSE
%{_bindir}/lttng-gen-tp
%{_prefix}/include/*
%{_libdir}/*.so
%{_libdir}/pkgconfig/lttng-ust*.pc

