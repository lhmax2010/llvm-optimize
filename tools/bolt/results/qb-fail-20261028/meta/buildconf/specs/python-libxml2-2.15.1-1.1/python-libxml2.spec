Name:           python-libxml2
VCS:            platform/upstream/python-libxml2#46ced3ce740a6d52dd977d81c8566fde27442d54
Version:        2.15.1
Release:        1.1
Summary:        python2 Bindings for libxml2
License:        MIT
Group:          Development/Python
Source:         %{name}-%{version}.tar.gz
Source1001:     %{name}.manifest
# Patches auto-generated by git-buildpackage:
Patch0:     0001-fix-build-error-in-python2-generator.patch.gz

BuildRequires:  python
BuildRequires:  python-devel
BuildRequires:  libxml2-devel
BuildRequires:  python-xml
BuildRequires:  doxygen

Requires:       libxml2
Obsoletes:      libxml2-python < %{version}
Provides:       libxml2-python = %{version}

%description
The libxml2-python package contains a module that permits applications
written in the Python programming language to use the interface
supplied by the libxml2 library to manipulate XML files.

This library allows manipulation of XML files. It includes support for
reading, modifying, and writing XML and HTML files. There is DTD
support that includes parsing and validation even with complex DTDs,
either at parse time or later once the document has been modified.

%prep
%setup -q -n %{name}-%{version}
# 0001-fix-build-error-in-python2-generator.patch.gz
%patch0 -p1
cp %{SOURCE1001} .

%build
export CFLAGS="%{optflags} -fno-strict-aliasing"
export PYTHON=/usr/bin/python2

%autogen
%configure \
    --with-history \
    --with-sax1 \
    --with-regexps \
    --with-threads \
    --with-reader \
    --with-http \
    --with-python

# Build full project first to generate doc/html.stamp needed for Python bindings
make %{?_smp_mflags}

%install
make -C python install \
    DESTDIR=%{buildroot} \
    pythondir=%{python_sitelib} \
    PYTHON_SITE_PACKAGES=%{python_sitelib}

# Unwanted doc stuff
rm -fr %{buildroot}%{_datadir}/doc
rm -f %{buildroot}%{_libdir}/python%{python3_version}/site-packages/*.{la,a}

%files
%manifest %{name}.manifest
%license Copyright
%{python_sitelib}/*
%{python_sitearch}/*
