Name:           python3-lxml
VCS:            platform/upstream/python3-lxml#6797e28f60d8933c669633350a45a6e170272f48
Version:        6.0.2
Release:        1.3
Summary:        Powerful and Pythonic XML processing library
License:        BSD-3-Clause and ElementTree
Group:          Development/Languages/Python
Url:            http://lxml.de/
Source:         %{name}-%{version}.tar.gz
Source1: 	    %{name}.manifest
# Patches auto-generated by git-buildpackage:
Patch0:     0001-Bump-to-6.0.2.patch
Patch1:     0002-Convert-shell-scripts-from-bash-to-dash-compatibilit.patch

BuildRequires:  pkgconfig(python3)
BuildRequires:  python3
BuildRequires:  python3-build
BuildRequires:  python3-flit_core
BuildRequires:  python3-pip

BuildRequires:  python3-cython
BuildRequires:  python3-setuptools
BuildRequires:  pkgconfig(libxml-2.0)
BuildRequires:  pkgconfig(libxslt)

%description
lxml is a Pythonic, mature binding for the libxml2 and libxslt libraries. It
provides safe and convenient access to these libraries using the ElementTree
API. It extends the ElementTree API significantly to offer support for XPath,
RelaxNG, XML Schema, XSLT, C14N and much more.


%prep
%setup -q -n %{name}-%{version}
# 0001-Bump-to-6.0.2.patch
%patch0 -p1
# 0002-Convert-shell-scripts-from-bash-to-dash-compatibilit.patch
%patch1 -p1
cp %{SOURCE1} .

%build
export CFLAGS="$CFLAGS -Wno-error=incompatible-pointer-types"
%{_bindir}/python3 -m build -n

%install
%{_bindir}/python3 -m pip install --root %{buildroot} ./dist/lxml-%{version}*.whl

%files
%manifest %{name}.manifest
%license doc/licenses/BSD.txt
%license doc/licenses/elementtree.txt
%{python3_sitearch}/lxml/*
%{python3_sitearch}/lxml-%{version}.dist-info/*

%changelog
