%define __spec_check_pre exit 0

Name:           make
VCS:            platform/upstream/make#f648b7e3cfcc77669112076cfe5c8f9b76ade526
Url:            http://www.gnu.org/software/make/make.html
Provides:       gmake
Version:        4.4.1
Release:        1.12
Summary:        GNU make
License:        GPL-3.0+
Group:          Platform Development/Build
Source:         make-%{version}.tar.bz2
Source1001:     make.manifest
# Patches auto-generated by git-buildpackage:
Patch0:         0001-Remove-default-C-compiler-setting-option.patch
BuildRequires:  makeinfo

%description
The GNU make command with extensive documentation.

%prep
%setup -q
# 0001-Remove-default-C-compiler-setting-option.patch
%patch0 -p1
cp %{SOURCE1001} .

%build
export AUTOPOINT=true %{?asan:LIBS+=" -ldl "}
CFLAGS="%{optflags} -fPIC -pie" \
%reconfigure --disable-nls
%__make %{?_smp_mflags}

%check
%__make check

%install
%make_install
ln -sf make %{buildroot}%{_bindir}/gmake

%files
%manifest %{name}.manifest
%defattr(-,root,root)
%license COPYING
%{_bindir}/make
%{_bindir}/gmake
%{_includedir}/gnumake.h
%doc %{_infodir}/make.info-*.gz
%doc %{_infodir}/make.info.gz
%doc %{_mandir}/man1/make.1.gz

%post
%install_info --info-dir=%{_infodir} %{_infodir}/%{name}.info.gz

%postun
%install_info_delete --info-dir=%{_infodir} %{_infodir}/%{name}.info.gz
