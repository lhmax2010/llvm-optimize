Name:           python-appdirs
VCS:            platform/upstream/python-appdirs#e5faa8447619e9b5fb86e015893216af4c4a9ef9
Version:        1.4.0
Release:        1.1
Summary:        A small Python module for determining platform-specific dirs
License:        MIT
Group:          Development/Languages/Python
Url:            http://github.com/ActiveState/appdirs
Source:         https://pypi.python.org/packages/source/a/appdirs/appdirs-%{version}.tar.gz
Source1001:     %{name}.manifest
# Patches auto-generated by git-buildpackage:
Patch0:     0001-Resolve-cyclic-build-dependency.patch

BuildRequires:  python-devel

BuildArch:      noarch

%description
``appdirs`` will
help you choose an appropriate:

- user data dir (``user_data_dir``)
- user cache dir (``user_cache_dir``)
- site data dir (``site_data_dir``)
- user log dir (``user_log_dir``)


%prep
%setup -q -n appdirs-%{version}
# 0001-Resolve-cyclic-build-dependency.patch
%patch0 -p1

%build
cp %{SOURCE1001} .
%{__python} setup.py build

%install
%{__python} setup.py install --prefix=%{_prefix} --root=%{buildroot}
chmod a+x %{buildroot}%{python_sitelib}/appdirs.py

%pre
# previous versions of the package installed .egg-info as a directory,
# the new update now installs it as a file. Clean out the directory, should it exist.
if [ -d %{python_sitelib}/appdirs-%{version}-py%{py_ver}.egg-info ]; then
  rm -rf %{python_sitelib}/appdirssix-%{version}-py%{py_ver}.egg-info
fi

%files
%defattr(-,root,root,-)
%manifest %{name}.manifest
%license LICENSE.txt
%{python_sitelib}/appdirs.py*
%{python_sitelib}/appdirs-%{version}-py*.egg-info

%changelog

