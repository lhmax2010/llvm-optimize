Name:           zip
VCS:            platform/upstream/zip#b8540a0a16a19648c5b1156062e99599450d9eda
Version:        3.0
Release:        1.1
License:        Info-ZIP
Summary:        File compression program
Url:            http://www.info-zip.org/
Group:          Productivity/Archiving/Compression
Source:         %{name}-%{version}.tar.bz2
Source10:       0001-Fix-format-security-warnings.patch
Source11:       0002-Build-fix-With-GCC-14-due-to-missing-headers.patch
Source1001: 	zip.manifest
# Patches auto-generated by git-buildpackage:
Patch0:     0001-import-zip-3.0-iso8859_2.patch.patch
Patch1:     0002-import-zip-3.0-add_options_to_help.patch.patch
Patch2:     0003-import-zip-3.0-nonexec-stack.patch.patch
Patch3:     0004-import-zip-3.0-optflags.patch.patch
Patch4:     0005-import-zip-3.0-tempfile.patch.patch
Patch5:     0006-import-zip-notimestamp.patch.patch

%description
Zip is a compression and file packaging utility. It is compatible with
PKZIP(tm) 2.04g (Phil Katz ZIP) for MS-DOS systems.

%prep
%setup -q -n zip30
# 0001-import-zip-3.0-iso8859_2.patch.patch
%patch0 -p1
# 0002-import-zip-3.0-add_options_to_help.patch.patch
%patch1 -p1
# 0003-import-zip-3.0-nonexec-stack.patch.patch
%patch2 -p1
# 0004-import-zip-3.0-optflags.patch.patch
%patch3 -p1
# 0005-import-zip-3.0-tempfile.patch.patch
%patch4 -p1
# 0006-import-zip-notimestamp.patch.patch
%patch5 -p1
cp %{SOURCE1001} .
%{__patch} -p1 < %{SOURCE10}
%{__patch} -p1 < %{SOURCE11}

%build
CFLAGS="$CFLAGS -DLARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64 -fPIC -pie"
make %{?_smp_mflags} -f unix/Makefile generic \
    CC="%{__cc} ${CFLAGS}" CPP="%{__cc} -E" prefix=/usr

%install
mkdir -p %{buildroot}/usr/bin
mkdir -p %{buildroot}%{_mandir}/man1
make install -f unix/Makefile BINDIR=%{buildroot}/usr/bin MANDIR=%{buildroot}%{_mandir}/man1

%{remove_docs}

%files
%manifest %{name}.manifest
%defattr(-,root,root)
%license LICENSE
%{_bindir}/zip
%{_bindir}/zipcloak
%{_bindir}/zipnote
%{_bindir}/zipsplit

%changelog
