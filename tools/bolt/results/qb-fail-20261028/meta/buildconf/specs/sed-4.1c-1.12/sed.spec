Name:           sed
VCS:            product/upstream/sed#1acd46557f61b5f72e74cf7a5d17003045346eb2
Version:        4.1c
Release:        1.12
Summary:        A Stream-Oriented Non-Interactive Text Editor
License:        GPL-2.0-or-later
Group:          Base/Utilities
Url:            http://www.gnu.org/directory/sed.html
Source:         %{name}-%{version}.tar.bz2
Source1001:     sed.manifest
# Patches auto-generated by git-buildpackage:
Patch0:         0001-CVE-2009-5155-Diagnose-ERE-1.patch
Patch1:         0002-riscv64-update-config.sub.patch
Provides:       base:/bin/sed
BuildRequires:  automake
%{?_toolchain:
%if %{toolchain_is clang}
BuildRequires:  compiler-rt
%endif
}
Provides:       /bin/sed

%description
Sed takes text input, performs one or more operations on it, and
outputs the modified text. Sed is typically used for extracting parts
of a file using pattern matching or  for substituting multiple
occurrences of a string within a file.

%prep
%setup -q
# 0001-CVE-2009-5155-Diagnose-ERE-1.patch
%patch0 -p1
# 0002-riscv64-update-config.sub.patch
%patch1 -p1
cp %{SOURCE1001} .

%build
%define warn_flags -Wall -Wstrict-prototypes -Wpointer-arith -Wformat-security
export CFLAGS="%{optflags} %warn_flags -fPIC"
export LDFLAGS=" -pie"
%configure --prefix=/usr \
            --mandir=%{_mandir} \
            --infodir=%{_infodir} \
            --disable-nls \
            --without-included-regex \
            %{_target_cpu}-tizen-linux
%if %do_profiling
    CFLAGS="$CFLAGS -Wno-error=coverage-mismatch"
    %__make %{?_smp_mflags} CFLAGS="$CFLAGS "%cflags_profile_generate
    %if %{defined _toolchain}
        %if %{toolchain_is clang}
            # In case of the conflict issue of paralleling running
            export LLVM_PROFILE_FILE="$PWD/sed-%p.profraw"
            %__make %{?_smp_mflags} check
            llvm-profdata merge -output=$PWD/sed.profdata $PWD/*.profraw
            %define profile_feedback_flags %cflags_profile_feedback=$PWD/sed.profdata
        %else
            %__make %{?_smp_mflags} check
            %define profile_feedback_flags %cflags_profile_feedback
        %endif
    %else
        %__make %{?_smp_mflags} check
        %define profile_feedback_flags %cflags_profile_feedback
    %endif

    # Clean the not used data
    %__make clean
    %__make %{?_smp_mflags} CFLAGS="$CFLAGS %{profile_feedback_flags}"
%else
    %__make %{?_smp_mflags}
%endif
%__make %{?_smp_mflags} check

%install
%make_install


%docs_package

%files 
%manifest %{name}.manifest
%defattr(-, root, root)
%{_bindir}/sed
