Name:           boost-jam
VCS:            platform/upstream/boost-jam#15af0267ef2346ff6c1b802c672e68dec02db476
Version:        201104
Release:        1.1
Summary:        An Enhanced Make Replacement
License:        BSD-3-Clause
Group:          Development/Tools/Building
Source:         %{name}-%{version}.tar.xz
# From http://boost.cvs.sourceforge.net/boost/boost/tools/jam/test/:
Source2:        test.tar.gz 
Source1001: 	boost-jam.manifest
# Patches auto-generated by git-buildpackage:
Patch0:         0001-cflags-for-build.patch
Patch1:         0002-codec-cleanup.patch
Patch2:         0003-jam0-use-passed-cflags.patch
Url:            http://www.boost.org/
BuildRequires:  xz

%description
Boost Jam is a build tool based on FTJam, which in turn is based on
Perforce Jam. It contains significant improvements made to facilitate
its use in the Boost Build System, but should be backward compatible
with Perforce Jam.

%prep
%setup -q
# 0001-cflags-for-build.patch
%patch0 -p1
# 0002-codec-cleanup.patch
%patch1 -p1
# 0003-jam0-use-passed-cflags.patch
%patch2 -p1
cp %{SOURCE1001} .
find . -type f | xargs chmod -R u+w

%build
CC="%{__cc}"
CFLAGS="$CFLAGS -Wall -fno-strict-aliasing -Wp,-D_FILE_OFFSET_BITS=64"

LOCATE_TARGET=bin ./build.sh ${CC##*-} --symbols
# Trivial test: -- Documented used of bjam -v: Print the version of jam and exit:
bin/bjam -v
ln  -s bin bin.linux
cd ..
tar xvf %{SOURCE2}
ln -s %{name}-%{version} src
cd test
sh test.sh || if [ $? -gt 5 ]; then sh test.sh;fi

%install
mkdir -p %{buildroot}%{_bindir}
mkdir -p %{buildroot}%{_docdir}/%{name}-%{version}
install -m 755 bin/bjam %{buildroot}%{_bindir}/bjam-%{version}
ln -sf bjam-%{version} %{buildroot}%{_bindir}/bjam
ln -sf bjam-%{version} %{buildroot}%{_bindir}/jam

%files
%manifest %{name}.manifest
%defattr(-,root,root)
%attr(755,root,root) %{_bindir}/*

%changelog
