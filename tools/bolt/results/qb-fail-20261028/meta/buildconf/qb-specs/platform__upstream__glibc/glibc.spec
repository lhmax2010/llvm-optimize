}

%{?asan:
%ifarch %asan_arch
%package asan
Summary:     glibc with ASan instrumentation
License:     LGPL-2.1+ and LGPL-2.1+-with-GCC-exception and GPL-2.0+
Requires:    glibc = %{version}
Requires:    rpm

