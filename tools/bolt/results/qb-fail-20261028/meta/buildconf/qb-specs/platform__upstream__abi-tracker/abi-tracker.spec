Name:           abi-tracker
Version:        1.11
Release:        1
Summary:        Visualize ABI changes timeline of a C/C++ software library
License:        GPL-2.0-or-later OR LGPL-2.1-or-later
URL:            https://github.com/lvc/abi-tracker
Source0:        %{name}-%{version}.tar.gz
Source1:        %{name}.manifest
Source1000:     abi-tracker-debuginfo-search.patch
Source1001:     abi-tracker-compress-order.patch
BuildRequires:  perl
BuildRequires:  make
BuildRequires:  coreutils
Requires:       perl
Requires:       elfutils
Requires:       abi-dumper >= 1.1
Requires:       vtable-dumper >= 1.1
Requires:       abi-compliance-checker >= 2.2
Requires:       rfcdiff >= 1.41

%description
ABI Tracker visualizes ABI changes timeline of a C/C++ software library.
The tool requires an input profile of the library in JSON format, which can
be created manually or automatically generated by the ABI Monitor tool.

%prep
%setup -q
%{__patch} -p1 < %{SOURCE1000}
%{__patch} -p1 < %{SOURCE1001}
cp %{SOURCE1} .

%build
# Pure Perl tool: nothing to compile

%install
mkdir -p %{buildroot}%{_prefix}
make install DESTDIR=%{buildroot} prefix=%{_prefix}

%files
%manifest %{name}.manifest
%defattr(-,root,root)
%license LICENSE GPL-2.0 LGPL-2.1
%doc README HOWTO
%{_bindir}/%{name}
%{_datadir}/%{name}/
