@@ -279,8 +279,11 @@ cmake \
     -DLLVM_BUILD_LLVM_DYLIB=ON \
     -DCLANG_BUILD_CLANG_DYLIB=ON \
 %ifarch x86_64
-    -DLLVM_LINK_LLVM_DYLIB=OFF \
-    -DCLANG_LINK_CLANG_DYLIB=OFF \
+    -DLLVM_LINK_LLVM_DYLIB=ON \
+    -DCLANG_LINK_CLANG_DYLIB=ON \
+    -DTIZEN_HYBRID_LINK=ON \
+    -DBUILD_SHARED_LIBS=OFF \
+    -DLLVM_TOOL_LLVM_DRIVER_BUILD=OFF \
 %else
 %if %{defined _toolchain}
     -DLLVM_LINK_LLVM_DYLIB=ON \
@@ -391,6 +394,34 @@ cmake \
 
 # Full build using ninja (already in build/ directory after cd build)
 ninja -j %{mlgo_build_jobs}
+%ifarch x86_64
+# These drivers must retain component linkage even when BOLT is disabled.
+for hybrid_tool in bin/clang-22 bin/lld bin/llvm-ar bin/llvm-tblgen bin/clang-tblgen bin/lldb-tblgen bin/llvm-config bin/llvm-exegesis; do
+    if ! test -f "$hybrid_tool"; then
+        case "$hybrid_tool" in
+            bin/clang-22|bin/lld|bin/llvm-ar)
+                echo "TIZEN_HYBRID_LINK_FAILED missing $hybrid_tool" >&2; exit 1 ;;
+            *) echo "TIZEN_HYBRID_LINK_SKIP $hybrid_tool"; continue ;;
+        esac
+    fi
+    hybrid_dynamic=$(LC_ALL=C readelf -dW "$hybrid_tool") || {
+        echo "TIZEN_HYBRID_LINK_FAILED readelf: $hybrid_tool" >&2; exit 1;
+    }
+    if LC_ALL=C grep -E '\(NEEDED\).*\[(libLLVM[^]]*\.so|libclang-cpp[^]]*\.so)' <<EOF_HYBRID_DYNAMIC
+$hybrid_dynamic
+EOF_HYBRID_DYNAMIC
+    then
+        echo "TIZEN_HYBRID_LINK_FAILED shared LLVM/Clang dependency: $hybrid_tool" >&2
+        exit 1
+    else
+        hybrid_grep_status=$?
+        test "$hybrid_grep_status" = 1 || {
+            echo "TIZEN_HYBRID_LINK_FAILED grep status=$hybrid_grep_status: $hybrid_tool" >&2; exit 1;
+        }
+    fi
+done
+echo TIZEN_HYBRID_LINK_OK
+%endif
 
 %install
 cd build
